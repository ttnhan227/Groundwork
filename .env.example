ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://insightpdf:insightpdf@postgres:5432/insightpdf
JWT_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
