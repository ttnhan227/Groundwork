# ==============================================================================
# Groundwork — Environment Configuration
# ==============================================================================

# --- Local Core Settings ---
ENVIRONMENT=development
GROUNDWORK_DATA_DIR=~/.groundwork
AI_PROVIDER=local
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
OPENAI_API_KEY=
GEMINI_API_KEY=
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174,http://localhost:3000,http://localhost:1420,http://127.0.0.1:1420,tauri://localhost,http://tauri.localhost

# --- Cloud Sync Settings (Optional, for Cloud Run / Multi-device Sync) ---
CLOUD_SYNC_ENABLED=false
CLOUD_SYNC_URL=http://localhost:8080
CLOUD_SYNC_TOKEN=
# Both local core and cloud API load the project-root .env.
DATABASE_URL=postgresql+psycopg2://groundwork:groundwork_dev@localhost:5433/groundwork
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
ACCESS_TOKEN_MINUTES=15

# Docker Compose includes PostgreSQL by default and works without a .env file.
# Optional Docker backend overrides; leave empty to use the bundled database.
BACKEND_DATABASE_URL=
BACKEND_JWT_SECRET=
BACKEND_CORS_ORIGINS=
DATABASE_PORT=5433
GOOGLE_CLIENT_ID=
