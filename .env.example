# ==============================================================================
# Groundwork — Environment Configuration
# ==============================================================================

# --- Local Core Settings ---
ENVIRONMENT=development
GROUNDWORK_DATA_DIR=~/.groundwork
AI_PROVIDER=local
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
OPENAI_API_KEY=
GEMINI_API_KEY=
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:1420,tauri://localhost,http://tauri.localhost

# --- Cloud Sync Settings (Optional, for Cloud Run / Multi-device Sync) ---
CLOUD_SYNC_ENABLED=false
CLOUD_SYNC_URL=http://localhost:8080
CLOUD_SYNC_TOKEN=
DATABASE_URL=postgresql+psycopg2://groundwork:groundwork@localhost:5433/groundwork
JWT_SECRET=dev-cloud-jwt-secret-groundwork-2026
