# Groundwork local configuration
# Copy to .env in the project root only when you need custom settings.
# Docker works without this file. Keep .env private; it is ignored by Git.

# Backend run outside Docker. Use your Supabase URL here if preferred.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg2://groundwork:groundwork_dev@localhost:5433/groundwork
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
ACCESS_TOKEN_MINUTES=15
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174,http://localhost:3000,http://localhost:1420,http://127.0.0.1:1420,tauri://localhost,http://tauri.localhost

# Optional Google sign-in. Leave blank to use email/password or continue locally.
GOOGLE_CLIENT_ID=

# Optional Docker overrides. Empty values use Docker's PostgreSQL and dev defaults.
# To use Supabase in Docker, put its connection string in BACKEND_DATABASE_URL.
BACKEND_DATABASE_URL=
BACKEND_JWT_SECRET=
BACKEND_CORS_ORIGINS=
DATABASE_PORT=5433

# Backend address used by the desktop during normal local development.
CLOUD_SYNC_URL=http://localhost:8080

# Public backend address included when building an installer locally.
# Use your hosted HTTPS address for an installer with hosted accounts.
# GitHub Actions reads its Repository Variable instead of this file.
DESKTOP_API_BASE_URL=http://localhost:8080

# AI providers/keys and account sessions are normally managed inside the app.
# Local SQLite storage and the backend's groundwork schema use their code defaults.
