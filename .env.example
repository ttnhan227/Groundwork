ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://insightpdf:insightpdf@postgres:5432/insightpdf
JWT_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=insightpdf
MINIO_SECRET_KEY=insightpdf-secret
MINIO_SECURE=false
MINIO_REGION=us-east-1
MINIO_BUCKET_ORIGINALS=original-documents
REDIS_URL=redis://redis:6379/0
MAX_FILE_SIZE_MB=50
MAX_PAGE_COUNT=500
OCR_TEXT_DENSITY_THRESHOLD=40
OCR_LANGUAGE=eng
EMBEDDING_PROVIDER=api
EMBEDDING_MODEL=mistral-embed
EMBEDDING_DIMENSIONS=1024
CHUNK_SIZE=900
CHUNK_OVERLAP=150
RAG_TOP_K=6
LLM_API_KEY=
LLM_BASE_URL=https://api.mistral.ai/v1
LLM_MODEL=mistral-small-latest
VISION_MODEL=mistral-small-latest
VISION_MAX_PAGES=6
LLM_TIMEOUT_SECONDS=60
AI_DAILY_REQUEST_LIMIT=50
AI_GLOBAL_DAILY_REQUEST_LIMIT=500
REQUEST_RATE_LIMIT_PER_MINUTE=120
REGISTRATION_RATE_LIMIT_PER_HOUR=5
AI_RATE_LIMIT_PER_MINUTE=10
MAX_DOCUMENTS_PER_USER=100
DAILY_UPLOAD_LIMIT_PER_USER=10
GLOBAL_DAILY_UPLOAD_LIMIT=100
REGISTRATION_ENABLED=true
# Google Identity Services Web client ID. Use the same value for both entries.
GOOGLE_CLIENT_ID=
ADMIN_EMAIL=
ADMIN_PASSWORD=
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
# Client build setting controlling whether new users can register.
VITE_REGISTRATION_ENABLED=true
VITE_GOOGLE_CLIENT_ID=
