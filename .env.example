# ==============================================================================
# Groundwork — Environment Configuration
# ==============================================================================

# --- Core & Security ---
ENVIRONMENT=development
JWT_SECRET=replace-with-at-least-32-random-characters-for-production
DATABASE_URL=postgresql+asyncpg://groundwork:groundwork@postgres:5432/groundwork
REDIS_URL=redis://redis:6379/0

# --- AI Provider Credentials (Gemini / OpenAI Compatible) ---
LLM_API_KEY=
LLM_MODEL=gemini-flash-latest
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
EMBEDDING_MODEL=gemini-embedding-001

# --- Object Storage (MinIO / S3) ---
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=groundwork
MINIO_SECRET_KEY=groundwork-secret
MINIO_BUCKET_ORIGINALS=original-documents

# --- Google OAuth (Required for Google Sign-In; leave blank if using Email/Password only) ---
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# --- Network & CORS ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080
