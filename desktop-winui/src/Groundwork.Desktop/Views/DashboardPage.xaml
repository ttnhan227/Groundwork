<Page
    x:Class="Groundwork.Desktop.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Groundwork.Desktop"
    xmlns:controls="using:Groundwork.Desktop.Controls">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,16">
        <StackPanel Spacing="16" MaxWidth="1280" HorizontalAlignment="Stretch">

            <!-- 1. HERO STATUS & HEALTH BANNER -->
            <Border
                Padding="20,18"
                CornerRadius="10"
                Background="{ThemeResource GwCardBackgroundBrush}"
                BorderBrush="{ThemeResource GwCardBorderBrush}"
                BorderThickness="1">
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Health Dial -->
                    <controls:HealthGauge x:Name="OverallHealthGauge" Value="96" StatusLabel="Healthy" VerticalAlignment="Center" />

                    <!-- Status Title, Subtitle, and Vitals -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <TextBlock Text="System Status: Optimal" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" />
                            <Border Padding="6,2" CornerRadius="4" Background="{ThemeResource GwSignalGreenBgBrush}">
                                <TextBlock Text="Protected &amp; Nominal" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource GwSignalGreenBrush}" />
                            </Border>
                        </StackPanel>

                        <TextBlock
                            x:Name="HeroSubtitleText"
                            Text="All primary subsystems operating within normal thermal and resource boundaries."
                            FontSize="12"
                            Foreground="{ThemeResource GwTextSecondaryBrush}"
                            TextWrapping="Wrap" />

                        <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,4,0,0">
                            <TextBlock x:Name="DeviceModelText" Text="Windows 11 PC" FontSize="11" Foreground="{ThemeResource GwTextMutedBrush}" />
                            <TextBlock Text="•" FontSize="11" Foreground="{ThemeResource GwTextMutedBrush}" />
                            <TextBlock x:Name="UptimeText" Text="Uptime: Ready" FontSize="11" Foreground="{ThemeResource GwTextMutedBrush}" />
                            <TextBlock Text="•" FontSize="11" Foreground="{ThemeResource GwTextMutedBrush}" />
                            <TextBlock x:Name="LiveCpuMemText" Text="CPU: --% • RAM: --%" FontSize="11" Foreground="{ThemeResource GwTextMutedBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Quick Smart Health Action -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="8">
                        <Button
                            x:Name="QuickSmartCheckBtn"
                            Content="Smart Health Check"
                            Style="{StaticResource GwPrimaryButtonStyle}"
                            Click="OnSmartHealthCheckClick" />
                        <Button
                            Content="Audit History"
                            Style="{StaticResource GwCompactButtonStyle}"
                            HorizontalAlignment="Stretch"
                            Click="OnOpenHistoryClick" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. THREE CORE PILLARS (Storage, Performance, Diagnostics) -->
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Pillar 1: Storage Space -->
                <Border
                    Grid.Column="0"
                    Padding="16,14"
                    CornerRadius="8"
                    Background="{ThemeResource GwCardBackgroundBrush}"
                    BorderBrush="{ThemeResource GwCardBorderBrush}"
                    BorderThickness="1">
                    <StackPanel Spacing="10">
                        <Grid>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xEDA2;" FontSize="16" Foreground="{ThemeResource GwAccentBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="Storage Space" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock x:Name="StorageFreePercentText" Text="-- Free" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource GwAccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>

                        <ProgressBar x:Name="StorageProgressBar" Value="75" Maximum="100" Height="6" CornerRadius="3" Foreground="{ThemeResource GwAccentBrush}" />

                        <TextBlock x:Name="StorageCapacitySummaryText" Text="Calculating disk volumes..." FontSize="11" Foreground="{ThemeResource GwTextSecondaryBrush}" />

                        <Button
                            Content="Clean Storage Space →"
                            Style="{StaticResource GwCompactButtonStyle}"
                            HorizontalAlignment="Stretch"
                            Click="OnNavigateStorageClick" />
                    </StackPanel>
                </Border>

                <!-- Pillar 2: Performance & Boot -->
                <Border
                    Grid.Column="1"
                    Padding="16,14"
                    CornerRadius="8"
                    Background="{ThemeResource GwCardBackgroundBrush}"
                    BorderBrush="{ThemeResource GwCardBorderBrush}"
                    BorderThickness="1">
                    <StackPanel Spacing="10">
                        <Grid>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE945;" FontSize="16" Foreground="{ThemeResource GwAmberBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="Performance &amp; Boot" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock x:Name="ActivePowerSchemeBadge" Text="Balanced" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource GwAmberBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>

                        <TextBlock
                            Text="Tune Windows power schemes, disable startup bloat, and manage background loads."
                            FontSize="11"
                            Foreground="{ThemeResource GwTextSecondaryBrush}"
                            TextWrapping="Wrap" />

                        <TextBlock x:Name="StartupAppsCountText" Text="Active Startup Programs: Inspecting..." FontSize="11" Foreground="{ThemeResource GwTextMutedBrush}" />

                        <Button
                            Content="Boost Boot &amp; Speed →"
                            Style="{StaticResource GwCompactButtonStyle}"
                            HorizontalAlignment="Stretch"
                            Click="OnNavigateOptimizeClick" />
                    </StackPanel>
                </Border>

                <!-- Pillar 3: Diagnostics & Network -->
                <Border
                    Grid.Column="2"
                    Padding="16,14"
                    CornerRadius="8"
                    Background="{ThemeResource GwCardBackgroundBrush}"
                    BorderBrush="{ThemeResource GwCardBorderBrush}"
                    BorderThickness="1">
                    <StackPanel Spacing="10">
                        <Grid>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE90F;" FontSize="16" Foreground="{ThemeResource GwTealBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="Diagnostics &amp; Health" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock x:Name="NetworkStatusBadge" Text="Connected" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource GwTealBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>

                        <TextBlock x:Name="NetworkSummaryText" Text="Wi-Fi / Ethernet status verifying..." FontSize="11" Foreground="{ThemeResource GwTextSecondaryBrush}" TextWrapping="Wrap" />
                        <TextBlock x:Name="PendingRebootBadge" Text="No Pending System Reboots" FontSize="11" Foreground="{ThemeResource GwSignalGreenBrush}" />

                        <Button
                            Content="Network &amp; Diagnostics →"
                            Style="{StaticResource GwCompactButtonStyle}"
                            HorizontalAlignment="Stretch"
                            Click="OnNavigateDiagnosticsClick" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 3. BOTTOM DECK: ACTIVE PROCESSES & SYSTEM ADVISORIES -->
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left Column: Top Active Resource Processes -->
                <Border
                    Grid.Column="0"
                    Padding="16,14"
                    CornerRadius="8"
                    Background="{ThemeResource GwCardBackgroundBrush}"
                    BorderBrush="{ThemeResource GwCardBorderBrush}"
                    BorderThickness="1">
                    <StackPanel Spacing="10">
                        <Grid>
                            <TextBlock Text="Active Processes (Top Memory Load)" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" VerticalAlignment="Center" />
                            <Button Content="Refresh" Style="{StaticResource GwCompactButtonStyle}" HorizontalAlignment="Right" Click="OnRefreshProcessesClick" />
                        </Grid>

                        <ListView
                            x:Name="TopProcessesListView"
                            MaxHeight="260"
                            SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:ProcessRowViewModel">
                                    <Border Margin="0,2" Padding="10,6" CornerRadius="6" Background="{ThemeResource GwCardBackgroundHoverBrush}">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind ProcessName}" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource GwTextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind SummaryLine}" FontSize="10" Foreground="{ThemeResource GwTextMutedBrush}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{x:Bind WorkingSetDisplay}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource GwAccentBrush}" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                <!-- Right Column: System Advisories (With engaging empty state) -->
                <Border
                    Grid.Column="1"
                    Padding="16,14"
                    CornerRadius="8"
                    Background="{ThemeResource GwCardBackgroundBrush}"
                    BorderBrush="{ThemeResource GwCardBorderBrush}"
                    BorderThickness="1">
                    <StackPanel Spacing="10">
                        <Grid>
                            <TextBlock Text="System Advisories &amp; Insights" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" VerticalAlignment="Center" />
                            <Button Content="Run Deep Scan" Style="{StaticResource GwCompactButtonStyle}" HorizontalAlignment="Right" Click="OnRunAdvisoriesScanClick" />
                        </Grid>

                        <!-- Clean Engaging Empty State when No Critical Issues -->
                        <Border
                            x:Name="HealthyEmptyStateBorder"
                            Padding="28,20"
                            CornerRadius="8"
                            Background="{ThemeResource GwCardBackgroundHoverBrush}"
                            BorderBrush="{ThemeResource GwCardBorderBrush}"
                            BorderThickness="1"
                            Visibility="Visible">
                            <StackPanel HorizontalAlignment="Center" Spacing="8">
                                <Border Width="40" Height="40" CornerRadius="20" Background="{ThemeResource GwSignalGreenBgBrush}" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE73E;" FontSize="18" Foreground="{ThemeResource GwSignalGreenBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="No Critical System Issues Detected" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" HorizontalAlignment="Center" />
                                <TextBlock Text="Your Windows configuration, storage headroom, and background services are running with optimal performance." FontSize="11" Foreground="{ThemeResource GwTextSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="360" />
                            </StackPanel>
                        </Border>

                        <!-- Advisories List (Visible only when advisories exist) -->
                        <ListView
                            x:Name="AdvisoriesListView"
                            MaxHeight="260"
                            SelectionMode="None"
                            Visibility="Collapsed">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:OverviewAdvisoryRowViewModel">
                                    <Border Margin="0,3" Padding="12,8" CornerRadius="6" Background="{ThemeResource GwCardBackgroundHoverBrush}">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Glyph="{x:Bind IconGlyph}" FontSize="16" Foreground="{ThemeResource GwAmberBrush}" VerticalAlignment="Top" Margin="0,2,0,0" />
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource GwTextPrimaryBrush}" />
                                                <TextBlock Text="{x:Bind Detail}" FontSize="11" Foreground="{ThemeResource GwTextSecondaryBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</Page>
