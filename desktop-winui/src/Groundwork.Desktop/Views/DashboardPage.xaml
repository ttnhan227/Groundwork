<Page
    x:Class="Groundwork.Desktop.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Groundwork.Desktop"
    xmlns:controls="using:Groundwork.Desktop.Controls">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Padding="24,18">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup>
                    <VisualState x:Name="WideState">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="960" />
                        </VisualState.StateTriggers>
                    </VisualState>
                    <VisualState x:Name="CompactState">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="0" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="PillarCard1.(Grid.Column)" Value="0" />
                            <Setter Target="PillarCard1.(Grid.Row)" Value="0" />
                            <Setter Target="PillarCard1.(Grid.ColumnSpan)" Value="3" />
                            <Setter Target="PillarCard2.(Grid.Column)" Value="0" />
                            <Setter Target="PillarCard2.(Grid.Row)" Value="1" />
                            <Setter Target="PillarCard2.(Grid.ColumnSpan)" Value="3" />
                            <Setter Target="PillarCard3.(Grid.Column)" Value="0" />
                            <Setter Target="PillarCard3.(Grid.Row)" Value="2" />
                            <Setter Target="PillarCard3.(Grid.ColumnSpan)" Value="3" />

                            <Setter Target="DeckLeftCard.(Grid.Column)" Value="0" />
                            <Setter Target="DeckLeftCard.(Grid.Row)" Value="0" />
                            <Setter Target="DeckLeftCard.(Grid.ColumnSpan)" Value="2" />
                            <Setter Target="DeckRightCard.(Grid.Column)" Value="0" />
                            <Setter Target="DeckRightCard.(Grid.Row)" Value="1" />
                            <Setter Target="DeckRightCard.(Grid.ColumnSpan)" Value="2" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <StackPanel Spacing="14" MaxWidth="1320" HorizontalAlignment="Stretch">

                <!-- 1. CLEAN STATUS HERO -->
                <Border
                    Padding="20,16"
                    CornerRadius="6"
                    Background="{ThemeResource GwCardBackgroundBrush}"
                    BorderBrush="{ThemeResource GwCardBorderBrush}"
                    BorderThickness="1">
                    <Grid ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <controls:HealthGauge x:Name="OverallHealthGauge" Value="96" StatusLabel="Healthy" VerticalAlignment="Center" />

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <TextBlock Text="PC Overview" Style="{StaticResource GwPanelTitleStyle}" />
                                <Border x:Name="HeroStatusBadgeBorder" Padding="8,2" CornerRadius="4" Background="{ThemeResource GwSignalGreenBgBrush}" VerticalAlignment="Center">
                                    <TextBlock x:Name="HeroStatusBadgeText" Text="Checking" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource GwSignalGreenBrush}" />
                                </Border>
                            </StackPanel>

                            <TextBlock
                                x:Name="HeroSubtitleText"
                                Text="Quick snapshot of storage, startup speed, and system health."
                                Style="{StaticResource GwPanelSubtitleStyle}" />

                            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,2,0,0">
                                <TextBlock x:Name="DeviceModelText" Text="Windows PC" FontSize="12" Foreground="{ThemeResource GwTextMutedBrush}" />
                                <TextBlock Text="•" FontSize="12" Foreground="{ThemeResource GwTextMutedBrush}" />
                                <TextBlock x:Name="UptimeText" Text="Uptime: --" FontFamily="Consolas" FontSize="12" Foreground="{ThemeResource GwTextMutedBrush}" />
                                <TextBlock Text="•" FontSize="12" Foreground="{ThemeResource GwTextMutedBrush}" />
                                <TextBlock x:Name="LiveCpuMemText" Text="CPU: --% • RAM: --%" FontFamily="Consolas" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource GwAccentBrush}" />
                            </StackPanel>
                        </StackPanel>

                        <Button
                            Grid.Column="2"
                            x:Name="QuickSmartCheckBtn"
                            Content="Refresh Check"
                            Style="{StaticResource GwPrimaryButtonStyle}"
                            VerticalAlignment="Center"
                            Click="OnSmartHealthCheckClick" />
                    </Grid>
                </Border>

                <!-- 2. THREE CORE PILLARS -->
                <Grid ColumnSpacing="14" RowSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Storage -->
                    <Border
                        x:Name="PillarCard1"
                        Grid.Column="0"
                        Grid.Row="0"
                        Padding="14,12"
                        CornerRadius="6"
                        Background="{ThemeResource GwCardBackgroundBrush}"
                        BorderBrush="{ThemeResource GwCardBorderBrush}"
                        BorderThickness="1">
                        <Grid RowSpacing="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xEDA2;" FontSize="15" Foreground="{ThemeResource GwAccentBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="Storage" Style="{StaticResource GwCardTitleStyle}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock x:Name="StorageFreePercentText" Text="-- Free" FontFamily="Consolas" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource GwAccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>

                            <StackPanel Grid.Row="1" Spacing="6" VerticalAlignment="Center">
                                <ProgressBar x:Name="StorageProgressBar" Value="0" Maximum="100" Height="6" CornerRadius="2" Foreground="{ThemeResource GwAccentBrush}" />
                                <TextBlock x:Name="StorageCapacitySummaryText" Text="Checking drives..." FontFamily="Consolas" FontSize="11.5" Foreground="{ThemeResource GwTextSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>

                            <Button
                                Grid.Row="2"
                                Content="Analyze &amp; Clean →"
                                Style="{StaticResource GwCompactButtonStyle}"
                                HorizontalAlignment="Stretch"
                                Click="OnNavigateStorageClick" />
                        </Grid>
                    </Border>

                    <!-- Speed & Boot -->
                    <Border
                        x:Name="PillarCard2"
                        Grid.Column="1"
                        Grid.Row="0"
                        Padding="14,12"
                        CornerRadius="6"
                        Background="{ThemeResource GwCardBackgroundBrush}"
                        BorderBrush="{ThemeResource GwCardBorderBrush}"
                        BorderThickness="1">
                        <Grid RowSpacing="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE945;" FontSize="15" Foreground="{ThemeResource GwAmberBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="Speed &amp; Boot" Style="{StaticResource GwCardTitleStyle}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock x:Name="ActivePowerSchemeBadge" Text="Balanced" FontFamily="Consolas" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource GwAmberBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>

                            <StackPanel Grid.Row="1" Spacing="4" VerticalAlignment="Center">
                                <TextBlock x:Name="StartupAppsCountText" Text="Checking startup apps..." FontSize="12.5" FontWeight="Medium" Foreground="{ThemeResource GwTextPrimaryBrush}" TextWrapping="Wrap" />
                                <TextBlock Text="Disable slow startup apps or switch power modes." Style="{StaticResource GwPanelSubtitleStyle}" />
                            </StackPanel>

                            <Button
                                Grid.Row="2"
                                Content="Manage Startup →"
                                Style="{StaticResource GwCompactButtonStyle}"
                                HorizontalAlignment="Stretch"
                                Click="OnNavigateOptimizeClick" />
                        </Grid>
                    </Border>

                    <!-- Health & Network -->
                    <Border
                        x:Name="PillarCard3"
                        Grid.Column="2"
                        Grid.Row="0"
                        Padding="14,12"
                        CornerRadius="6"
                        Background="{ThemeResource GwCardBackgroundBrush}"
                        BorderBrush="{ThemeResource GwCardBorderBrush}"
                        BorderThickness="1">
                        <Grid RowSpacing="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE90F;" FontSize="15" Foreground="{ThemeResource GwTealBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="Health &amp; Network" Style="{StaticResource GwCardTitleStyle}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock x:Name="NetworkStatusBadge" Text="Checking" FontFamily="Consolas" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource GwTealBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>

                            <StackPanel Grid.Row="1" Spacing="4" VerticalAlignment="Center">
                                <TextBlock x:Name="NetworkSummaryText" Text="Checking network..." FontFamily="Consolas" FontSize="11.5" Foreground="{ThemeResource GwTextSecondaryBrush}" TextWrapping="Wrap" />
                                <TextBlock x:Name="PendingRebootBadge" Text="Checking Windows updates..." FontSize="12" FontWeight="Medium" Foreground="{ThemeResource GwSignalGreenBrush}" />
                            </StackPanel>

                            <Button
                                Grid.Row="2"
                                Content="Run Diagnostics →"
                                Style="{StaticResource GwCompactButtonStyle}"
                                HorizontalAlignment="Stretch"
                                Click="OnNavigateDiagnosticsClick" />
                        </Grid>
                    </Border>
                </Grid>

                <!-- COMPACT DIAGNOSTIC COMMAND STRIP -->
                <Border
                    Padding="12,8"
                    CornerRadius="6"
                    Background="{ThemeResource GwSubtleSurfaceBrush}"
                    BorderBrush="{ThemeResource GwCardBorderBrush}"
                    BorderThickness="1">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Text="TOOLKIT"
                            Style="{StaticResource GwSectionHeaderStyle}"
                            VerticalAlignment="Center"
                            Margin="2,0,8,0" />
                        <Button
                            Grid.Column="1"
                            Content="Windows 11 Tweaks &amp; Debloat →"
                            Style="{StaticResource GwCompactButtonStyle}"
                            HorizontalAlignment="Stretch"
                            Click="OnNavigateTweaksClick" />
                        <Button
                            Grid.Column="2"
                            Content="1-Click Repairs &amp; Runtimes →"
                            Style="{StaticResource GwCompactButtonStyle}"
                            HorizontalAlignment="Stretch"
                            Click="OnNavigateRepairClick" />
                        <Button
                            Grid.Column="3"
                            Content="Store Bloatware &amp; winget →"
                            Style="{StaticResource GwCompactButtonStyle}"
                            HorizontalAlignment="Stretch"
                            Click="OnNavigateBloatwareClick" />
                    </Grid>
                </Border>

                <!-- 3. BOTTOM DECK -->
                <Grid ColumnSpacing="14" RowSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Top Memory Apps -->
                    <Border
                        x:Name="DeckLeftCard"
                        Grid.Column="0"
                        Grid.Row="0"
                        CornerRadius="6"
                        Background="{ThemeResource GwCardBackgroundBrush}"
                        BorderBrush="{ThemeResource GwCardBorderBrush}"
                        BorderThickness="1">
                        <StackPanel>
                            <Grid Padding="16,10" Background="{ThemeResource GwSubtleSurfaceBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="0,0,0,1">
                                <TextBlock Text="Top Memory Usage" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" VerticalAlignment="Center" />
                                <Button Content="Refresh" Style="{StaticResource GwCompactButtonStyle}" HorizontalAlignment="Right" Click="OnRefreshProcessesClick" />
                            </Grid>

                            <ListView
                                x:Name="TopProcessesListView"
                                MaxHeight="290"
                                SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:ProcessRowViewModel">
                                        <Border Padding="16,9" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="0,0,0,1">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind ProcessName}" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource GwTextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{x:Bind SummaryLine}" FontSize="11" Foreground="{ThemeResource GwTextMutedBrush}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{x:Bind WorkingSetDisplay}" FontSize="12.5" FontWeight="SemiBold" Foreground="{ThemeResource GwAccentBrush}" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>

                    <!-- Attention Needed -->
                    <Border
                        x:Name="DeckRightCard"
                        Grid.Column="1"
                        Grid.Row="0"
                        CornerRadius="6"
                        Background="{ThemeResource GwCardBackgroundBrush}"
                        BorderBrush="{ThemeResource GwCardBorderBrush}"
                        BorderThickness="1">
                        <StackPanel>
                            <Grid Padding="16,10" Background="{ThemeResource GwSubtleSurfaceBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="0,0,0,1">
                                <TextBlock Text="Needs Attention" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" VerticalAlignment="Center" />
                                <Button Content="Re-check" Style="{StaticResource GwCompactButtonStyle}" HorizontalAlignment="Right" Click="OnRunAdvisoriesScanClick" />
                            </Grid>

                            <Border
                                x:Name="HealthyEmptyStateBorder"
                                Padding="24,24"
                                Background="{ThemeResource GwCardBackgroundBrush}"
                                Visibility="Visible">
                                <StackPanel HorizontalAlignment="Center" Spacing="8">
                                    <Border Width="40" Height="40" CornerRadius="6" Background="{ThemeResource GwSignalGreenBgBrush}" HorizontalAlignment="Center">
                                        <FontIcon Glyph="&#xE73E;" FontSize="18" Foreground="{ThemeResource GwSignalGreenBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="Everything looks good" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="No urgent storage, startup, or Windows update issues detected." FontSize="12" Foreground="{ThemeResource GwTextSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="320" />
                                </StackPanel>
                            </Border>

                            <ListView
                                x:Name="AdvisoriesListView"
                                MaxHeight="290"
                                SelectionMode="None"
                                Visibility="Collapsed">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:OverviewAdvisoryRowViewModel">
                                        <Border Padding="16,10" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="0,0,0,1">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <FontIcon Glyph="{x:Bind IconGlyph}" FontSize="16" Foreground="{ThemeResource GwAmberBrush}" VerticalAlignment="Top" Margin="0,2,0,0" />
                                                <StackPanel Grid.Column="1" Spacing="2">
                                                    <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource GwTextPrimaryBrush}" />
                                                    <TextBlock Text="{x:Bind Detail}" FontSize="11.5" Foreground="{ThemeResource GwTextSecondaryBrush}" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <Button Grid.Column="2" Content="Fix →" Tag="{x:Bind ActionTag}" Style="{StaticResource GwCompactButtonStyle}" VerticalAlignment="Center" Click="OnAdvisoryFixClick" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>
                </Grid>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
