<Page
    x:Class="Groundwork.Desktop.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Groundwork.Desktop">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Padding="24,20">
            <StackPanel Spacing="16" MaxWidth="820" HorizontalAlignment="Stretch">

                <StackPanel Spacing="2">
                    <TextBlock Text="Settings" FontSize="20" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" />
                    <TextBlock Text="Customize appearance, privacy, and optional AI provider." FontSize="12" Foreground="{ThemeResource GwTextSecondaryBrush}" />
                </StackPanel>

                <!-- 1. APPEARANCE -->
                <TextBlock Text="Appearance" Style="{StaticResource GwSectionHeaderStyle}" Margin="0,4,0,0" />
                <Border Padding="18,14" CornerRadius="10" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                    <StackPanel Spacing="14">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Theme" FontWeight="Medium" FontSize="13" Foreground="{ThemeResource GwTextPrimaryBrush}" />
                                <TextBlock Text="Choose Light or Dark mode." FontSize="12" Foreground="{ThemeResource GwTextSecondaryBrush}" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" x:Name="ThemeModeCombo" Width="160" SelectionChanged="OnThemeModeSelectionChanged">
                                <ComboBoxItem Content="Light" Tag="Light" />
                                <ComboBoxItem Content="Dark" Tag="Dark" />
                            </ComboBox>
                        </Grid>

                        <Rectangle Height="1" Fill="{ThemeResource GwCardBorderBrush}" />

                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="File Size Units" FontWeight="Medium" FontSize="13" Foreground="{ThemeResource GwTextPrimaryBrush}" />
                                <TextBlock Text="Binary (1024) or Decimal (1000)." FontSize="12" Foreground="{ThemeResource GwTextSecondaryBrush}" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" x:Name="SizeUnitCombo" Width="160" SelectionChanged="OnSizeUnitSelectionChanged">
                                <ComboBoxItem Content="Auto" Tag="Auto" />
                                <ComboBoxItem Content="Binary (GiB)" Tag="Binary" />
                                <ComboBoxItem Content="Decimal (GB)" Tag="Decimal" />
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 2. PRIVACY -->
                <TextBlock Text="Privacy" Style="{StaticResource GwSectionHeaderStyle}" Margin="0,4,0,0" />
                <Border Padding="18,14" CornerRadius="10" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Hide Hardware Serials in Exports" FontWeight="Medium" FontSize="13" Foreground="{ThemeResource GwTextPrimaryBrush}" />
                            <TextBlock Text="Diagnostics stay on this PC. API keys are encrypted with Windows DPAPI." FontSize="12" Foreground="{ThemeResource GwTextSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" x:Name="MaskSerialsSwitch" MinWidth="0" OnContent="On" OffContent="Off" Toggled="OnMaskSerialsToggled" />
                    </Grid>
                </Border>

                <!-- 3. AI ASSISTANT PROVIDER -->
                <TextBlock Text="AI Assistant" Style="{StaticResource GwSectionHeaderStyle}" Margin="0,4,0,0" />
                <Border Padding="18,14" CornerRadius="10" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                    <StackPanel Spacing="14">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="AI Provider" FontWeight="Medium" FontSize="13" Foreground="{ThemeResource GwTextPrimaryBrush}" />
                                <TextBlock Text="Optional. Works offline without an AI key." FontSize="12" Foreground="{ThemeResource GwTextSecondaryBrush}" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" x:Name="AiProviderCombo" Width="180" SelectionChanged="OnAiProviderSelectionChanged">
                                <ComboBoxItem Content="Offline Only" Tag="none" />
                                <ComboBoxItem Content="Ollama (Local)" Tag="ollama" />
                                <ComboBoxItem Content="Google Gemini" Tag="gemini" />
                                <ComboBoxItem Content="OpenAI" Tag="openai" />
                                <ComboBoxItem Content="Mistral AI" Tag="mistral" />
                                <ComboBoxItem Content="Anthropic" Tag="anthropic" />
                                <ComboBoxItem Content="Custom (OpenAI API)" Tag="custom" />
                            </ComboBox>
                        </Grid>

                        <Grid x:Name="AiModelGrid" ColumnSpacing="14" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="220" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Model Name" FontWeight="Medium" FontSize="13" Foreground="{ThemeResource GwTextPrimaryBrush}" />
                                <TextBlock Text="Model ID for multi-step assistant queries." FontSize="12" Foreground="{ThemeResource GwTextSecondaryBrush}" />
                            </StackPanel>
                            <TextBox Grid.Column="1" x:Name="AiModelTextBox" PlaceholderText="e.g. gemini-2.5-flash" LostFocus="OnAiConfigTextChanged" />
                        </Grid>

                        <Grid x:Name="AiEndpointGrid" ColumnSpacing="14" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="220" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Endpoint URL" FontWeight="Medium" FontSize="13" Foreground="{ThemeResource GwTextPrimaryBrush}" />
                                <TextBlock Text="Local Ollama or OpenAI-compatible URL." FontSize="12" Foreground="{ThemeResource GwTextSecondaryBrush}" />
                            </StackPanel>
                            <TextBox Grid.Column="1" x:Name="AiEndpointTextBox" PlaceholderText="http://127.0.0.1:11434" LostFocus="OnAiConfigTextChanged" />
                        </Grid>

                        <Grid x:Name="ApiKeyGrid" ColumnSpacing="14" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="220" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="API Key" FontWeight="Medium" FontSize="13" Foreground="{ThemeResource GwTextPrimaryBrush}" />
                                <TextBlock Text="Encrypted locally on your Windows account." FontSize="12" Foreground="{ThemeResource GwTextSecondaryBrush}" />
                            </StackPanel>
                            <PasswordBox Grid.Column="1" x:Name="ApiKeyPasswordBox" PlaceholderText="Paste API key..." PasswordChanged="OnApiKeyPasswordChanged" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 4. ADVANCED -->
                <Expander Header="Advanced Scan Settings" HorizontalAlignment="Stretch" Padding="16,12">
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="Scan Threads" FontWeight="Medium" FontSize="13" Foreground="{ThemeResource GwTextPrimaryBrush}" />
                                <TextBlock Text="Parallel workers used for disk scans (2 to 16)." FontSize="12" Foreground="{ThemeResource GwTextSecondaryBrush}" />
                            </StackPanel>
                            <NumberBox Grid.Column="1" x:Name="WorkerThreadsNumberBox" Value="8" Minimum="2" Maximum="16" SpinButtonPlacementMode="Inline" Width="120" />
                        </Grid>

                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="260" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="Excluded Folders" FontWeight="Medium" FontSize="13" Foreground="{ThemeResource GwTextPrimaryBrush}" />
                                <TextBlock Text="Comma-separated folder names to skip." FontSize="12" Foreground="{ThemeResource GwTextSecondaryBrush}" />
                            </StackPanel>
                            <TextBox Grid.Column="1" x:Name="ExcludedPathsBox" Text="$Recycle.Bin,System Volume Information" />
                        </Grid>
                    </StackPanel>
                </Expander>

                <!-- 5. ABOUT -->
                <Border Padding="18,14" CornerRadius="10" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Image Source="ms-appx:///Assets/icon.png" Width="32" Height="32" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Groundwork v2.0" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" />
                            <TextBlock Text="Native Windows PC Diagnostics &amp; Maintenance Toolkit" FontSize="12" Foreground="{ThemeResource GwTextSecondaryBrush}" />
                        </StackPanel>
                        <Button Grid.Column="2" Content="Open Data Folder" Style="{StaticResource GwSecondaryButtonStyle}" Click="OnOpenLogsFolderClick" VerticalAlignment="Center" />
                    </Grid>
                </Border>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
