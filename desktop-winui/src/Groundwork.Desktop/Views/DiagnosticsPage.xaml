<Page
    x:Class="Groundwork.Desktop.Views.DiagnosticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Groundwork.Desktop"
    xmlns:models="using:Groundwork.Engine.Models">

    <Grid Padding="24,18">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="860" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="CompactState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="CardCpu.(Grid.Column)" Value="0" />
                        <Setter Target="CardCpu.(Grid.Row)" Value="0" />
                        <Setter Target="CardCpu.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="CardMobo.(Grid.Column)" Value="0" />
                        <Setter Target="CardMobo.(Grid.Row)" Value="1" />
                        <Setter Target="CardMobo.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="CardRam.(Grid.Column)" Value="0" />
                        <Setter Target="CardRam.(Grid.Row)" Value="2" />
                        <Setter Target="CardRam.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="CardGpu.(Grid.Column)" Value="0" />
                        <Setter Target="CardGpu.(Grid.Row)" Value="3" />
                        <Setter Target="CardGpu.(Grid.ColumnSpan)" Value="2" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid MaxWidth="1320" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- UNDERLINE TAB STRIP -->
            <Border Grid.Row="0" Margin="0,0,0,16" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="TabHardwareBtn" Content="PC Specs" Style="{StaticResource GwUnderlineTabActiveStyle}" Click="OnTabHardwareClick" />
                    <Button x:Name="TabNetworkBtn" Content="Quick Check &amp; Network" Style="{StaticResource GwUnderlineTabStyle}" Click="OnTabNetworkClick" />
                    <Button x:Name="TabRepairBtn" Content="Errors &amp; Repair" Style="{StaticResource GwUnderlineTabStyle}" Click="OnTabRepairClick" />
                </StackPanel>
            </Border>

            <!-- 1. PC SPECS -->
            <ScrollViewer x:Name="SubViewHardware" Grid.Row="1" Visibility="Visible" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="14">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="1" VerticalAlignment="Center">
                            <TextBlock Text="PC Hardware &amp; Windows Specifications" FontSize="17" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" />
                            <TextBlock x:Name="HardwareOsSummaryText" Text="Inspecting processor, memory, graphics, and drives..." FontSize="12" Foreground="{ThemeResource GwTextSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Content="Copy Specs" Style="{StaticResource GwSecondaryButtonStyle}" Click="OnCopySpecsSummaryClick" />
                            <Button Content="Refresh" Style="{StaticResource GwPrimaryButtonStyle}" Click="OnRefreshHardwareClick" />
                        </StackPanel>
                    </Grid>

                    <Grid ColumnSpacing="12" RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border x:Name="CardCpu" Grid.Row="0" Grid.Column="0" Padding="18,16" CornerRadius="6" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                            <StackPanel Spacing="5">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE950;" FontSize="15" Foreground="{ThemeResource GwAccentBrush}" />
                                    <TextBlock Text="PROCESSOR" Style="{StaticResource GwSectionHeaderStyle}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock x:Name="CpuModelText" Text="Loading..." FontSize="14.5" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" TextWrapping="Wrap" />
                                <TextBlock x:Name="CpuCoresText" Text="..." FontSize="12" Foreground="{ThemeResource GwTextSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="CardMobo" Grid.Row="0" Grid.Column="1" Padding="18,16" CornerRadius="6" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                            <StackPanel Spacing="5">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE7F4;" FontSize="15" Foreground="{ThemeResource GwTealBrush}" />
                                    <TextBlock Text="MOTHERBOARD &amp; BIOS" Style="{StaticResource GwSectionHeaderStyle}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock x:Name="MoboModelText" Text="Loading..." FontSize="14.5" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" TextWrapping="Wrap" />
                                <TextBlock x:Name="BiosVersionText" Text="..." FontSize="12" Foreground="{ThemeResource GwTextSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="CardRam" Grid.Row="1" Grid.Column="0" Padding="18,16" CornerRadius="6" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                            <StackPanel Spacing="5">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE950;" FontSize="15" Foreground="{ThemeResource GwAmberBrush}" />
                                    <TextBlock Text="MEMORY (RAM)" Style="{StaticResource GwSectionHeaderStyle}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock x:Name="MemorySummaryText" Text="Loading..." FontSize="14.5" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" TextWrapping="Wrap" />
                                <TextBlock x:Name="DimmSlotsDetailText" Text="..." FontSize="12" Foreground="{ThemeResource GwTextSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="CardGpu" Grid.Row="1" Grid.Column="1" Padding="18,16" CornerRadius="6" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                            <StackPanel Spacing="5">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE7F4;" FontSize="15" Foreground="{ThemeResource GwPurpleBrush}" />
                                    <TextBlock Text="GRAPHICS (GPU)" Style="{StaticResource GwSectionHeaderStyle}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock x:Name="GpuSummaryText" Text="Loading..." FontSize="14.5" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" TextWrapping="Wrap" />
                                <TextBlock x:Name="GpuDriverText" Text="..." FontSize="12" Foreground="{ThemeResource GwTextSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border CornerRadius="6" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <Grid Padding="16,8" Background="{ThemeResource GwSubtleSurfaceBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="0,0,0,1" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="110" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="PHYSICAL STORAGE DRIVE" Style="{StaticResource GwTableColumnHeaderStyle}" />
                                <TextBlock Grid.Column="1" Text="INTERFACE" Style="{StaticResource GwTableColumnHeaderStyle}" />
                                <TextBlock Grid.Column="2" Text="CAPACITY" Style="{StaticResource GwTableColumnHeaderStyle}" HorizontalAlignment="Right" />
                            </Grid>

                            <ListView x:Name="PhysicalDisksListView" SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:PhysicalDiskSpecsInfo">
                                        <Border Padding="16,10" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="0,0,0,1">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="120" />
                                                    <ColumnDefinition Width="110" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{x:Bind Model}" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource GwTextPrimaryBrush}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind InterfaceType}" FontSize="12" Foreground="{ThemeResource GwTextSecondaryBrush}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Text="{x:Bind FormattedSize}" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource GwAccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 2. QUICK CHECK & NETWORK -->
            <ScrollViewer x:Name="SubViewNetwork" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="14">
                    <Border Padding="18,16" CornerRadius="6" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                        <StackPanel Spacing="12">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Quick Symptom Check" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" />
                                <TextBlock Text="Run targeted live-telemetry diagnostics for common bottlenecks." FontSize="12" Foreground="{ThemeResource GwTextSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>

                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="Slow PC" Style="{StaticResource GwSecondaryButtonStyle}" HorizontalAlignment="Stretch" Click="OnInvestigatePerformanceClick" />
                                <Button Grid.Column="1" Content="Internet Drops" Style="{StaticResource GwSecondaryButtonStyle}" HorizontalAlignment="Stretch" Click="OnInvestigateNetworkClick" />
                                <Button Grid.Column="2" Content="Low Disk Space" Style="{StaticResource GwSecondaryButtonStyle}" HorizontalAlignment="Stretch" Click="OnInvestigateStorageClick" />
                                <Button Grid.Column="3" Content="Windows Health" Style="{StaticResource GwSecondaryButtonStyle}" HorizontalAlignment="Stretch" Click="OnInvestigateHealthClick" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border
                        x:Name="InvestigationResultsCard"
                        CornerRadius="6"
                        Background="{ThemeResource GwCardBackgroundBrush}"
                        BorderBrush="{ThemeResource GwCardBorderBrush}"
                        BorderThickness="1"
                        Visibility="Collapsed">
                        <StackPanel>
                            <Grid Padding="16,10" Background="{ThemeResource GwSubtleSurfaceBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="0,0,0,1" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="InvestigationTitleText" Text="Results" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="Copy Report" Style="{StaticResource GwCompactButtonStyle}" Click="OnCopyInvestigationReportClick" />
                            </Grid>

                            <ListView x:Name="ConfirmedFindingsListView" SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:InvestigationFindingRowViewModel">
                                        <Border Padding="16,10" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="0,0,0,1">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource GwTextPrimaryBrush}" TextWrapping="Wrap" />
                                                <TextBlock Text="{x:Bind Detail}" FontSize="12" Foreground="{ThemeResource GwTextSecondaryBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <TextBlock x:Name="RecommendedActionsHeader" Text="RECOMMENDED ACTIONS" Style="{StaticResource GwSectionHeaderStyle}" Visibility="Collapsed" Margin="16,12,16,6" />
                            <ListView x:Name="RecommendedActionsListView" SelectionMode="None" Visibility="Collapsed">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:InvestigationRecommendationRowViewModel">
                                        <Border Padding="16,10" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="0,0,0,1">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource GwTextPrimaryBrush}" TextWrapping="Wrap" />
                                                    <TextBlock Text="{x:Bind Explanation}" FontSize="12" Foreground="{ThemeResource GwTextSecondaryBrush}" TextWrapping="Wrap" />
                                                    <TextBlock Text="{x:Bind SafetyBadge}" FontSize="10.5" Foreground="{ThemeResource GwTextMutedBrush}" />
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="{x:Bind ActionButtonText}" Tag="{x:Bind RecommendationId}" Style="{StaticResource GwPrimaryButtonStyle}" VerticalAlignment="Center" Click="OnExecuteRecommendationClick" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>

                    <Border Padding="18,16" CornerRadius="6" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                        <StackPanel Spacing="12">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Internet &amp; DNS" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="Test Connection" Style="{StaticResource GwPrimaryButtonStyle}" Click="OnTestNetworkClick" />
                            </Grid>

                            <Border Padding="14,12" CornerRadius="5" Background="{ThemeResource GwSubtleSurfaceBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE839;" FontSize="18" Foreground="{ThemeResource GwAccentBrush}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock x:Name="NetworkNameText" Text="Network Adapter" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource GwTextPrimaryBrush}" />
                                        <TextBlock x:Name="NetworkIpDisplay" Text="Checking IP..." FontSize="12" Foreground="{ThemeResource GwTextSecondaryBrush}" />
                                        <TextBlock x:Name="NetworkDnsDisplay" Text="Checking DNS..." FontSize="12" Foreground="{ThemeResource GwTealBrush}" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="Flush DNS" Style="{StaticResource GwCompactButtonStyle}" VerticalAlignment="Center" Click="OnFlushDnsClick" />
                                </Grid>
                            </Border>

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="1-Click DNS:" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource GwTextSecondaryBrush}" VerticalAlignment="Center" />
                                <Button Content="Cloudflare (1.1.1.1)" Tag="Cloudflare" Style="{StaticResource GwCompactButtonStyle}" Click="OnSwitchDnsProviderClick" />
                                <Button Content="Google (8.8.8.8)" Tag="Google" Style="{StaticResource GwCompactButtonStyle}" Click="OnSwitchDnsProviderClick" />
                                <Button Content="Quad9 (9.9.9.9)" Tag="Quad9" Style="{StaticResource GwCompactButtonStyle}" Click="OnSwitchDnsProviderClick" />
                                <Button Content="Auto (DHCP)" Tag="Automatic" Style="{StaticResource GwCompactButtonStyle}" Click="OnSwitchDnsProviderClick" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 3. ERRORS & REPAIR -->
            <ScrollViewer x:Name="SubViewRepair" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="14">
                    <!-- 1-CLICK WINDOWS REPAIR TOOLKIT -->
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="1-Click Windows Repair Toolkit" FontSize="17" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" />
                                <Border Padding="6,2" CornerRadius="3" Background="{ThemeResource GwAccentBgBrush}">
                                    <TextBlock x:Name="RepairSessionBadge" Text="Standard User" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource GwAccentBrush}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Direct fixes for broken icons, Winsock/network stalls, jammed print queues, and stuck Windows Update caches." FontSize="12" Foreground="{ThemeResource GwTextSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button x:Name="RestartAsAdminBtn" Content="Restart as Admin" Style="{StaticResource GwSecondaryButtonStyle}" Click="OnRestartAsAdminClick" />
                            <Button Content="DISM CheckHealth" Style="{StaticResource GwPrimaryButtonStyle}" Click="OnVerifySystemIntegrityClick" />
                        </StackPanel>
                    </Grid>

                    <Border CornerRadius="6" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <Grid Padding="14,7" Background="{ThemeResource GwSubtleSurfaceBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="0,0,0,1" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="125" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="90" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="CATEGORY" Style="{StaticResource GwTableColumnHeaderStyle}" />
                                <TextBlock Grid.Column="1" Text="SCOPE" Style="{StaticResource GwTableColumnHeaderStyle}" />
                                <TextBlock Grid.Column="2" Text="REPAIR ACTION" Style="{StaticResource GwTableColumnHeaderStyle}" />
                                <TextBlock Grid.Column="3" Text="RUN" Style="{StaticResource GwTableColumnHeaderStyle}" HorizontalAlignment="Right" />
                            </Grid>

                            <ListView x:Name="RepairWorkflowsListView" SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:RepairWorkflowRowViewModel">
                                        <Border Padding="14,9" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="0,0,0,1">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="125" />
                                                    <ColumnDefinition Width="80" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="90" />
                                                </Grid.ColumnDefinitions>
                                                <Border Padding="6,2" CornerRadius="3" Background="{ThemeResource GwAccentBgBrush}" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind Category}" FontSize="10.5" FontWeight="SemiBold" Foreground="{ThemeResource GwAccentBrush}" />
                                                </Border>
                                                <Border Grid.Column="1" Padding="6,2" CornerRadius="3" Background="{ThemeResource GwSubtleSurfaceBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind PrivilegeBadge}" FontSize="10.5" FontWeight="SemiBold" Foreground="{ThemeResource GwTextSecondaryBrush}" />
                                                </Border>
                                                <StackPanel Grid.Column="2" Spacing="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind DisplayName}" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource GwTextPrimaryBrush}" />
                                                    <TextBlock Text="{x:Bind Summary}" FontSize="11.5" Foreground="{ThemeResource GwTextSecondaryBrush}" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <Button Grid.Column="3" Content="Run Fix" Tag="{x:Bind RepairId}" Style="{StaticResource GwCompactButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="OnRunRepairWorkflowClick" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>

                    <!-- ESSENTIAL APP & GAME RUNTIME HEALTH -->
                    <Border CornerRadius="6" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <Grid Padding="14,10" Background="{ThemeResource GwSubtleSurfaceBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="0,0,0,1" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="1">
                                    <TextBlock Text="App &amp; Game Runtime Health" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" />
                                    <TextBlock Text="Verifies core libraries needed to prevent missing DLL crashes (VC++ Redistributable, .NET Desktop, WebView2)." FontSize="11.5" Foreground="{ThemeResource GwTextSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Refresh" Style="{StaticResource GwCompactButtonStyle}" Click="OnRefreshEventLogsClick" VerticalAlignment="Center" />
                            </Grid>

                            <ListView x:Name="RuntimeHealthListView" SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:RuntimeHealthRowViewModel">
                                        <Border Padding="14,9" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="0,0,0,1">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Spacing="1">
                                                    <TextBlock Text="{x:Bind DisplayName}" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource GwTextPrimaryBrush}" />
                                                    <TextBlock Text="{x:Bind StatusSummary}" FontSize="11.5" Foreground="{ThemeResource GwTextSecondaryBrush}" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <Border Grid.Column="1" Padding="8,2" CornerRadius="3" Background="{ThemeResource GwAccentBgBrush}" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind BadgeText}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource GwAccentBrush}" />
                                                </Border>
                                                <Button Grid.Column="2" Content="Install" Tag="{x:Bind RecommendedWingetId}" Visibility="{x:Bind InstallVisibility}" Style="{StaticResource GwCompactButtonStyle}" VerticalAlignment="Center" Click="OnInstallMissingRuntimeClick" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>

                    <!-- RECENT ERROR LOGS -->
                    <Border CornerRadius="6" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <Grid Padding="14,10" Background="{ThemeResource GwSubtleSurfaceBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="0,0,0,1" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Recent System &amp; Application Error Logs" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="Refresh" Style="{StaticResource GwCompactButtonStyle}" Click="OnRefreshEventLogsClick" />
                            </Grid>

                            <ListView x:Name="EventLogsListView" MaxHeight="340" SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:EventLogRowViewModel">
                                        <Border Padding="14,9" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="0,0,0,1">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <FontIcon Glyph="&#xE783;" FontSize="15" Foreground="{ThemeResource GwAmberBrush}" VerticalAlignment="Top" Margin="0,2,0,0" />
                                                <StackPanel Grid.Column="1" Spacing="2">
                                                    <TextBlock Text="{x:Bind EventHeader}" FontWeight="SemiBold" FontSize="12.5" Foreground="{ThemeResource GwTextPrimaryBrush}" />
                                                    <TextBlock Text="{x:Bind PlainEnglishExplanation}" FontSize="12" Foreground="{ThemeResource GwTextSecondaryBrush}" TextWrapping="Wrap" />
                                                    <TextBlock Text="{x:Bind TimeDisplay}" FontSize="10.5" Foreground="{ThemeResource GwTextMutedBrush}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
