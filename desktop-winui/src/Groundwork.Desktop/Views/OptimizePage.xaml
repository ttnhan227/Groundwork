<Page
    x:Class="Groundwork.Desktop.Views.OptimizePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Groundwork.Desktop">

    <Grid Padding="24,18">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="900" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="CompactState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="CardBalanced.(Grid.Column)" Value="0" />
                        <Setter Target="CardBalanced.(Grid.Row)" Value="0" />
                        <Setter Target="CardBalanced.(Grid.ColumnSpan)" Value="3" />
                        <Setter Target="CardHighPerf.(Grid.Column)" Value="0" />
                        <Setter Target="CardHighPerf.(Grid.Row)" Value="1" />
                        <Setter Target="CardHighPerf.(Grid.ColumnSpan)" Value="3" />
                        <Setter Target="CardPowerSaver.(Grid.Column)" Value="0" />
                        <Setter Target="CardPowerSaver.(Grid.Row)" Value="2" />
                        <Setter Target="CardPowerSaver.(Grid.ColumnSpan)" Value="3" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid MaxWidth="1320" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- UNDERLINE TAB STRIP -->
            <Border Grid.Row="0" Margin="0,0,0,16" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="TabStartupBtn" Content="Startup Apps" Style="{StaticResource GwUnderlineTabActiveStyle}" Click="OnTabStartupClick" />
                    <Button x:Name="TabPowerBtn" Content="Power Mode" Style="{StaticResource GwUnderlineTabStyle}" Click="OnTabPowerClick" />
                    <Button x:Name="TabSettingsBtn" Content="Windows Tweaks" Style="{StaticResource GwUnderlineTabStyle}" Click="OnTabSettingsClick" />
                </StackPanel>
            </Border>

            <!-- 1. STARTUP APPS -->
            <Grid x:Name="SubViewStartup" Grid.Row="1" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10" ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="1" VerticalAlignment="Center">
                        <TextBlock Text="Startup Apps" FontSize="17" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" />
                        <TextBlock x:Name="StartupAppsSummaryText" Text="Manage programs launched automatically at sign-in." FontSize="12" Foreground="{ThemeResource GwTextSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Refresh" Style="{StaticResource GwSecondaryButtonStyle}" Click="OnRefreshStartupClick" VerticalAlignment="Center" />
                </Grid>

                <Grid Grid.Row="1" Margin="0,0,0,12" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Button x:Name="FilterAllBtn" Content="All" Tag="all" Style="{StaticResource GwPrimaryButtonStyle}" Click="OnStartupFilterClick" />
                        <Button x:Name="FilterEnabledBtn" Content="Enabled" Tag="enabled" Style="{StaticResource GwSecondaryButtonStyle}" Click="OnStartupFilterClick" />
                        <Button x:Name="FilterHighBtn" Content="High Impact" Tag="high" Style="{StaticResource GwSecondaryButtonStyle}" Click="OnStartupFilterClick" />
                        <Button x:Name="FilterMissingBtn" Content="Missing Target" Tag="missing" Style="{StaticResource GwSecondaryButtonStyle}" Click="OnStartupFilterClick" />
                    </StackPanel>
                    <TextBox Grid.Column="1" x:Name="StartupSearchBox" PlaceholderText="Filter startup entries..." TextChanged="OnStartupSearchChanged" VerticalAlignment="Center" />
                </Grid>

                <Border Grid.Row="2" CornerRadius="6" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Padding="14,7" Background="{ThemeResource GwSubtleSurfaceBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="0,0,0,1" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="184" />
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="86" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="STARTUP ENTRY &amp; COMMAND" Style="{StaticResource GwTableColumnHeaderStyle}" />
                            <TextBlock Grid.Column="1" Text="IMPACT" Style="{StaticResource GwTableColumnHeaderStyle}" />
                            <TextBlock Grid.Column="2" Text="LOCATION" Style="{StaticResource GwTableColumnHeaderStyle}" />
                            <TextBlock Grid.Column="3" Text="STATE" Style="{StaticResource GwTableColumnHeaderStyle}" HorizontalAlignment="Right" />
                        </Grid>

                        <ListView Grid.Row="1" x:Name="StartupAppsListView" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:StartupItemRowViewModel">
                                    <Border Padding="14,9" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="0,0,0,1">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="30" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="184" />
                                                <ColumnDefinition Width="64" />
                                                <ColumnDefinition Width="86" />
                                            </Grid.ColumnDefinitions>

                                            <Border Width="30" Height="30" CornerRadius="5" Background="{ThemeResource GwSubtleSurfaceBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1" VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xE71D;" FontSize="14" Foreground="{ThemeResource GwAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>

                                            <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource GwTextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                    <Border Padding="6,1" CornerRadius="3" Background="{ThemeResource GwSubtleSurfaceBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                                                        <TextBlock Text="{x:Bind ScopeDisplay}" FontSize="10" Foreground="{ThemeResource GwTextSecondaryBrush}" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{x:Bind Publisher}" FontSize="11.5" Foreground="{ThemeResource GwTextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind CommandOrTarget}" FontFamily="Consolas" FontSize="10.5" Foreground="{ThemeResource GwTextMutedBrush}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <Border Grid.Column="2" Padding="7,2" CornerRadius="3" Background="{ThemeResource GwAccentBgBrush}" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind ImpactAssessment}" FontSize="10.5" FontWeight="SemiBold" Foreground="{ThemeResource GwAccentBrush}" />
                                            </Border>

                                            <Button
                                                Grid.Column="3"
                                                Content="Open"
                                                Tag="{x:Bind CommandOrTarget}"
                                                Style="{StaticResource GwCompactButtonStyle}"
                                                Click="OnOpenStartupLocationClick"
                                                VerticalAlignment="Center" />

                                            <ToggleSwitch
                                                Grid.Column="4"
                                                IsOn="{x:Bind IsEnabled}"
                                                Tag="{x:Bind EntryId}"
                                                OnContent="On"
                                                OffContent="Off"
                                                MinWidth="0"
                                                HorizontalAlignment="Right"
                                                Toggled="OnStartupItemToggled"
                                                VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
            </Grid>

            <!-- 2. POWER MODE -->
            <ScrollViewer x:Name="SubViewPower" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="1">
                        <TextBlock Text="Windows Power Plans &amp; Workstation Tuning" FontSize="17" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" />
                        <TextBlock Text="Switch between efficiency, performance, battery saving, or workstation latency tuning." FontSize="12" Foreground="{ThemeResource GwTextSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>

                    <Grid ColumnSpacing="12" RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border x:Name="CardBalanced" Grid.Column="0" Grid.Row="0" Padding="18,16" CornerRadius="6" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                            <Grid RowSpacing="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Spacing="6">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE945;" FontSize="17" Foreground="{ThemeResource GwAccentBrush}" />
                                        <TextBlock Text="Balanced" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Border Padding="6,2" CornerRadius="3" Background="{ThemeResource GwAccentBgBrush}" HorizontalAlignment="Left">
                                        <TextBlock Text="Recommended" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource GwAccentBrush}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Grid.Row="1" Text="Automatically scales clock frequency and power draw based on current workload." FontSize="12" Foreground="{ThemeResource GwTextSecondaryBrush}" TextWrapping="Wrap" />
                                <Button Grid.Row="2" x:Name="BtnActivateBalanced" Content="Use Plan" Style="{StaticResource GwSecondaryButtonStyle}" HorizontalAlignment="Stretch" Click="OnActivateBalancedClick" />
                            </Grid>
                        </Border>

                        <Border x:Name="CardHighPerf" Grid.Column="1" Grid.Row="0" Padding="18,16" CornerRadius="6" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                            <Grid RowSpacing="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Spacing="6">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE7E8;" FontSize="17" Foreground="{ThemeResource GwAmberBrush}" />
                                        <TextBlock Text="High Performance" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Border Padding="6,2" CornerRadius="3" Background="{ThemeResource GwAmberBgBrush}" HorizontalAlignment="Left">
                                        <TextBlock Text="Best for Gaming / Heavy Work" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource GwAmberBrush}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Grid.Row="1" Text="Minimizes CPU down-clocking for responsive burst performance on AC power." FontSize="12" Foreground="{ThemeResource GwTextSecondaryBrush}" TextWrapping="Wrap" />
                                <Button Grid.Row="2" x:Name="BtnActivateHighPerf" Content="Use Plan" Style="{StaticResource GwSecondaryButtonStyle}" HorizontalAlignment="Stretch" Click="OnActivateHighPerfClick" />
                            </Grid>
                        </Border>

                        <Border x:Name="CardPowerSaver" Grid.Column="2" Grid.Row="0" Padding="18,16" CornerRadius="6" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                            <Grid RowSpacing="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Spacing="6">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xEC0A;" FontSize="17" Foreground="{ThemeResource GwSignalGreenBrush}" />
                                        <TextBlock Text="Power Saver" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Border Padding="6,2" CornerRadius="3" Background="{ThemeResource GwSignalGreenBgBrush}" HorizontalAlignment="Left">
                                        <TextBlock Text="Best for Battery" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource GwSignalGreenBrush}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Grid.Row="1" Text="Reduces background energy use to keep laptops cooler and extend battery runtime." FontSize="12" Foreground="{ThemeResource GwTextSecondaryBrush}" TextWrapping="Wrap" />
                                <Button Grid.Row="2" x:Name="BtnActivatePowerSaver" Content="Use Plan" Style="{StaticResource GwSecondaryButtonStyle}" HorizontalAlignment="Stretch" Click="OnActivatePowerSaverClick" />
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ADVANCED POWER ACTIONS TABLE -->
                    <Border CornerRadius="6" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <Border x:Name="CardUltimatePerf" Padding="18,14" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="0,0,0,1">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="3" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE945;" FontSize="15" Foreground="{ThemeResource GwAccentBrush}" />
                                            <TextBlock Text="Ultimate Performance (Hidden Workstation Plan)" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" />
                                        </StackPanel>
                                        <TextBlock x:Name="UltimateStatusText" Text="Unhides Windows' built-in Ultimate Performance scheme to minimize micro-latency on desktops." FontSize="12" Foreground="{ThemeResource GwTextSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button Grid.Column="1" x:Name="BtnUnlockUltimatePerf" Content="Unlock &amp; Activate" Style="{StaticResource GwPrimaryButtonStyle}" VerticalAlignment="Center" Click="OnUnlockUltimatePerfClick" />
                                </Grid>
                            </Border>

                            <Border Padding="18,14">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="3" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE708;" FontSize="15" Foreground="{ThemeResource GwAmberBrush}" />
                                            <TextBlock Text="Windows Hibernation (hiberfil.sys)" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" />
                                            <Border Padding="6,1" CornerRadius="3" Background="{ThemeResource GwAmberBgBrush}">
                                                <TextBlock Text="Admin" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource GwAmberBrush}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock x:Name="HibernateStatusText" Text="Checking hibernation file status..." FontSize="12" Foreground="{ThemeResource GwTextSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button Grid.Column="1" x:Name="BtnToggleHibernation" Content="Disable Hibernation" Style="{StaticResource GwSecondaryButtonStyle}" VerticalAlignment="Center" Click="OnToggleHibernationClick" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 3. WINDOWS TWEAKS -->
            <Grid x:Name="SubViewSettings" Grid.Row="1" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10" ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="1" VerticalAlignment="Center">
                        <TextBlock Text="Windows 11 Power Tweaks &amp; Debloat" FontSize="17" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" />
                        <TextBlock Text="Apply curated presets or individual registry tweaks safely with one-click Undo rollback." FontSize="12" Foreground="{ThemeResource GwTextSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Content="Clean Win11 &amp; Debloat" Style="{StaticResource GwPrimaryButtonStyle}" Click="OnApplyCleanWin11PresetClick" />
                        <Button Content="Gaming &amp; Raw Mouse" Style="{StaticResource GwSecondaryButtonStyle}" Click="OnApplyGamingPresetClick" />
                        <Button Content="Restart Explorer" Style="{StaticResource GwSecondaryButtonStyle}" Click="OnRestartExplorerClick" />
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="1" Margin="0,0,0,12" Orientation="Horizontal" Spacing="4">
                    <Button x:Name="TweakFilterAllBtn" Content="All Tweaks" Tag="all" Style="{StaticResource GwPrimaryButtonStyle}" Click="OnTweakCategoryFilterClick" />
                    <Button x:Name="TweakFilterUiBtn" Content="UI &amp; Context Menu" Tag="ui" Style="{StaticResource GwSecondaryButtonStyle}" Click="OnTweakCategoryFilterClick" />
                    <Button x:Name="TweakFilterDebloatBtn" Content="Debloat &amp; Privacy" Tag="debloat" Style="{StaticResource GwSecondaryButtonStyle}" Click="OnTweakCategoryFilterClick" />
                    <Button x:Name="TweakFilterPerfBtn" Content="Gaming &amp; Performance" Tag="perf" Style="{StaticResource GwSecondaryButtonStyle}" Click="OnTweakCategoryFilterClick" />
                </StackPanel>

                <Border Grid.Row="2" CornerRadius="6" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Padding="14,7" Background="{ThemeResource GwSubtleSurfaceBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="0,0,0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="80" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="SYSTEM SETTING &amp; IMPACT" Style="{StaticResource GwTableColumnHeaderStyle}" />
                            <TextBlock Grid.Column="1" Text="STATE" Style="{StaticResource GwTableColumnHeaderStyle}" HorizontalAlignment="Right" />
                        </Grid>

                        <ListView Grid.Row="1" x:Name="SettingsListView" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:ConfigurableSettingRowViewModel">
                                    <Border Padding="14,10" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="0,0,0,1">
                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Spacing="2">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Border Padding="6,1" CornerRadius="3" Background="{ThemeResource GwAccentBgBrush}">
                                                        <TextBlock Text="{x:Bind Category}" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource GwAccentBrush}" />
                                                    </Border>
                                                    <TextBlock Text="{x:Bind DisplayName}" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource GwTextPrimaryBrush}" />
                                                </StackPanel>
                                                <TextBlock Text="{x:Bind Explanation}" FontSize="12" Foreground="{ThemeResource GwTextSecondaryBrush}" TextWrapping="Wrap" />
                                                <TextBlock Text="{x:Bind RecommendationNote}" FontSize="11" Foreground="{ThemeResource GwTextMutedBrush}" TextWrapping="Wrap" />
                                            </StackPanel>

                                            <ToggleSwitch
                                                Grid.Column="1"
                                                IsOn="{x:Bind IsEnabled}"
                                                Tag="{x:Bind SettingId}"
                                                OnContent="On"
                                                OffContent="Off"
                                                MinWidth="0"
                                                Toggled="OnConfigurableSettingToggled"
                                                VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>
