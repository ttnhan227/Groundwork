<Page
    x:Class="Groundwork.Desktop.Views.OptimizePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Groundwork.Desktop">

    <Grid Padding="20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- TOP SUB-NAVIGATION SEGMENTS -->
        <Border Grid.Row="0" Margin="0,0,0,14" Padding="4" CornerRadius="8" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal" Spacing="4">
                <Button x:Name="TabStartupBtn" Content="Startup Apps" Style="{StaticResource GwPrimaryButtonStyle}" Click="OnTabStartupClick" />
                <Button x:Name="TabPowerBtn" Content="Power Plans" Style="{StaticResource GwSecondaryButtonStyle}" Click="OnTabPowerClick" />
                <Button x:Name="TabSettingsBtn" Content="Windows Settings" Style="{StaticResource GwSecondaryButtonStyle}" Click="OnTabSettingsClick" />
            </StackPanel>
        </Border>

        <!-- ======================================================== -->
        <!-- SUB-VIEW 1: STARTUP APPS -->
        <!-- ======================================================== -->
        <Grid x:Name="SubViewStartup" Grid.Row="1" Visibility="Visible">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header & Filter Bar -->
            <Border Grid.Row="0" Margin="0,0,0,12" Padding="14,10" CornerRadius="8" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock Text="Startup Applications &amp; Scheduled Tasks" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" />
                        <TextBlock x:Name="StartupAppsSummaryText" Text="Manage apps that automatically launch on user logon. Disabling high-impact entries reduces boot latency." FontSize="11" Foreground="{ThemeResource GwTextSecondaryBrush}" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Refresh" Style="{StaticResource GwSecondaryButtonStyle}" Click="OnRefreshStartupClick" />
                </Grid>
            </Border>

            <!-- Startup Apps List with Windows 11 ToggleSwitch -->
            <ListView
                x:Name="StartupAppsListView"
                Grid.Row="1"
                SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:StartupItemRowViewModel">
                        <Border Margin="0,3" Padding="14,12" CornerRadius="8" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- App Glyph Icon -->
                                <Border Width="38" Height="38" CornerRadius="8" Background="{ThemeResource GwCardBackgroundHoverBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE71D;" FontSize="18" Foreground="{ThemeResource GwAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <!-- App Info & Command Line Drawer -->
                                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource GwTextPrimaryBrush}" />
                                        <Border Padding="6,1" CornerRadius="4" Background="{ThemeResource GwCardBackgroundHoverBrush}">
                                            <TextBlock Text="{x:Bind ScopeDisplay}" FontSize="10" Foreground="{ThemeResource GwTextSecondaryBrush}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind Publisher}" FontSize="11" Foreground="{ThemeResource GwTextSecondaryBrush}" />
                                    <!-- Command preview in muted caption -->
                                    <TextBlock Text="{x:Bind CommandOrTarget}" FontSize="10" Foreground="{ThemeResource GwTextMutedBrush}" TextTrimming="CharacterEllipsis" MaxWidth="500" />
                                </StackPanel>

                                <!-- Impact Chip -->
                                <Border Grid.Column="2" Padding="8,3" CornerRadius="4" Background="{ThemeResource GwAccentBgBrush}" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind ImpactAssessment}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource GwAccentBrush}" />
                                </Border>

                                <!-- Windows 11 ToggleSwitch (On/Off) -->
                                <ToggleSwitch
                                    Grid.Column="3"
                                    IsOn="{x:Bind IsEnabled}"
                                    Tag="{x:Bind EntryId}"
                                    OnContent="Enabled"
                                    OffContent="Disabled"
                                    Toggled="OnStartupItemToggled"
                                    VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- ======================================================== -->
        <!-- SUB-VIEW 2: POWER PLANS -->
        <!-- ======================================================== -->
        <ScrollViewer x:Name="SubViewPower" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16">
                <Border Padding="16,14" CornerRadius="8" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Windows Power Schemes" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" />
                        <TextBlock Text="Select how Windows scales processor frequencies, cooling policies, and device sleep states. All scheme switches are reversible." FontSize="12" Foreground="{ThemeResource GwTextSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- 3 Visual Segmented Cards (Balanced, High Performance, Power Saver) -->
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Balanced Card -->
                    <Border
                        x:Name="CardBalanced"
                        Grid.Column="0"
                        Padding="16,14"
                        CornerRadius="8"
                        Background="{ThemeResource GwCardBackgroundBrush}"
                        BorderBrush="{ThemeResource GwCardBorderBrush}"
                        BorderThickness="1">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE945;" FontSize="20" Foreground="{ThemeResource GwAccentBrush}" />
                                <TextBlock Text="Balanced" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <Border Padding="6,2" CornerRadius="4" Background="{ThemeResource GwAccentBgBrush}" HorizontalAlignment="Left">
                                <TextBlock Text="Recommended for Most PCs" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource GwAccentBrush}" />
                            </Border>
                            <TextBlock Text="Dynamically scales processor clock speeds and sleep states with system load." FontSize="11" Foreground="{ThemeResource GwTextSecondaryBrush}" TextWrapping="Wrap" />
                            <StackPanel Spacing="4">
                                <TextBlock Text="• Smooth CPU frequency boost" FontSize="10" Foreground="{ThemeResource GwTextMutedBrush}" />
                                <TextBlock Text="• Optimal thermal &amp; fan balance" FontSize="10" Foreground="{ThemeResource GwTextMutedBrush}" />
                            </StackPanel>
                            <Button x:Name="BtnActivateBalanced" Content="Set Active" Style="{StaticResource GwSecondaryButtonStyle}" HorizontalAlignment="Stretch" Click="OnActivateBalancedClick" />
                        </StackPanel>
                    </Border>

                    <!-- High Performance Card -->
                    <Border
                        x:Name="CardHighPerf"
                        Grid.Column="1"
                        Padding="16,14"
                        CornerRadius="8"
                        Background="{ThemeResource GwCardBackgroundBrush}"
                        BorderBrush="{ThemeResource GwCardBorderBrush}"
                        BorderThickness="1">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE7E8;" FontSize="20" Foreground="{ThemeResource GwAmberBrush}" />
                                <TextBlock Text="High Performance" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <Border Padding="6,2" CornerRadius="4" Background="{ThemeResource GwAmberBgBrush}" HorizontalAlignment="Left">
                                <TextBlock Text="Maximum Responsiveness" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource GwAmberBrush}" />
                            </Border>
                            <TextBlock Text="Favors maximum clock frequencies and disables deep C-state sleep timeouts." FontSize="11" Foreground="{ThemeResource GwTextSecondaryBrush}" TextWrapping="Wrap" />
                            <StackPanel Spacing="4">
                                <TextBlock Text="• Lowest latency under load" FontSize="10" Foreground="{ThemeResource GwTextMutedBrush}" />
                                <TextBlock Text="• Higher power usage on laptops" FontSize="10" Foreground="{ThemeResource GwTextMutedBrush}" />
                            </StackPanel>
                            <Button x:Name="BtnActivateHighPerf" Content="Set Active" Style="{StaticResource GwSecondaryButtonStyle}" HorizontalAlignment="Stretch" Click="OnActivateHighPerfClick" />
                        </StackPanel>
                    </Border>

                    <!-- Power Saver Card -->
                    <Border
                        x:Name="CardPowerSaver"
                        Grid.Column="2"
                        Padding="16,14"
                        CornerRadius="8"
                        Background="{ThemeResource GwCardBackgroundBrush}"
                        BorderBrush="{ThemeResource GwCardBorderBrush}"
                        BorderThickness="1">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xEC0A;" FontSize="20" Foreground="{ThemeResource GwSignalGreenBrush}" />
                                <TextBlock Text="Power Saver" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <Border Padding="6,2" CornerRadius="4" Background="{ThemeResource GwSignalGreenBgBrush}" HorizontalAlignment="Left">
                                <TextBlock Text="Battery &amp; Thermal Saver" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource GwSignalGreenBrush}" />
                            </Border>
                            <TextBlock Text="Reduces processor clock ceiling and quickly enters low-power device states." FontSize="11" Foreground="{ThemeResource GwTextSecondaryBrush}" TextWrapping="Wrap" />
                            <StackPanel Spacing="4">
                                <TextBlock Text="• Extended laptop battery life" FontSize="10" Foreground="{ThemeResource GwTextMutedBrush}" />
                                <TextBlock Text="• Lower thermal output" FontSize="10" Foreground="{ThemeResource GwTextMutedBrush}" />
                            </StackPanel>
                            <Button x:Name="BtnActivatePowerSaver" Content="Set Active" Style="{StaticResource GwSecondaryButtonStyle}" HorizontalAlignment="Stretch" Click="OnActivatePowerSaverClick" />
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- ======================================================== -->
        <!-- SUB-VIEW 3: WINDOWS SETTINGS -->
        <!-- ======================================================== -->
        <ScrollViewer x:Name="SubViewSettings" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="14">
                <Border Padding="16,14" CornerRadius="8" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Windows Performance &amp; Privacy Tuning" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" />
                        <TextBlock Text="Audited system toggles for Game Mode, visual effects, diagnostics telemetry, and privacy." FontSize="12" Foreground="{ThemeResource GwTextSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- Settings List with ToggleSwitches -->
                <ListView x:Name="SettingsListView" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:ConfigurableSettingRowViewModel">
                            <Border Margin="0,3" Padding="14,12" CornerRadius="8" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Spacing="4">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Border Padding="6,2" CornerRadius="4" Background="{ThemeResource GwAccentBgBrush}">
                                                <TextBlock Text="{x:Bind Category}" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource GwAccentBrush}" />
                                            </Border>
                                            <TextBlock Text="{x:Bind DisplayName}" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource GwTextPrimaryBrush}" />
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind Explanation}" FontSize="11" Foreground="{ThemeResource GwTextSecondaryBrush}" TextWrapping="Wrap" />
                                        <TextBlock Text="{x:Bind RecommendationNote}" FontSize="10" Foreground="{ThemeResource GwTextMutedBrush}" />
                                    </StackPanel>

                                    <ToggleSwitch
                                        Grid.Column="1"
                                        IsOn="{x:Bind IsEnabled}"
                                        Tag="{x:Bind SettingId}"
                                        Toggled="OnConfigurableSettingToggled"
                                        VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </ScrollViewer>

    </Grid>
</Page>
