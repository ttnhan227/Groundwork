<Page
    x:Class="Groundwork.Desktop.Views.ApplicationsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Groundwork.Desktop">

    <Grid Padding="24,18">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="900" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="CompactState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="AppsListPane.(Grid.Column)" Value="0" />
                        <Setter Target="AppsListPane.(Grid.Row)" Value="0" />
                        <Setter Target="AppsListPane.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="AppDetailsPane.(Grid.Column)" Value="0" />
                        <Setter Target="AppDetailsPane.(Grid.Row)" Value="1" />
                        <Setter Target="AppDetailsPane.(Grid.ColumnSpan)" Value="2" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid MaxWidth="1320" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- TOP PAGE HEADER & NATIVE UNDERLINE TAB STRIP -->
            <Border Grid.Row="0" Margin="0,0,0,16" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="TabInstalledAppsBtn" Content="Installed Software" Style="{StaticResource GwUnderlineTabActiveStyle}" Click="OnTabInstalledAppsClick" />
                        <Button x:Name="TabBloatwareBtn" Content="Store Bloatware (UWP)" Style="{StaticResource GwUnderlineTabStyle}" Click="OnTabBloatwareClick" />
                        <Button x:Name="TabEssentialToolsBtn" Content="Essential Tools (winget)" Style="{StaticResource GwUnderlineTabStyle}" Click="OnTabEssentialToolsClick" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 1. INSTALLED SOFTWARE -->
            <Grid x:Name="SubViewInstalledApps" Grid.Row="1" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- UNIFIED COMMAND TOOLBAR -->
                <Grid Grid.Row="0" Margin="0,0,0,12" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="240" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="1" VerticalAlignment="Center">
                        <TextBlock Text="Installed Software" FontSize="17" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" />
                        <TextBlock x:Name="AppsSummaryCountText" Text="Loading installed programs..." FontSize="12" Foreground="{ThemeResource GwTextSecondaryBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Button x:Name="SortBySizeBtn" Content="Largest" Style="{StaticResource GwPrimaryButtonStyle}" Click="OnSortBySizeClick" />
                        <Button x:Name="SortByNameBtn" Content="A–Z" Style="{StaticResource GwSecondaryButtonStyle}" Click="OnSortByNameClick" />
                    </StackPanel>
                    <TextBox
                        Grid.Column="2"
                        x:Name="AppSearchBox"
                        PlaceholderText="Filter by app or publisher..."
                        TextChanged="OnAppSearchTextChanged"
                        VerticalAlignment="Center" />
                    <Button Grid.Column="3" Content="Refresh" Style="{StaticResource GwSecondaryButtonStyle}" Click="OnRefreshAppsClick" VerticalAlignment="Center" />
                </Grid>

                <!-- MASTER / DETAIL SPLIT -->
                <Grid Grid.Row="1" ColumnSpacing="14" RowSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1.25*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- LEFT: CLEAN DATA TABLE OF INSTALLED APPS -->
                    <Border x:Name="AppsListPane" Grid.Column="0" Grid.Row="0" CornerRadius="6" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Column Header -->
                            <Grid Grid.Row="0" Padding="14,8" Background="{ThemeResource GwSubtleSurfaceBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="0,0,0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="80" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="APPLICATION" Style="{StaticResource GwTableColumnHeaderStyle}" />
                                <TextBlock Grid.Column="1" Text="SIZE" Style="{StaticResource GwTableColumnHeaderStyle}" HorizontalAlignment="Right" />
                            </Grid>

                            <ListView
                                Grid.Row="1"
                                x:Name="InstalledAppsListView"
                                SelectionMode="Single"
                                SelectionChanged="OnAppSelectionChanged">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:InstalledAppRowViewModel">
                                        <Border Padding="14,9" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="0,0,0,1">
                                            <Grid ColumnSpacing="11">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="30" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Border Width="30" Height="30" CornerRadius="5" Background="{ThemeResource GwSubtleSurfaceBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1" VerticalAlignment="Center">
                                                    <Grid>
                                                        <FontIcon Glyph="&#xE71D;" FontSize="14" Foreground="{ThemeResource GwAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        <Image Source="{x:Bind AppIcon}" Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Grid>
                                                </Border>

                                                <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="12.5" Foreground="{ThemeResource GwTextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{x:Bind Publisher}" FontSize="11" Foreground="{ThemeResource GwTextMutedBrush}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>

                                                <TextBlock Grid.Column="2" Text="{x:Bind FormattedSize}" FontSize="12" FontWeight="Medium" Foreground="{ThemeResource GwTextSecondaryBrush}" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>

                    <!-- RIGHT: INSPECTOR & TRACE CLEANER -->
                    <Border x:Name="AppDetailsPane" Grid.Column="1" Grid.Row="0" Padding="20,18" CornerRadius="6" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                        <Grid>
                            <!-- Summary Placeholder when no app picked -->
                            <StackPanel x:Name="NoAppSelectedDashboard" Visibility="Visible" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="14" MaxWidth="420">
                                <Border Width="44" Height="44" CornerRadius="6" Background="{ThemeResource GwAccentBgBrush}" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE71D;" FontSize="20" Foreground="{ThemeResource GwAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <TextBlock Text="Select an Application to Inspect or Cleanly Uninstall" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" HorizontalAlignment="Center" TextAlignment="Center" />

                                <Border Padding="16,12" CornerRadius="6" Background="{ThemeResource GwSubtleSurfaceBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                                    <StackPanel Spacing="8">
                                        <Grid ColumnSpacing="12">
                                            <TextBlock Text="Installed Programs" FontSize="12" Foreground="{ThemeResource GwTextSecondaryBrush}" />
                                            <TextBlock x:Name="TotalAppsStatText" Text="..." FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" HorizontalAlignment="Right" />
                                        </Grid>
                                        <Grid ColumnSpacing="12">
                                            <TextBlock Text="Estimated Footprints" FontSize="12" Foreground="{ThemeResource GwTextSecondaryBrush}" />
                                            <TextBlock x:Name="TotalSpaceStatText" Text="..." FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource GwAccentBrush}" HorizontalAlignment="Right" />
                                        </Grid>
                                        <Grid ColumnSpacing="12">
                                            <TextBlock Text="Largest Application" FontSize="12" Foreground="{ThemeResource GwTextSecondaryBrush}" />
                                            <TextBlock x:Name="LargestAppStatText" Text="..." FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" MaxWidth="220" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <TextBlock
                                    Text="Guided Uninstall runs the app's official uninstaller first, then lets you choose Safe, Moderate, or Advanced scanning mode to remove leftover folders and registry traces."
                                    FontSize="12"
                                    Foreground="{ThemeResource GwTextMutedBrush}"
                                    TextWrapping="Wrap"
                                    TextAlignment="Center" />
                            </StackPanel>

                            <!-- Selected App Inspector -->
                            <Grid x:Name="SelectedAppDetailsPanel" Visibility="Collapsed" RowSpacing="14">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- Title & Identity -->
                                <Grid Grid.Row="0" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="42" Height="42" CornerRadius="6" Background="{ThemeResource GwSubtleSurfaceBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                                        <FontIcon Glyph="&#xE71D;" FontSize="18" Foreground="{ThemeResource GwAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock x:Name="SelectedAppNameText" Text="App Name" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Name="SelectedAppPublisherText" Text="Publisher • Version" FontSize="12" Foreground="{ThemeResource GwTextSecondaryBrush}" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="Guided Uninstall..." Style="{StaticResource GwDangerButtonStyle}" Click="OnUninstallAppClick" VerticalAlignment="Center" />
                                </Grid>

                                <!-- Structured Key-Value Properties Table -->
                                <Border Grid.Row="1" CornerRadius="6" Background="{ThemeResource GwSubtleSurfaceBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                                    <StackPanel>
                                        <Grid Padding="12,8" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="0,0,0,1" ColumnSpacing="12">
                                            <TextBlock Text="Install Directory" FontSize="12" Foreground="{ThemeResource GwTextMutedBrush}" VerticalAlignment="Center" />
                                            <TextBlock x:Name="SelectedAppLocationText" Text="..." FontSize="12" Foreground="{ThemeResource GwTextPrimaryBrush}" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" MaxWidth="360" VerticalAlignment="Center" />
                                        </Grid>
                                        <Grid Padding="12,8" ColumnSpacing="12">
                                            <TextBlock Text="Reported Size" FontSize="12" Foreground="{ThemeResource GwTextMutedBrush}" VerticalAlignment="Center" />
                                            <TextBlock x:Name="SelectedAppSizeText" Text="..." FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Inline Trace Scanner Bar (with Safe / Moderate / Advanced selector) -->
                                <Grid Grid.Row="2" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Leftover Files &amp; Registry Traces" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1" x:Name="InlineScanDepthCombo" SelectedIndex="1" MinWidth="128" VerticalAlignment="Center">
                                        <ComboBoxItem Content="Safe Scan" Tag="Safe" />
                                        <ComboBoxItem Content="Moderate Scan" Tag="Moderate" />
                                        <ComboBoxItem Content="Advanced (All)" Tag="Advanced" />
                                    </ComboBox>
                                    <Button Grid.Column="2" Content="Scan Traces" Style="{StaticResource GwSecondaryButtonStyle}" Click="OnScanLeftoversClick" VerticalAlignment="Center" />
                                    <Button Grid.Column="3" x:Name="CleanLeftoversBtn" Content="Clean Selected" Style="{StaticResource GwPrimaryButtonStyle}" IsEnabled="False" Click="OnCleanLeftoversClick" VerticalAlignment="Center" />
                                </Grid>

                                <!-- Hairline Trace Table -->
                                <Border Grid.Row="3" CornerRadius="6" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1" Background="{ThemeResource GwCardBackgroundBrush}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0" Padding="10,7" Background="{ThemeResource GwSubtleSurfaceBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="0,0,0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="75" />
                                                <ColumnDefinition Width="58" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="1" Text="TRACE ITEM &amp; PATH" Style="{StaticResource GwTableColumnHeaderStyle}" />
                                            <TextBlock Grid.Column="2" Text="SCOPE" Style="{StaticResource GwTableColumnHeaderStyle}" />
                                            <TextBlock Grid.Column="3" Text="SIZE" Style="{StaticResource GwTableColumnHeaderStyle}" HorizontalAlignment="Right" />
                                        </Grid>

                                        <TextBlock x:Name="NoTracesHintText" Grid.Row="1" Text="Click 'Scan Traces' (or 'Guided Uninstall...') to inspect leftover folders and registry keys." FontSize="12" Foreground="{ThemeResource GwTextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Margin="24" />

                                        <ListView Grid.Row="1" x:Name="LeftoversListView" SelectionMode="None">
                                            <ListView.ItemTemplate>
                                                <DataTemplate x:DataType="local:LeftoverItemRowViewModel">
                                                    <Border Padding="10,7" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="0,0,0,1">
                                                        <Grid ColumnSpacing="8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="24" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="120" />
                                                                <ColumnDefinition Width="75" />
                                                                <ColumnDefinition Width="58" />
                                                            </Grid.ColumnDefinitions>
                                                            <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}" MinWidth="0" VerticalAlignment="Center" />
                                                            <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                                                <TextBlock Text="{x:Bind Name}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{x:Bind FullPath}" FontSize="10.5" Foreground="{ThemeResource GwTextMutedBrush}" TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="2" Text="{x:Bind KindBadge}" FontSize="11" Foreground="{ThemeResource GwTextSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Grid.Column="3" Text="{x:Bind FormattedSize}" FontSize="11.5" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                            <Button Grid.Column="4" Content="Open" Tag="{x:Bind FullPath}" Visibility="{x:Bind OpenButtonVisibility}" Style="{StaticResource GwCompactButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="OnOpenLeftoverClick" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- 2. STORE BLOATWARE (UWP) -->
            <Grid x:Name="SubViewBloatware" Grid.Row="1" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10" ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="1">
                        <TextBlock Text="Preinstalled Windows Store Bloatware" FontSize="17" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" />
                        <TextBlock x:Name="BloatwareSummaryText" Text="Remove unwanted Store apps Windows Settings hides, while keeping core Store &amp; system frameworks protected." FontSize="12" Foreground="{ThemeResource GwTextSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Content="Select Bloat" Style="{StaticResource GwSecondaryButtonStyle}" Click="OnSelectBloatwareClick" />
                        <Button Content="Remove Selected" Style="{StaticResource GwDangerButtonStyle}" Click="OnRemoveSelectedAppxClick" />
                        <Button Content="Scan Store Apps" Style="{StaticResource GwPrimaryButtonStyle}" Click="OnRefreshBloatwareClick" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="0,0,0,12" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Button x:Name="BloatFilterSuggestedBtn" Content="Suggested Bloat" Tag="bloat" Style="{StaticResource GwPrimaryButtonStyle}" Click="OnBloatFilterClick" />
                        <Button x:Name="BloatFilterRemovableBtn" Content="All Removable" Tag="removable" Style="{StaticResource GwSecondaryButtonStyle}" Click="OnBloatFilterClick" />
                        <Button x:Name="BloatFilterAllBtn" Content="Include Protected" Tag="all" Style="{StaticResource GwSecondaryButtonStyle}" Click="OnBloatFilterClick" />
                    </StackPanel>
                    <TextBox Grid.Column="1" x:Name="BloatSearchBox" PlaceholderText="Filter Store packages..." TextChanged="OnBloatSearchChanged" VerticalAlignment="Center" />
                </Grid>

                <Border Grid.Row="2" CornerRadius="6" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Padding="14,8" Background="{ThemeResource GwSubtleSurfaceBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="0,0,0,1" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="90" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1" Text="STORE PACKAGE &amp; DESCRIPTION" Style="{StaticResource GwTableColumnHeaderStyle}" />
                            <TextBlock Grid.Column="2" Text="CLASSIFICATION" Style="{StaticResource GwTableColumnHeaderStyle}" />
                            <TextBlock Grid.Column="3" Text="ACTION" Style="{StaticResource GwTableColumnHeaderStyle}" HorizontalAlignment="Right" />
                        </Grid>

                        <TextBlock x:Name="BloatEmptyBanner" Grid.Row="1" Text="No packages matched the current filter. Try switching to 'All Removable'." Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" Foreground="{ThemeResource GwTextMutedBrush}" TextWrapping="Wrap" />

                        <ListView Grid.Row="1" x:Name="BloatwareListView" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:AppxPackageRowViewModel">
                                    <Border Padding="14,9" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="0,0,0,1">
                                        <Grid ColumnSpacing="14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="90" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}" IsEnabled="{x:Bind CanRemove}" MinWidth="0" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource GwTextPrimaryBrush}" />
                                                <TextBlock Text="{x:Bind SubtitleLine}" FontSize="11.5" Foreground="{ThemeResource GwTextSecondaryBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Border Grid.Column="2" Padding="8,2" CornerRadius="4" Background="{ThemeResource GwAccentBgBrush}" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Classification}" FontSize="10.5" FontWeight="SemiBold" Foreground="{ThemeResource GwAccentBrush}" />
                                            </Border>
                                            <Button Grid.Column="3" Content="Remove" Tag="{x:Bind PackageFullName}" IsEnabled="{x:Bind CanRemove}" Style="{StaticResource GwCompactButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="OnRemoveAppxClick" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
            </Grid>

            <!-- 3. ESSENTIAL TOOLS & RUNTIMES (WINGET) -->
            <Grid x:Name="SubViewEssentialTools" Grid.Row="1" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,12" ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="1">
                        <TextBlock Text="Essential Runtimes &amp; Clean Utilities (winget)" FontSize="17" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" />
                        <TextBlock Text="Select multiple missing tools and batch-install them cleanly from Microsoft's official winget repository." FontSize="12" Foreground="{ThemeResource GwTextSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Content="Select Missing" Style="{StaticResource GwSecondaryButtonStyle}" Click="OnSelectMissingToolsClick" />
                        <Button Content="Install Selected" Style="{StaticResource GwPrimaryButtonStyle}" Click="OnInstallSelectedToolsClick" />
                        <Button Content="Refresh" Style="{StaticResource GwSecondaryButtonStyle}" Click="OnRefreshEssentialToolsClick" />
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" CornerRadius="6" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Padding="14,8" Background="{ThemeResource GwSubtleSurfaceBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="0,0,0,1" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="130" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1" Text="PACKAGE &amp; DESCRIPTION" Style="{StaticResource GwTableColumnHeaderStyle}" />
                            <TextBlock Grid.Column="2" Text="STATUS" Style="{StaticResource GwTableColumnHeaderStyle}" />
                            <TextBlock Grid.Column="3" Text="ACTION" Style="{StaticResource GwTableColumnHeaderStyle}" HorizontalAlignment="Right" />
                        </Grid>

                        <ListView Grid.Row="1" x:Name="EssentialToolsListView" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:EssentialToolRowViewModel">
                                    <Border Padding="14,9" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="0,0,0,1">
                                        <Grid ColumnSpacing="14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="130" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}" MinWidth="0" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Border Padding="6,1" CornerRadius="3" Background="{ThemeResource GwAccentBgBrush}">
                                                        <TextBlock Text="{x:Bind Category}" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource GwAccentBrush}" />
                                                    </Border>
                                                    <TextBlock Text="{x:Bind DisplayName}" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource GwTextPrimaryBrush}" />
                                                </StackPanel>
                                                <TextBlock Text="{x:Bind Description}" FontSize="12" Foreground="{ThemeResource GwTextSecondaryBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{x:Bind InstalledVersionDisplay}" FontSize="11.5" FontWeight="Medium" Foreground="{ThemeResource GwTextSecondaryBrush}" VerticalAlignment="Center" />
                                            <Button Grid.Column="3" Content="{x:Bind ActionButtonText}" Tag="{x:Bind WingetId}" Style="{StaticResource GwCompactButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="OnInstallEssentialToolClick" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>
