<Page
    x:Class="Groundwork.Desktop.Views.ApplicationsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Groundwork.Desktop">

    <Grid Padding="20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Header & Search Bar -->
        <Border Grid.Row="0" Margin="0,0,0,14" Padding="14,10" CornerRadius="8" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="280" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="Installed Applications &amp; Clean Uninstaller" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" />
                    <TextBlock x:Name="AppsSummaryCountText" Text="Enumerating Win32 and Windows Store software..." FontSize="11" Foreground="{ThemeResource GwTextSecondaryBrush}" />
                </StackPanel>
                <TextBox
                    Grid.Column="1"
                    x:Name="AppSearchBox"
                    PlaceholderText="Search applications or publishers..."
                    TextChanged="OnAppSearchTextChanged"
                    VerticalAlignment="Center" />
                <Button Grid.Column="2" Content="Refresh" Style="{StaticResource GwSecondaryButtonStyle}" Click="OnRefreshAppsClick" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Two-Pane Layout: Left List (50%), Right Details & Leftovers (50%) -->
        <Grid Grid.Row="1" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- LEFT PANE: INSTALLED APPS LIST -->
            <Border Grid.Column="0" CornerRadius="8" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                <ListView
                    x:Name="InstalledAppsListView"
                    SelectionMode="Single"
                    SelectionChanged="OnAppSelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:InstalledAppRowViewModel">
                            <Border Margin="0,2" Padding="12,10" CornerRadius="6" Background="{ThemeResource GwCardBackgroundHoverBrush}">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- App Glyph / Icon -->
                                    <Border Width="34" Height="34" CornerRadius="6" Background="{ThemeResource GwAccentBgBrush}" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE71D;" FontSize="16" Foreground="{ThemeResource GwAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>

                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource GwTextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind Publisher}" FontSize="10" Foreground="{ThemeResource GwTextMutedBrush}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="2" Text="{x:Bind FormattedSize}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource GwTextSecondaryBrush}" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

            <!-- RIGHT PANE: APP SUMMARY DASHBOARD (When None Selected) OR LEFTOVER CLEANER -->
            <Border Grid.Column="1" Padding="16,14" CornerRadius="8" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                <Grid>
                    <!-- 1. Engaging Right-Pane Empty State (Solves the 50% empty void defect!) -->
                    <Border x:Name="NoAppSelectedDashboard" Visibility="Visible" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="20">
                        <StackPanel Spacing="14" HorizontalAlignment="Center">
                            <Border Width="48" Height="48" CornerRadius="24" Background="{ThemeResource GwAccentBgBrush}" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE71D;" FontSize="22" Foreground="{ThemeResource GwAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <TextBlock Text="Software Inventory Overview" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" HorizontalAlignment="Center" />

                            <!-- Quick Stats Card -->
                            <Border Padding="14,12" CornerRadius="8" Background="{ThemeResource GwCardBackgroundHoverBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1" MinWidth="340">
                                <StackPanel Spacing="8">
                                    <Grid>
                                        <TextBlock Text="Total Installed Programs:" FontSize="11" Foreground="{ThemeResource GwTextSecondaryBrush}" />
                                        <TextBlock x:Name="TotalAppsStatText" Text="Calculating..." FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" HorizontalAlignment="Right" />
                                    </Grid>
                                    <Grid>
                                        <TextBlock Text="Total Space Estimated:" FontSize="11" Foreground="{ThemeResource GwTextSecondaryBrush}" />
                                        <TextBlock x:Name="TotalSpaceStatText" Text="Calculating..." FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource GwAccentBrush}" HorizontalAlignment="Right" />
                                    </Grid>
                                    <Grid>
                                        <TextBlock Text="Largest Installed App:" FontSize="11" Foreground="{ThemeResource GwTextSecondaryBrush}" />
                                        <TextBlock x:Name="LargestAppStatText" Text="Calculating..." FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" MaxWidth="180" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <TextBlock
                                Text="Select an application on the left to view installation details, registry footprints, launch the native uninstaller, and scan for leftover traces."
                                FontSize="11"
                                Foreground="{ThemeResource GwTextMutedBrush}"
                                TextWrapping="Wrap"
                                TextAlignment="Center"
                                MaxWidth="360" />
                        </StackPanel>
                    </Border>

                    <!-- 2. Selected App Details & Leftovers Inspector -->
                    <ScrollViewer x:Name="SelectedAppDetailsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="14">
                            <!-- App Header -->
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="44" Height="44" CornerRadius="8" Background="{ThemeResource GwAccentBgBrush}">
                                    <FontIcon Glyph="&#xE71D;" FontSize="22" Foreground="{ThemeResource GwAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock x:Name="SelectedAppNameText" Text="App Name" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" />
                                    <TextBlock x:Name="SelectedAppPublisherText" Text="Publisher • Version" FontSize="11" Foreground="{ThemeResource GwTextSecondaryBrush}" />
                                </StackPanel>
                            </Grid>

                            <!-- Metadata Specs -->
                            <Border Padding="12,10" CornerRadius="6" Background="{ThemeResource GwCardBackgroundHoverBrush}">
                                <StackPanel Spacing="6">
                                    <Grid>
                                        <TextBlock Text="Install Location:" FontSize="10" Foreground="{ThemeResource GwTextMutedBrush}" />
                                        <TextBlock x:Name="SelectedAppLocationText" Text="C:\Program Files\..." FontSize="10" Foreground="{ThemeResource GwTextSecondaryBrush}" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" MaxWidth="240" />
                                    </Grid>
                                    <Grid>
                                        <TextBlock Text="Estimated Size:" FontSize="10" Foreground="{ThemeResource GwTextMutedBrush}" />
                                        <TextBlock x:Name="SelectedAppSizeText" Text="120 MB" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" HorizontalAlignment="Right" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Uninstall Action Buttons -->
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button Content="Launch Native Uninstaller" Style="{StaticResource GwDangerButtonStyle}" Click="OnUninstallAppClick" />
                                <Button Content="Scan for Leftovers" Style="{StaticResource GwSecondaryButtonStyle}" Click="OnScanLeftoversClick" />
                            </StackPanel>

                            <!-- Leftovers List -->
                            <TextBlock Text="Discovered Leftover Files &amp; Registry Keys" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" Margin="0,6,0,0" />
                            <ListView x:Name="LeftoversListView" MaxHeight="220" SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:LeftoverItemRowViewModel">
                                        <Border Margin="0,2" Padding="8,6" CornerRadius="4" Background="{ThemeResource GwCardBackgroundHoverBrush}">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="{x:Bind Name}" FontSize="11" FontWeight="Medium" Foreground="{ThemeResource GwTextPrimaryBrush}" />
                                                    <TextBlock Text="{x:Bind FullPath}" FontSize="9" Foreground="{ThemeResource GwTextMutedBrush}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{x:Bind FormattedSize}" FontSize="10" Foreground="{ThemeResource GwTextSecondaryBrush}" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
