<Page
    x:Class="Groundwork.Desktop.Views.StoragePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Groundwork.Desktop">

    <Grid Padding="20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- TOP SUB-NAVIGATION SEGMENTS -->
        <Border Grid.Row="0" Margin="0,0,0,14" Padding="4" CornerRadius="8" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal" Spacing="4">
                <Button x:Name="TabAnalyzerBtn" Content="Space Analyzer" Style="{StaticResource GwPrimaryButtonStyle}" Click="OnTabAnalyzerClick" />
                <Button x:Name="TabCleanerBtn" Content="Junk &amp; Cache Cleaner" Style="{StaticResource GwSecondaryButtonStyle}" Click="OnTabCleanerClick" />
                <Button x:Name="TabOrganizerBtn" Content="Smart File Organizer" Style="{StaticResource GwSecondaryButtonStyle}" Click="OnTabOrganizerClick" />
                <Button x:Name="TabDuplicatesBtn" Content="Duplicate Finder" Style="{StaticResource GwSecondaryButtonStyle}" Click="OnTabDuplicatesClick" />
            </StackPanel>
        </Border>

        <!-- ======================================================== -->
        <!-- SUB-VIEW 1: SPACE ANALYZER -->
        <!-- ======================================================== -->
        <Grid x:Name="SubViewAnalyzer" Grid.Row="1" Visibility="Visible">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Clean 3-Element Unified Toolbar -->
            <Border Grid.Row="0" Margin="0,0,0,12" Padding="14,10" CornerRadius="8" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Unified Drive Selector -->
                    <ComboBox
                        x:Name="DrivesSelectorCombo"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        SelectionChanged="OnDriveSelectionChanged"
                        PlaceholderText="Select local volume or folder to analyze..." />

                    <!-- Scan Button -->
                    <Button
                        Grid.Column="1"
                        x:Name="ScanDriveBtn"
                        Content="Scan Drive"
                        Style="{StaticResource GwPrimaryButtonStyle}"
                        Click="OnScanCurrentTargetClick" />

                    <!-- Browse Folder Button -->
                    <Button
                        Grid.Column="2"
                        Content="Browse Folder..."
                        Style="{StaticResource GwSecondaryButtonStyle}"
                        Click="OnBrowseCustomFolderClick" />

                    <!-- Cancel Scan Button -->
                    <Button
                        Grid.Column="3"
                        x:Name="CancelScanBtn"
                        Content="Cancel"
                        Visibility="Collapsed"
                        Style="{StaticResource GwDangerButtonStyle}"
                        Click="OnCancelScanClick" />
                </Grid>
            </Border>

            <!-- Visual Capacity Bar & Proportional Breakdown -->
            <Border Grid.Row="1" Margin="0,0,0,12" Padding="14,12" CornerRadius="8" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                <StackPanel Spacing="8">
                    <Grid>
                        <TextBlock x:Name="StorageSummaryHeader" Text="Storage Distribution" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" />
                        <TextBlock x:Name="StorageScannedCountText" Text="Select a drive and click Scan." FontSize="11" Foreground="{ThemeResource GwTextSecondaryBrush}" HorizontalAlignment="Right" />
                    </Grid>

                    <!-- Segmented Proportional Bar -->
                    <ProgressBar x:Name="ProportionalBar" Value="0" Maximum="100" Height="8" CornerRadius="4" Foreground="{ThemeResource GwAccentBrush}" />

                    <!-- Category Pills Legend -->
                    <ItemsControl x:Name="BreakdownLegendControl">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="12" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:StorageBarSegmentViewModel">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Border Width="10" Height="10" CornerRadius="2" Background="{ThemeResource GwAccentBrush}" />
                                    <TextBlock Text="{x:Bind Name}" FontSize="11" Foreground="{ThemeResource GwTextPrimaryBrush}" />
                                    <TextBlock Text="{x:Bind FormattedSize}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource GwTextSecondaryBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Results View: Hierarchical Folder Tree & Largest Files -->
            <Border Grid.Row="2" CornerRadius="8" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                <Grid>
                    <!-- Empty State -->
                    <Border x:Name="AnalyzerEmptyState" Padding="32" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel Spacing="10" HorizontalAlignment="Center">
                            <Border Width="48" Height="48" CornerRadius="24" Background="{ThemeResource GwAccentBgBrush}" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xEDA2;" FontSize="22" Foreground="{ThemeResource GwAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Ready to Analyze Storage" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="Choose a volume above and click Scan Drive to visualize space hogs, folder sizes, and disk usage." FontSize="12" Foreground="{ThemeResource GwTextSecondaryBrush}" TextAlignment="Center" MaxWidth="440" />
                        </StackPanel>
                    </Border>

                    <!-- Tree & Files Table -->
                    <ListView x:Name="FolderTreeListView" Visibility="Collapsed" SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:StorageTreeNodeViewModel">
                                <Border Margin="0,1" Padding="10,6" CornerRadius="4" Background="{ThemeResource GwCardBackgroundHoverBrush}">
                                    <Grid ColumnSpacing="12" Margin="{x:Bind IndentThickness}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Expander Button -->
                                        <Button
                                            Visibility="{x:Bind HasChildrenVisibility}"
                                            Content="{x:Bind ExpanderGlyph}"
                                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                                            Padding="4"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Click="OnFolderExpanderClick" />

                                        <!-- Folder / File Icon -->
                                        <FontIcon Grid.Column="1" Glyph="{x:Bind NodeGlyph}" FontSize="14" Foreground="{ThemeResource GwAccentBrush}" VerticalAlignment="Center" />

                                        <!-- Name & Subtitle -->
                                        <TextBlock Grid.Column="2" Text="{x:Bind Name}" FontWeight="Medium" FontSize="12" Foreground="{ThemeResource GwTextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                                        <!-- Proportional Bar / Percentage -->
                                        <TextBlock Grid.Column="3" Text="{x:Bind PercentOfParentLabel}" FontSize="11" Foreground="{ThemeResource GwTextMutedBrush}" VerticalAlignment="Center" />

                                        <!-- Size -->
                                        <TextBlock Grid.Column="4" Text="{x:Bind FormattedSize}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />

                                        <!-- Reveal in Explorer Button -->
                                        <Button Grid.Column="5" Content="Reveal" Tag="{x:Bind FullPath}" Style="{StaticResource GwCompactButtonStyle}" Click="OnRevealInExplorerClick" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>

        <!-- ======================================================== -->
        <!-- SUB-VIEW 2: JUNK & CACHE CLEANER -->
        <!-- ======================================================== -->
        <ScrollViewer x:Name="SubViewCleaner" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="14">
                <!-- Summary Card -->
                <Border Padding="16,14" CornerRadius="8" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock Text="System Storage Sense &amp; Junk Cleaner" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" />
                            <TextBlock x:Name="CleanerReclaimableSummaryText" Text="Scan to identify safe temporary caches, crash dumps, and recyclable files." FontSize="12" Foreground="{ThemeResource GwTextSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button Content="Scan Junk" Style="{StaticResource GwSecondaryButtonStyle}" Click="OnScanJunkClick" />
                            <Button x:Name="ExecuteCleanBtn" Content="Clean Selected Files" Style="{StaticResource GwPrimaryButtonStyle}" Click="OnExecuteCleanClick" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Active Categories With Reclaimable Space -->
                <TextBlock Text="Reclaimable Categories" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" />
                <ItemsControl x:Name="CleanerActiveCategoriesControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:StorageSenseCategoryCardViewModel">
                            <Border Margin="0,4" Padding="14,12" CornerRadius="8" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}" VerticalAlignment="Center" />

                                    <Border Grid.Column="1" Width="36" Height="36" CornerRadius="8" Background="{ThemeResource GwAccentBgBrush}">
                                        <FontIcon Glyph="{x:Bind Glyph}" FontSize="18" Foreground="{ThemeResource GwAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>

                                    <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource GwTextPrimaryBrush}" />
                                        <TextBlock Text="{x:Bind Description}" FontSize="11" Foreground="{ThemeResource GwTextSecondaryBrush}" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="3" Text="{x:Bind FormattedSize}" FontSize="14" FontWeight="Bold" Foreground="{ThemeResource GwAccentBrush}" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Collapsed Clean Categories Summary Row (No 0 B clutter!) -->
                <Border
                    x:Name="CleanCategoriesSummaryBorder"
                    Padding="14,10"
                    CornerRadius="8"
                    Background="{ThemeResource GwSignalGreenBgBrush}"
                    BorderBrush="{ThemeResource GwSignalGreenBrush}"
                    BorderThickness="1"
                    Visibility="Visible">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE73E;" FontSize="14" Foreground="{ThemeResource GwSignalGreenBrush}" VerticalAlignment="Center" />
                        <TextBlock x:Name="CleanCategoriesSummaryText" Text="✓ Clean Categories — No Action Needed" FontSize="12" FontWeight="Medium" Foreground="{ThemeResource GwSignalGreenBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ======================================================== -->
        <!-- SUB-VIEW 3: SMART FILE ORGANIZER -->
        <!-- ======================================================== -->
        <ScrollViewer x:Name="SubViewOrganizer" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="14">
                <Border Padding="16,14" CornerRadius="8" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Smart Folder Organizer" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" />
                        <TextBlock Text="Categorizes cluttered folders (e.g. Downloads or Desktop) into organized subfolders with instant one-click Undo rollback." FontSize="12" Foreground="{ThemeResource GwTextSecondaryBrush}" />

                        <!-- Quick Folder Presets -->
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Quick Presets:" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource GwTextSecondaryBrush}" VerticalAlignment="Center" />
                            <Button Content="📂 Downloads" Style="{StaticResource GwCompactButtonStyle}" Click="OnPresetDownloadsClick" />
                            <Button Content="🖥️ Desktop" Style="{StaticResource GwCompactButtonStyle}" Click="OnPresetDesktopClick" />
                            <Button Content="📁 Documents" Style="{StaticResource GwCompactButtonStyle}" Click="OnPresetDocumentsClick" />
                            <Button Content="Browse..." Style="{StaticResource GwCompactButtonStyle}" Click="OnBrowseOrganizerFolderClick" />
                        </StackPanel>

                        <!-- Input Path & Actions -->
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="OrganizerFolderBox" x:FieldModifier="public" PlaceholderText="Folder to preview and organize..." VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="Generate Plan Preview" Style="{StaticResource GwSecondaryButtonStyle}" Click="OnPreviewOrganizeClick" />
                            <Button Grid.Column="2" x:Name="ExecuteOrganizeBtn" Content="Execute Organization" Style="{StaticResource GwPrimaryButtonStyle}" IsEnabled="False" Click="OnExecuteOrganizeClick" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Plan Preview Table -->
                <Border Padding="16,14" CornerRadius="8" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Organization Plan Preview" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" />
                        <ListView x:Name="OrganizerPlanListView" MaxHeight="300" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:OrganizationPlanItemViewModel">
                                    <Border Margin="0,2" Padding="10,6" CornerRadius="4" Background="{ThemeResource GwCardBackgroundHoverBrush}">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind FileName}" FontWeight="Medium" FontSize="12" Foreground="{ThemeResource GwTextPrimaryBrush}" />
                                                <TextBlock Text="{x:Bind SourcePath}" FontSize="10" Foreground="{ThemeResource GwTextMutedBrush}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <Border Grid.Column="1" Padding="6,2" CornerRadius="4" Background="{ThemeResource GwAccentBgBrush}" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind TargetSubfolder}" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource GwAccentBrush}" />
                                            </Border>
                                            <TextBlock Grid.Column="2" Text="{x:Bind FormattedSize}" FontSize="11" Foreground="{ThemeResource GwTextSecondaryBrush}" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ======================================================== -->
        <!-- SUB-VIEW 4: DUPLICATE FINDER -->
        <!-- ======================================================== -->
        <ScrollViewer x:Name="SubViewDuplicates" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="14">
                <Border Padding="16,14" CornerRadius="8" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock Text="3-Stage SHA-256 Duplicate File Finder" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" />
                            <TextBlock Text="Group by file size → 4 KB pre-hash → full cryptographic SHA-256 with hard-link protection." FontSize="12" Foreground="{ThemeResource GwTextSecondaryBrush}" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Scan for Duplicates" Style="{StaticResource GwPrimaryButtonStyle}" Click="OnScanDuplicatesClick" />
                    </Grid>
                </Border>

                <!-- Duplicate Groups List -->
                <ListView x:Name="DuplicatesListView" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:DuplicateGroupCardViewModel">
                            <Border Margin="0,4" Padding="14,12" CornerRadius="8" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                                <StackPanel Spacing="6">
                                    <Grid>
                                        <TextBlock Text="{x:Bind SummaryText}" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource GwTextPrimaryBrush}" />
                                        <TextBlock Text="{x:Bind FormattedWaste}" FontWeight="Bold" FontSize="12" Foreground="{ThemeResource GwDangerBrush}" HorizontalAlignment="Right" />
                                    </Grid>
                                    <TextBlock Text="{x:Bind Sha256Short}" FontSize="10" Foreground="{ThemeResource GwTextMutedBrush}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </ScrollViewer>

    </Grid>
</Page>
