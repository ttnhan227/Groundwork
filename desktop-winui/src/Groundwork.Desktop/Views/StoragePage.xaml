<Page
    x:Class="Groundwork.Desktop.Views.StoragePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Groundwork.Desktop">

    <Grid Padding="24,18">
        <Grid MaxWidth="1320" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- TOP NATIVE UNDERLINE TAB STRIP (STORAGE CLEANUP & ORGANIZE) -->
            <Border
                x:Name="StorageSegmentedBar"
                Grid.Row="0"
                Margin="0,0,0,16"
                BorderBrush="{ThemeResource GwCardBorderBrush}"
                BorderThickness="0,0,0,1"
                Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="TabCleanerBtn" Content="Junk Cleaner" Style="{StaticResource GwUnderlineTabActiveStyle}" Click="OnTabCleanerClick" />
                    <Button x:Name="TabOrganizerBtn" Content="Tidy Folder" Style="{StaticResource GwUnderlineTabStyle}" Click="OnTabOrganizerClick" />
                    <Button x:Name="TabDuplicatesBtn" Content="Duplicates" Style="{StaticResource GwUnderlineTabStyle}" Click="OnTabDuplicatesClick" />
                </StackPanel>
            </Border>

            <!-- 1. FILE TREE (WIZTREE-STYLE DISK ANALYZER) -->
            <Grid x:Name="SubViewAnalyzer" Grid.Row="1" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Toolbar -->
                <Grid Grid.Row="0" Margin="0,0,0,10" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ComboBox
                        x:Name="DrivesSelectorCombo"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        SelectionChanged="OnDriveSelectionChanged"
                        PlaceholderText="Select drive or folder..." />

                    <Button Grid.Column="1" x:Name="ScanDriveBtn" Content="Scan" Style="{StaticResource GwPrimaryButtonStyle}" Click="OnScanCurrentTargetClick" />
                    <Button Grid.Column="2" Content="Browse..." Style="{StaticResource GwSecondaryButtonStyle}" Click="OnBrowseCustomFolderClick" />
                    <Button Grid.Column="3" x:Name="CancelScanBtn" Content="Cancel" Visibility="Collapsed" Style="{StaticResource GwDangerButtonStyle}" Click="OnCancelScanClick" />
                </Grid>

                <!-- Summary Strip + Folders / Largest Files Toggle -->
                <Border Grid.Row="1" Margin="0,0,0,10" Padding="14,10" CornerRadius="6" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                    <StackPanel Spacing="8">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="StorageSummaryHeader" Text="Storage Breakdown" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" x:Name="StorageScannedCountText" Text="Select a drive and click Scan." FontSize="12" Foreground="{ThemeResource GwTextSecondaryBrush}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <Button x:Name="ModeFoldersBtn" Content="Folders" Style="{StaticResource GwPrimaryButtonStyle}" Click="OnShowFoldersModeClick" />
                                <Button x:Name="ModeLargestFilesBtn" Content="Largest Files" Style="{StaticResource GwSecondaryButtonStyle}" Click="OnShowLargestFilesModeClick" />
                            </StackPanel>
                        </Grid>

                        <ProgressBar x:Name="ProportionalBar" Value="0" Maximum="100" Height="5" CornerRadius="2" Foreground="{ThemeResource GwAccentBrush}" />

                        <ItemsControl x:Name="BreakdownLegendControl">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="16" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:StorageBarSegmentViewModel">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <Border Width="8" Height="8" CornerRadius="2" Background="{ThemeResource GwAccentBrush}" />
                                        <TextBlock Text="{x:Bind Name}" FontSize="11.5" Foreground="{ThemeResource GwTextPrimaryBrush}" />
                                        <TextBlock Text="{x:Bind FormattedSize}" FontSize="11.5" FontWeight="SemiBold" Foreground="{ThemeResource GwTextSecondaryBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Folder Tree / Largest Files Hairline Data Grid -->
                <Border Grid.Row="2" CornerRadius="6" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Padding="14,7" Background="{ThemeResource GwSubtleSurfaceBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="0,0,0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="95" />
                                <ColumnDefinition Width="72" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="NAME / PATH" Style="{StaticResource GwTableColumnHeaderStyle}" />
                            <TextBlock Grid.Column="1" Text="SHARE" Style="{StaticResource GwTableColumnHeaderStyle}" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="2" Text="SIZE" Style="{StaticResource GwTableColumnHeaderStyle}" HorizontalAlignment="Right" />
                        </Grid>

                        <StackPanel Grid.Row="1" x:Name="AnalyzerEmptyState" Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="32">
                            <Border Width="44" Height="44" CornerRadius="6" Background="{ThemeResource GwAccentBgBrush}" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE8B7;" FontSize="20" Foreground="{ThemeResource GwAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="See what's taking up space" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="Pick a drive above and click Scan to browse folder sizes, nested subdirectories, and largest files." FontSize="12" Foreground="{ThemeResource GwTextSecondaryBrush}" TextAlignment="Center" MaxWidth="380" />
                            <Button Content="Scan Selected Drive" Style="{StaticResource GwPrimaryButtonStyle}" HorizontalAlignment="Center" Margin="0,4,0,0" Click="OnScanCurrentTargetClick" />
                        </StackPanel>

                        <ListView Grid.Row="1" x:Name="FolderTreeListView" Visibility="Collapsed" SelectionMode="Single">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:StorageTreeNodeViewModel">
                                    <Border Padding="12,6" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="0,0,0,1">
                                        <Grid ColumnSpacing="8" Margin="{x:Bind IndentThickness}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="26" />
                                                <ColumnDefinition Width="20" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="95" />
                                                <ColumnDefinition Width="64" />
                                            </Grid.ColumnDefinitions>

                                            <Button
                                                Grid.Column="0"
                                                Visibility="{x:Bind HasChildrenVisibility}"
                                                Content="{x:Bind ExpanderGlyph}"
                                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                                AutomationProperties.Name="Toggle folder expansion"
                                                ToolTipService.ToolTip="Expand or collapse folder"
                                                MinWidth="32"
                                                MinHeight="32"
                                                Padding="0"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Click="OnFolderExpanderClick" />

                                            <FontIcon Grid.Column="1" Glyph="{x:Bind NodeGlyph}" FontSize="14" Foreground="{ThemeResource GwAccentBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{x:Bind Name}" FontWeight="Medium" FontSize="12.5" Foreground="{ThemeResource GwTextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="3" Text="{x:Bind PercentOfParentLabel}" FontSize="11.5" Foreground="{ThemeResource GwTextMutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                            <TextBlock Grid.Column="4" Text="{x:Bind FormattedSize}" FontSize="12.5" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <Button Grid.Column="5" Content="Open" Tag="{x:Bind FullPath}" Style="{StaticResource GwCompactButtonStyle}" HorizontalAlignment="Right" Click="OnRevealInExplorerClick" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <ListView Grid.Row="1" x:Name="LargestFilesListView" Visibility="Collapsed" SelectionMode="Single">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:FileRowViewModel">
                                    <Border Padding="14,7" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="0,0,0,1">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="20" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="95" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <FontIcon Grid.Column="0" Glyph="&#xE8A5;" FontSize="14" Foreground="{ThemeResource GwAccentBrush}" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="12.5" Foreground="{ThemeResource GwTextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind FullPath}" FontSize="10.5" Foreground="{ThemeResource GwTextMutedBrush}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{x:Bind FormattedSize}" FontSize="12.5" FontWeight="Bold" Foreground="{ThemeResource GwAccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <Button Grid.Column="3" Content="Open" Tag="{x:Bind FullPath}" Style="{StaticResource GwCompactButtonStyle}" Click="OnRevealInExplorerClick" />
                                            <Button Grid.Column="4" Content="Recycle" Tag="{x:Bind FullPath}" Style="{StaticResource GwCompactButtonStyle}" Click="OnRecycleSingleFileClick" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
            </Grid>

            <!-- 2. JUNK CLEANER -->
            <ScrollViewer x:Name="SubViewCleaner" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="14">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="1" VerticalAlignment="Center">
                            <TextBlock Text="Junk &amp; Cache Cleaner" FontSize="17" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" />
                            <TextBlock x:Name="CleanerReclaimableSummaryText" Text="Safely remove temp files, multi-profile browser caches, GPU shader caches, and dev leftovers." FontSize="12" Foreground="{ThemeResource GwTextSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Content="Scan" Style="{StaticResource GwSecondaryButtonStyle}" Click="OnScanJunkClick" />
                            <Button x:Name="ExecuteCleanBtn" Content="Clean Selected" Style="{StaticResource GwPrimaryButtonStyle}" Click="OnExecuteCleanClick" />
                        </StackPanel>
                    </Grid>

                    <Border CornerRadius="6" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <Grid Padding="14,7" Background="{ThemeResource GwSubtleSurfaceBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="0,0,0,1" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="110" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="1" Text="CACHE CATEGORY" Style="{StaticResource GwTableColumnHeaderStyle}" />
                                <TextBlock Grid.Column="2" Text="RECLAIMABLE" Style="{StaticResource GwTableColumnHeaderStyle}" HorizontalAlignment="Right" />
                            </Grid>

                            <ItemsControl x:Name="CleanerActiveCategoriesControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="local:StorageSenseCategoryCardViewModel">
                                        <Border Padding="14,10" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="0,0,0,1">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="28" />
                                                    <ColumnDefinition Width="32" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="110" />
                                                </Grid.ColumnDefinitions>

                                                <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}" VerticalAlignment="Center" MinWidth="0" />

                                                <Border Grid.Column="1" Width="32" Height="32" CornerRadius="5" Background="{ThemeResource GwAccentBgBrush}">
                                                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="14" Foreground="{ThemeResource GwAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>

                                                <StackPanel Grid.Column="2" Spacing="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource GwTextPrimaryBrush}" />
                                                    <TextBlock Text="{x:Bind Description}" FontSize="11.5" Foreground="{ThemeResource GwTextSecondaryBrush}" TextWrapping="Wrap" />
                                                </StackPanel>

                                                <TextBlock Grid.Column="3" Text="{x:Bind FormattedSize}" FontSize="13" FontWeight="Bold" Foreground="{ThemeResource GwAccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Manual-Review Large Space Hogs -->
                    <StackPanel x:Name="ManualSpaceHogsSection" Spacing="8" Visibility="Collapsed">
                        <TextBlock Text="PROTECTED / MANUAL REVIEW SPACE HOGS" Style="{StaticResource GwSectionHeaderStyle}" Margin="0,4,0,0" />
                        <Border CornerRadius="6" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                            <ItemsControl x:Name="ManualSpaceHogsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="local:ManualSpaceHogCardViewModel">
                                        <Border Padding="14,10" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="0,0,0,1">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Spacing="1" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource GwTextPrimaryBrush}" />
                                                        <Border Padding="6,1" CornerRadius="3" Background="{ThemeResource GwAmberBgBrush}">
                                                            <TextBlock Text="{x:Bind Category}" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource GwAmberBrush}" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{x:Bind Guidance}" FontSize="11.5" Foreground="{ThemeResource GwTextSecondaryBrush}" TextWrapping="Wrap" />
                                                    <TextBlock Text="{x:Bind LocationPath}" FontSize="10.5" Foreground="{ThemeResource GwTextMutedBrush}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{x:Bind FormattedSize}" FontSize="13" FontWeight="Bold" Foreground="{ThemeResource GwAmberBrush}" VerticalAlignment="Center" />
                                                <Button Grid.Column="2" Content="Copy Fix" Tag="{x:Bind CopyCommand}" Visibility="{x:Bind CopyCommandVisibility}" Style="{StaticResource GwCompactButtonStyle}" Click="OnCopySpaceHogCommandClick" VerticalAlignment="Center" />
                                                <Button Grid.Column="3" Content="Open" Tag="{x:Bind LocationPath}" Style="{StaticResource GwCompactButtonStyle}" Click="OnRevealInExplorerClick" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </StackPanel>

                    <Border
                        x:Name="CleanCategoriesSummaryBorder"
                        Padding="14,10"
                        CornerRadius="6"
                        Background="{ThemeResource GwSignalGreenBgBrush}"
                        BorderBrush="{ThemeResource GwSignalGreenBrush}"
                        BorderThickness="1">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE73E;" FontSize="14" Foreground="{ThemeResource GwSignalGreenBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="CleanCategoriesSummaryText" Text="No issues found" FontSize="12" FontWeight="Medium" Foreground="{ThemeResource GwSignalGreenBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 3. TIDY FOLDER -->
            <Grid x:Name="SubViewOrganizer" Grid.Row="1" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,12" Spacing="10">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="1">
                            <TextBlock Text="Tidy Folder" FontSize="17" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" />
                            <TextBlock Text="Sort cluttered files (Downloads, Desktop) into neat subfolders. Fully reversible via Undo History." FontSize="12" Foreground="{ThemeResource GwTextSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Button Content="Downloads" Style="{StaticResource GwCompactButtonStyle}" Click="OnPresetDownloadsClick" />
                            <Button Content="Desktop" Style="{StaticResource GwCompactButtonStyle}" Click="OnPresetDesktopClick" />
                            <Button Content="Documents" Style="{StaticResource GwCompactButtonStyle}" Click="OnPresetDocumentsClick" />
                            <Button Content="Browse..." Style="{StaticResource GwCompactButtonStyle}" Click="OnBrowseOrganizerFolderClick" />
                        </StackPanel>
                    </Grid>

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="OrganizerFolderBox" x:FieldModifier="public" PlaceholderText="Choose a folder to tidy..." VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="Preview" Style="{StaticResource GwSecondaryButtonStyle}" Click="OnPreviewOrganizeClick" />
                        <Button Grid.Column="2" x:Name="ExecuteOrganizeBtn" Content="Organize" Style="{StaticResource GwPrimaryButtonStyle}" IsEnabled="False" Click="OnExecuteOrganizeClick" />
                    </Grid>
                </StackPanel>

                <Border Grid.Row="1" CornerRadius="6" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Padding="14,7" Background="{ThemeResource GwSubtleSurfaceBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="0,0,0,1" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="85" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="FILE &amp; CURRENT PATH" Style="{StaticResource GwTableColumnHeaderStyle}" />
                            <TextBlock Grid.Column="1" Text="DESTINATION FOLDER" Style="{StaticResource GwTableColumnHeaderStyle}" />
                            <TextBlock Grid.Column="2" Text="SIZE" Style="{StaticResource GwTableColumnHeaderStyle}" HorizontalAlignment="Right" />
                        </Grid>

                        <ListView Grid.Row="1" x:Name="OrganizerPlanListView" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:OrganizationPlanItemViewModel">
                                    <Border Padding="14,8" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="0,0,0,1">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="160" />
                                                <ColumnDefinition Width="85" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind FileName}" FontWeight="SemiBold" FontSize="12.5" Foreground="{ThemeResource GwTextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind SourcePath}" FontSize="10.5" Foreground="{ThemeResource GwTextMutedBrush}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <Border Grid.Column="1" Padding="8,2" CornerRadius="3" Background="{ThemeResource GwAccentBgBrush}" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind TargetSubfolder}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource GwAccentBrush}" />
                                            </Border>
                                            <TextBlock Grid.Column="2" Text="{x:Bind FormattedSize}" FontSize="12" Foreground="{ThemeResource GwTextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
            </Grid>

            <!-- 4. DUPLICATES -->
            <Grid x:Name="SubViewDuplicates" Grid.Row="1" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,12" Spacing="10">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="1">
                            <TextBlock Text="Duplicate File Finder" FontSize="17" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" />
                            <TextBlock x:Name="DuplicatesSummaryText" Text="Finds byte-identical files (skipping NTFS hard links &amp; cloud placeholders) and moves redundant copies to Recycle Bin." FontSize="12" Foreground="{ThemeResource GwTextSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Content="Scan Duplicates" Style="{StaticResource GwSecondaryButtonStyle}" Click="OnScanDuplicatesClick" />
                            <Button x:Name="RecycleDuplicatesBtn" Content="Recycle Selected" Style="{StaticResource GwPrimaryButtonStyle}" IsEnabled="False" Click="OnRecycleDuplicatesClick" />
                        </StackPanel>
                    </Grid>

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="DuplicatesFolderBox" PlaceholderText="Folder to scan for duplicates (defaults to Downloads)..." VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="Downloads" Style="{StaticResource GwCompactButtonStyle}" Click="OnDupPresetDownloadsClick" />
                        <Button Grid.Column="2" Content="Documents" Style="{StaticResource GwCompactButtonStyle}" Click="OnDupPresetDocumentsClick" />
                        <Button Grid.Column="3" Content="Browse..." Style="{StaticResource GwCompactButtonStyle}" Click="OnBrowseDuplicatesFolderClick" />
                    </Grid>
                </StackPanel>

                <ListView x:Name="DuplicatesListView" Grid.Row="1" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:DuplicateGroupCardViewModel">
                            <Border Margin="0,4" CornerRadius="6" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                                <StackPanel>
                                    <Grid Padding="14,9" Background="{ThemeResource GwSubtleSurfaceBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="0,0,0,1" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind SummaryText}" FontWeight="SemiBold" FontSize="12.5" Foreground="{ThemeResource GwTextPrimaryBrush}" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind FormattedWaste}" FontWeight="Bold" FontSize="12.5" Foreground="{ThemeResource GwDangerBrush}" VerticalAlignment="Center" />
                                    </Grid>

                                    <ItemsControl ItemsSource="{x:Bind Files}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="local:DuplicateItemRowViewModel">
                                                <Border Padding="14,7" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="0,0,0,1">
                                                    <Grid ColumnSpacing="10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="26" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}" MinWidth="0" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1" Text="{x:Bind FullPath}" FontSize="12" Foreground="{ThemeResource GwTextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                        <Border Grid.Column="2" Padding="6,2" CornerRadius="3" Background="{ThemeResource GwAccentBgBrush}" VerticalAlignment="Center">
                                                            <TextBlock Text="{x:Bind StatusBadge}" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource GwAccentBrush}" />
                                                        </Border>
                                                        <Button Grid.Column="3" Content="Open" Tag="{x:Bind FullPath}" Style="{StaticResource GwCompactButtonStyle}" Click="OnRevealInExplorerClick" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>
    </Grid>
</Page>
