<Page
    x:Class="Groundwork.Desktop.Views.AssistantPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Groundwork.Desktop"
    xmlns:views="using:Groundwork.Desktop.Views">

    <Grid Padding="24,20">
        <Grid MaxWidth="1040" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Border Grid.Row="0" Margin="0,0,0,12" Padding="16,12" CornerRadius="10" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="AI Assistant" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" />
                        <TextBlock Text="Ask what's slowing down your PC or using up disk space." FontSize="12" Foreground="{ThemeResource GwTextSecondaryBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Border Padding="8,4" CornerRadius="4" Background="{ThemeResource GwAccentBgBrush}" VerticalAlignment="Center">
                            <TextBlock x:Name="AssistantModeBadge" Text="Local Mode" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource GwAccentBrush}" />
                        </Border>
                        <Button Content="Clear" Style="{StaticResource GwCompactButtonStyle}" Click="OnClearConversationClick" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- CHAT AREA -->
            <Border Grid.Row="1" CornerRadius="10" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1" Padding="16">
                <Grid>
                    <StackPanel x:Name="StandbyWelcomePanel" Visibility="Visible" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16" MaxWidth="540">
                        <Border Width="48" Height="48" CornerRadius="24" Background="{ThemeResource GwAccentBgBrush}" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE8BD;" FontSize="22" Foreground="{ThemeResource GwAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Spacing="4" HorizontalAlignment="Center">
                            <TextBlock Text="How can I help with your PC?" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="Checks real Windows data first, and always asks before making changes." FontSize="12" Foreground="{ThemeResource GwTextSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>

                        <Grid ColumnSpacing="8" RowSpacing="8" Margin="0,4,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button Grid.Row="0" Grid.Column="0" Content="What is killing my C: drive space?" Style="{StaticResource GwSecondaryButtonStyle}" HorizontalAlignment="Stretch" Click="OnSuggestedPromptClick" />
                            <Button Grid.Row="0" Grid.Column="1" Content="Which startup apps slow down boot?" Style="{StaticResource GwSecondaryButtonStyle}" HorizontalAlignment="Stretch" Click="OnSuggestedPromptClick" />
                            <Button Grid.Row="1" Grid.Column="0" Content="Why is my PC running slow?" Style="{StaticResource GwSecondaryButtonStyle}" HorizontalAlignment="Stretch" Click="OnSuggestedPromptClick" />
                            <Button Grid.Row="1" Grid.Column="1" Content="Check Windows health &amp; errors" Style="{StaticResource GwSecondaryButtonStyle}" HorizontalAlignment="Stretch" Click="OnSuggestedPromptClick" />
                        </Grid>
                    </StackPanel>

                    <ListView x:Name="ChatMessagesListView" Visibility="Collapsed" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="views:AssistantChatMessage">
                                <Border
                                    Margin="0,6"
                                    Padding="14,12"
                                    CornerRadius="10"
                                    Background="{x:Bind BubbleBackground}"
                                    HorizontalAlignment="{x:Bind BubbleAlignment}"
                                    MaxWidth="780">
                                    <StackPanel Spacing="6">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{x:Bind SenderName}" FontWeight="SemiBold" FontSize="12" Foreground="{x:Bind SenderColor}" />
                                            <TextBlock Text="{x:Bind Timestamp}" FontSize="11" Foreground="{ThemeResource GwTextMutedBrush}" />
                                        </StackPanel>

                                        <Border
                                            Visibility="{x:Bind ToolActivityVisibility}"
                                            Padding="8,4"
                                            CornerRadius="4"
                                            Background="{ThemeResource GwCardBackgroundBrush}"
                                            HorizontalAlignment="Left">
                                            <TextBlock Text="{x:Bind ToolActivity}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource GwTealBrush}" TextWrapping="Wrap" />
                                        </Border>

                                        <TextBlock Text="{x:Bind Content}" FontSize="13" LineHeight="19" Foreground="{x:Bind ContentColor}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- INPUT BAR -->
            <Border Grid.Row="2" Margin="0,12,0,0" Padding="10" CornerRadius="10" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        x:Name="QueryInputBox"
                        x:FieldModifier="public"
                        PlaceholderText="Ask a question (e.g. 'What is taking up C: space?' or 'Clean temp files')..."
                        KeyDown="OnQueryInputBoxKeyDown"
                        VerticalAlignment="Center" />
                    <Button
                        Grid.Column="1"
                        x:Name="SendQueryBtn"
                        Content="Send"
                        Style="{StaticResource GwPrimaryButtonStyle}"
                        Click="OnSendQueryClick"
                        VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
