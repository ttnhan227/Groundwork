<Page
    x:Class="Groundwork.Desktop.Views.AssistantPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Groundwork.Desktop"
    xmlns:views="using:Groundwork.Desktop.Views">

    <Grid Padding="20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header & Telemetry Chip -->
        <Border Grid.Row="0" Margin="0,0,0,12" Padding="14,10" CornerRadius="8" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2">
                    <TextBlock Text="Groundwork AI System Assistant" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" />
                    <TextBlock Text="Ask questions or describe symptoms. Grounded in real Windows telemetry with safe token-gated execution." FontSize="11" Foreground="{ThemeResource GwTextSecondaryBrush}" />
                </StackPanel>
                <Button Grid.Column="1" Content="Clear Conversation" Style="{StaticResource GwCompactButtonStyle}" Click="OnClearConversationClick" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Conversational Chat Thread (Scrollable) -->
        <Border Grid.Row="1" CornerRadius="8" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1" Padding="16">
            <Grid>
                <!-- Standby Welcome State when conversation is empty -->
                <StackPanel x:Name="StandbyWelcomePanel" Visibility="Visible" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16" MaxWidth="560">
                    <Border Width="48" Height="48" CornerRadius="24" Background="{ThemeResource GwAccentBgBrush}" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE8BD;" FontSize="22" Foreground="{ThemeResource GwAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Spacing="4" HorizontalAlignment="Center">
                        <TextBlock Text="How can I assist your PC today?" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="I can inspect hardware sensors, diagnose slow boot times, find large hidden files, or tune Windows settings." FontSize="12" Foreground="{ThemeResource GwTextSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- Suggested Prompts Grid -->
                    <Grid ColumnSpacing="8" RowSpacing="8" Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Row="0" Grid.Column="0" Content="💾 Why is my C drive low on space?" Style="{StaticResource GwSecondaryButtonStyle}" HorizontalAlignment="Stretch" Click="OnSuggestedPromptClick" />
                        <Button Grid.Row="0" Grid.Column="1" Content="⚡ Which startup apps slow down boot?" Style="{StaticResource GwSecondaryButtonStyle}" HorizontalAlignment="Stretch" Click="OnSuggestedPromptClick" />
                        <Button Grid.Row="1" Grid.Column="0" Content="🌐 Switch my DNS to Cloudflare." Style="{StaticResource GwSecondaryButtonStyle}" HorizontalAlignment="Stretch" Click="OnSuggestedPromptClick" />
                        <Button Grid.Row="1" Grid.Column="1" Content="🛠️ Check Windows servicing integrity." Style="{StaticResource GwSecondaryButtonStyle}" HorizontalAlignment="Stretch" Click="OnSuggestedPromptClick" />
                    </Grid>
                </StackPanel>

                <!-- Active Chat Messages List -->
                <ListView
                    x:Name="ChatMessagesListView"
                    Visibility="Collapsed"
                    SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="views:AssistantChatMessage">
                            <Border
                                Margin="0,6"
                                Padding="14,12"
                                CornerRadius="8"
                                Background="{x:Bind BubbleBackground}"
                                HorizontalAlignment="{x:Bind BubbleAlignment}"
                                MaxWidth="720">
                                <StackPanel Spacing="6">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{x:Bind SenderName}" FontWeight="SemiBold" FontSize="11" Foreground="{x:Bind SenderColor}" />
                                        <TextBlock Text="{x:Bind Timestamp}" FontSize="10" Foreground="{ThemeResource GwTextMutedBrush}" />
                                    </StackPanel>

                                    <!-- Collapsible Tool Step Activity Pill -->
                                    <Border
                                        Visibility="{x:Bind ToolActivityVisibility}"
                                        Padding="8,4"
                                        CornerRadius="4"
                                        Background="{ThemeResource GwCardBackgroundHoverBrush}"
                                        HorizontalAlignment="Left">
                                        <TextBlock Text="{x:Bind ToolActivity}" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource GwTealBrush}" />
                                    </Border>

                                    <!-- Message Body -->
                                    <TextBlock Text="{x:Bind Content}" FontSize="12" Foreground="{x:Bind ContentColor}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <!-- Bottom Query Input Bar -->
        <Border Grid.Row="2" Margin="0,12,0,0" Padding="10" CornerRadius="8" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    x:Name="QueryInputBox"
                    x:FieldModifier="public"
                    PlaceholderText="Describe a symptom or question (e.g. 'Why is my computer running hot?', 'Clean my recycle bin')..."
                    KeyDown="OnQueryInputBoxKeyDown"
                    VerticalAlignment="Center" />
                <Button
                    Grid.Column="1"
                    x:Name="SendQueryBtn"
                    Content="Ask Assistant"
                    Style="{StaticResource GwPrimaryButtonStyle}"
                    Click="OnSendQueryClick"
                    VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Page>
