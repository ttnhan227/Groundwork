<UserControl
    x:Class="Groundwork.Desktop.Controls.HealthGauge"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Width="96" Height="96">
        <!-- Background Track -->
        <ProgressRing
            IsIndeterminate="False"
            Value="100"
            Width="96"
            Height="96"
            Foreground="{ThemeResource GwCardBorderStrongBrush}"
            Opacity="0.3" />

        <!-- Foreground Value Ring -->
        <ProgressRing
            x:Name="ValueRing"
            IsIndeterminate="False"
            Value="96"
            Width="96"
            Height="96"
            Foreground="{ThemeResource GwSignalGreenBrush}" />

        <!-- Center Score Text -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="0">
            <TextBlock
                x:Name="ScoreText"
                Text="96%"
                FontSize="20"
                FontWeight="Bold"
                Foreground="{ThemeResource GwTextPrimaryBrush}"
                HorizontalAlignment="Center" />
            <TextBlock
                x:Name="LabelText"
                Text="Healthy"
                FontSize="10"
                FontWeight="SemiBold"
                Foreground="{ThemeResource GwTextSecondaryBrush}"
                HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</UserControl>
