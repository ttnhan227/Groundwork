<ContentDialog
    x:Class="Groundwork.Desktop.Dialogs.RollbackLedgerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Groundwork.Desktop"
    Title="Safe Operation History &amp; Rollback Ledger"
    PrimaryButtonText="Close"
    DefaultButton="Primary">

    <Grid MinWidth="680" MaxWidth="800" MaxHeight="520">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Text="All system modifications made by Groundwork are cryptographically recorded with full pre/post state captures. Reversible actions can be rolled back anytime."
            FontSize="12"
            Foreground="{ThemeResource GwTextSecondaryBrush}"
            TextWrapping="Wrap"
            Margin="0,0,0,16" />

        <!-- Empty State -->
        <Border
            x:Name="EmptyHistoryCard"
            Grid.Row="1"
            Padding="32"
            CornerRadius="8"
            Background="{ThemeResource GwCardBackgroundHoverBrush}"
            BorderBrush="{ThemeResource GwCardBorderBrush}"
            BorderThickness="1"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center">
            <StackPanel HorizontalAlignment="Center" Spacing="10">
                <Border Width="48" Height="48" CornerRadius="24" Background="{ThemeResource GwAccentBgBrush}" HorizontalAlignment="Center">
                    <FontIcon Glyph="&#xE81C;" FontSize="22" Foreground="{ThemeResource GwAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="No Modifying Operations Recorded Yet" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="When you tune power schemes, disable startup apps, or clean temporary files, an immutable rollback point will be created here." FontSize="12" Foreground="{ThemeResource GwTextSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="440" />
            </StackPanel>
        </Border>

        <!-- History ListView -->
        <ListView
            x:Name="LedgerListView"
            Grid.Row="1"
            SelectionMode="None"
            Margin="0,4,0,0">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:OperationHistoryRowViewModel">
                    <Border
                        Margin="0,4"
                        Padding="14,12"
                        CornerRadius="8"
                        Background="{ThemeResource GwCardBackgroundBrush}"
                        BorderBrush="{ThemeResource GwCardBorderBrush}"
                        BorderThickness="1">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border Padding="6,2" CornerRadius="4" Background="{ThemeResource GwAccentBgBrush}">
                                        <TextBlock Text="{x:Bind Category}" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource GwAccentBrush}" />
                                    </Border>
                                    <TextBlock Text="{x:Bind DisplayName}" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource GwTextPrimaryBrush}" />
                                    <Border Padding="6,2" CornerRadius="4" Background="{ThemeResource GwCardBackgroundHoverBrush}">
                                        <TextBlock Text="{x:Bind StatusBadge}" FontSize="10" Foreground="{ThemeResource GwTextSecondaryBrush}" />
                                    </Border>
                                </StackPanel>

                                <TextBlock Text="{x:Bind TargetDescription}" FontSize="11" Foreground="{ThemeResource GwTextSecondaryBrush}" TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind VerificationSummary}" FontSize="11" Foreground="{ThemeResource GwTealBrush}" />
                                <TextBlock Text="{x:Bind ExecutedAtDisplay}" FontSize="10" Foreground="{ThemeResource GwTextMutedBrush}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                <Button
                                    Content="Rollback Undo"
                                    Tag="{x:Bind ExecutionId}"
                                    Visibility="{x:Bind RollbackButtonVisibility}"
                                    Style="{StaticResource GwCompactButtonStyle}"
                                    Click="OnRollbackItemClick" />
                                <TextBlock
                                    Text="{x:Bind ReversibilityNote}"
                                    FontSize="10"
                                    Foreground="{ThemeResource GwTextMutedBrush}"
                                    HorizontalAlignment="Right" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</ContentDialog>
