<ContentDialog
    x:Class="Groundwork.Desktop.Dialogs.GuidedUninstallDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Groundwork.Desktop.Dialogs"
    PrimaryButtonText=""
    CloseButtonText=""
    DefaultButton="None">

    <Grid MaxWidth="820" MinWidth="560" MinHeight="440" MaxHeight="560" RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- HEADER: APP IDENTITY & CURRENT MODE -->
        <Grid Grid.Row="0" Padding="0,0,0,12" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="Guided Uninstaller" FontSize="17" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" />
                    <Border Padding="6,1" CornerRadius="4" Background="{ThemeResource GwAccentBgBrush}">
                        <TextBlock x:Name="HeaderModeBadge" Text="Step 1 of 5" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource GwAccentBrush}" />
                    </Border>
                </StackPanel>
                <TextBlock x:Name="AppMetaText" Text="Application • Publisher • Version" FontSize="12" Foreground="{ThemeResource GwTextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Grid>

        <!-- REVO-STYLE 5-STEP PROGRESS STEPPER -->
        <Grid Grid.Row="1" Padding="0,10,0,12" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="0,0,0,1" ColumnSpacing="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border x:Name="StepBadge1" Grid.Column="0" Padding="8,6" CornerRadius="5" Background="{ThemeResource GwAccentBgBrush}" BorderBrush="{ThemeResource GwAccentBrush}" BorderThickness="1">
                <TextBlock x:Name="StepText1" Text="1. Uninstaller" FontSize="11.5" FontWeight="SemiBold" Foreground="{ThemeResource GwAccentBrush}" HorizontalAlignment="Center" />
            </Border>
            <Border x:Name="StepBadge2" Grid.Column="1" Padding="8,6" CornerRadius="5" Background="{ThemeResource GwSubtleSurfaceBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                <TextBlock x:Name="StepText2" Text="2. Scan Mode" FontSize="11.5" FontWeight="Medium" Foreground="{ThemeResource GwTextMutedBrush}" HorizontalAlignment="Center" />
            </Border>
            <Border x:Name="StepBadge3" Grid.Column="2" Padding="8,6" CornerRadius="5" Background="{ThemeResource GwSubtleSurfaceBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                <TextBlock x:Name="StepText3" Text="3. Registry" FontSize="11.5" FontWeight="Medium" Foreground="{ThemeResource GwTextMutedBrush}" HorizontalAlignment="Center" />
            </Border>
            <Border x:Name="StepBadge4" Grid.Column="3" Padding="8,6" CornerRadius="5" Background="{ThemeResource GwSubtleSurfaceBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                <TextBlock x:Name="StepText4" Text="4. Files" FontSize="11.5" FontWeight="Medium" Foreground="{ThemeResource GwTextMutedBrush}" HorizontalAlignment="Center" />
            </Border>
            <Border x:Name="StepBadge5" Grid.Column="4" Padding="8,6" CornerRadius="5" Background="{ThemeResource GwSubtleSurfaceBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                <TextBlock x:Name="StepText5" Text="5. Finish" FontSize="11.5" FontWeight="Medium" Foreground="{ThemeResource GwTextMutedBrush}" HorizontalAlignment="Center" />
            </Border>
        </Grid>

        <!-- WORKSPACE CONTENT -->
        <Grid Grid.Row="2" Padding="0,16,0,16">

            <!-- STAGE 1A: CONFIRM LAUNCHING BUILT-IN UNINSTALLER -->
            <StackPanel x:Name="StageConfirmPanel" Spacing="14" Visibility="Visible">
                <Border Padding="14,12" CornerRadius="6" Background="{ThemeResource GwSubtleSurfaceBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="40" Height="40" CornerRadius="6" Background="{ThemeResource GwAccentBgBrush}" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE74D;" FontSize="18" Foreground="{ThemeResource GwAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock x:Name="ConfirmAppNameText" Text="Application Name" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" />
                            <TextBlock x:Name="ConfirmUninstallCmdText" Text="Uninstall command" FontSize="11" Foreground="{ThemeResource GwTextMutedBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Padding="16,14" CornerRadius="6" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                    <StackPanel Spacing="8">
                        <TextBlock Text="How Groundwork Clean Uninstall Works" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" />
                        <TextBlock Text="1. First, Groundwork runs the application's built-in uninstaller and waits for it to finish cleanly — without interrupting it." FontSize="12.5" Foreground="{ThemeResource GwTextSecondaryBrush}" TextWrapping="Wrap" />
                        <TextBlock Text="2. Next, you choose a Leftover Scan Mode (Safe, Moderate, or Advanced) depending on how deeply you want to search." FontSize="12.5" Foreground="{ThemeResource GwTextSecondaryBrush}" TextWrapping="Wrap" />
                        <TextBlock Text="3. Finally, review leftover Registry traces and leftover Files/Folders separately before deleting anything." FontSize="12.5" Foreground="{ThemeResource GwTextSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <CheckBox
                    x:Name="SkipBuiltInCheckBox"
                    Content="Skip built-in uninstaller (app was already removed or its uninstaller is broken — jump directly to Leftover Scan Mode)"
                    FontSize="12"
                    Foreground="{ThemeResource GwTextSecondaryBrush}" />
            </StackPanel>

            <!-- STAGE 1B & SCANNING PROGRESS -->
            <StackPanel x:Name="StageProgressPanel" Spacing="14" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24,36">
                <ProgressRing x:Name="WizardProgressRing" IsActive="True" Width="44" Height="44" HorizontalAlignment="Center" />
                <TextBlock x:Name="ProgressTitleText" Text="Running official uninstaller..." FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" HorizontalAlignment="Center" TextAlignment="Center" />
                <TextBlock x:Name="ProgressDetailText" Text="Complete the uninstaller window that opened. Groundwork will automatically proceed to Scanning Modes once it closes." FontSize="12.5" Foreground="{ThemeResource GwTextSecondaryBrush}" MaxWidth="520" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" />
            </StackPanel>

            <!-- STAGE 2: REVO-STYLE SCANNING MODE SELECTION -->
            <StackPanel x:Name="StageScanModePanel" Spacing="12" Visibility="Collapsed">
                <StackPanel Spacing="2">
                    <TextBlock Text="Select Leftover Scanning Mode" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" />
                    <TextBlock Text="Official uninstaller step completed. Choose how deeply Groundwork should search for remaining registry keys and files:" FontSize="12" Foreground="{ThemeResource GwTextSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>

                <RadioButtons x:Name="ScanModeRadioGroup" SelectedIndex="1" SelectionChanged="OnScanModeSelectionChanged">
                    <RadioButton Tag="Safe" Margin="0,4">
                        <Border Padding="12,10" CornerRadius="6" Background="{ThemeResource GwSubtleSurfaceBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1" Width="740">
                            <StackPanel Spacing="2">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Safe" FontSize="13.5" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" />
                                    <Border Padding="6,1" CornerRadius="3" Background="{ThemeResource GwSignalGreenBgBrush}">
                                        <TextBlock Text="Fastest • Zero Risk" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource GwSignalGreenBrush}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Checks only exact application folders (Install Directory, AppData Local/Roaming/LocalLow, ProgramData, Program Files) and direct HKCU/HKLM Software keys." FontSize="12" Foreground="{ThemeResource GwTextSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </RadioButton>

                    <RadioButton Tag="Moderate" Margin="0,4">
                        <Border Padding="12,10" CornerRadius="6" Background="{ThemeResource GwSubtleSurfaceBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1" Width="740">
                            <StackPanel Spacing="2">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Moderate" FontSize="13.5" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" />
                                    <Border Padding="6,1" CornerRadius="3" Background="{ThemeResource GwAccentBgBrush}">
                                        <TextBlock Text="Recommended" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource GwAccentBrush}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Everything in Safe plus 32-bit WOW6432Node keys, publisher keys, Start Menu &amp; Desktop shortcuts, and Temp folders." FontSize="12" Foreground="{ThemeResource GwTextSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </RadioButton>

                    <RadioButton Tag="Advanced" Margin="0,4">
                        <Border Padding="12,10" CornerRadius="6" Background="{ThemeResource GwSubtleSurfaceBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1" Width="740">
                            <StackPanel Spacing="2">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Advanced" FontSize="13.5" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" />
                                    <Border Padding="6,1" CornerRadius="3" Background="{ThemeResource GwAmberBgBrush}">
                                        <TextBlock Text="Deep Scan • Searches Everything" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource GwAmberBrush}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Full system sweep: nested subfolders, Common Files, Documents, Saved Games, CrashDumps, Prefetch, leftover Uninstall entries, App Paths, custom URL protocols, Services, dead Run startup entries, and MuiCache." FontSize="12" Foreground="{ThemeResource GwTextSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </RadioButton>
                </RadioButtons>
            </StackPanel>

            <!-- STAGE 3: LEFTOVER REGISTRY TRACES -->
            <Grid x:Name="StageRegistryPanel" Visibility="Collapsed" RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock x:Name="RegistryHeaderTitle" Text="Found Leftover Registry Traces" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" />
                        <TextBlock x:Name="RegistryHeaderSubtitle" Text="Exact application matches are pre-checked. Review broad or Admin-tagged items carefully." FontSize="12" Foreground="{ThemeResource GwTextSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Button Content="Select All" Style="{StaticResource GwCompactButtonStyle}" Click="OnRegSelectAllClick" />
                        <Button Content="Matched Only" Style="{StaticResource GwCompactButtonStyle}" Click="OnRegSelectSafeClick" />
                        <Button Content="Unselect All" Style="{StaticResource GwCompactButtonStyle}" Click="OnRegUnselectAllClick" />
                    </StackPanel>
                </Grid>

                <!-- Column Headers -->
                <Grid Grid.Row="1" Padding="10,6" Background="{ThemeResource GwSubtleSurfaceBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1,1,1,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="105" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Text="REGISTRY PATH / VALUE" Style="{StaticResource GwTableColumnHeaderStyle}" />
                    <TextBlock Grid.Column="2" Text="CATEGORY" Style="{StaticResource GwTableColumnHeaderStyle}" />
                    <TextBlock Grid.Column="3" Text="CONFIDENCE" Style="{StaticResource GwTableColumnHeaderStyle}" HorizontalAlignment="Right" />
                </Grid>

                <Border Grid.Row="2" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1,0,1,1" Background="{ThemeResource GwCardBackgroundBrush}">
                    <ListView x:Name="RegistryTraceListView" MaxHeight="310" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:UninstallTraceRowViewModel">
                                <Border Padding="10,7" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="0,0,0,1">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="26" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="105" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}" MinWidth="0" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind TargetPath}" FontSize="12" FontWeight="Medium" Foreground="{ThemeResource GwTextPrimaryBrush}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind TargetPath}" />
                                            <TextBlock Text="{x:Bind Evidence}" FontSize="10.5" Foreground="{ThemeResource GwTextMutedBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{x:Bind KindBadge}" FontSize="11" Foreground="{ThemeResource GwTextSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <Border Grid.Column="3" Padding="7,2" CornerRadius="3" Background="{ThemeResource GwAccentBgBrush}" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind SizeOrScopeText}" FontSize="10.5" FontWeight="SemiBold" Foreground="{ThemeResource GwAccentBrush}" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>
            </Grid>

            <!-- STAGE 4: LEFTOVER FILES & FOLDERS -->
            <Grid x:Name="StageFilesPanel" Visibility="Collapsed" RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock x:Name="FilesHeaderTitle" Text="Found Leftover Files &amp; Folders" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" />
                        <TextBlock x:Name="FilesHeaderSubtitle" Text="Checked items move safely to the Windows Recycle Bin." FontSize="12" Foreground="{ThemeResource GwTextSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Button Content="Select All" Style="{StaticResource GwCompactButtonStyle}" Click="OnFilesSelectAllClick" />
                        <Button Content="Safe Only" Style="{StaticResource GwCompactButtonStyle}" Click="OnFilesSelectSafeClick" />
                        <Button Content="Unselect All" Style="{StaticResource GwCompactButtonStyle}" Click="OnFilesUnselectAllClick" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Padding="10,6" Background="{ThemeResource GwSubtleSurfaceBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1,1,1,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="125" />
                        <ColumnDefinition Width="85" />
                        <ColumnDefinition Width="62" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Text="PATH &amp; ITEM" Style="{StaticResource GwTableColumnHeaderStyle}" />
                    <TextBlock Grid.Column="2" Text="LOCATION" Style="{StaticResource GwTableColumnHeaderStyle}" />
                    <TextBlock Grid.Column="3" Text="SIZE" Style="{StaticResource GwTableColumnHeaderStyle}" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="4" Text="" Style="{StaticResource GwTableColumnHeaderStyle}" />
                </Grid>

                <Border Grid.Row="2" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1,0,1,1" Background="{ThemeResource GwCardBackgroundBrush}">
                    <ListView x:Name="FilesTraceListView" MaxHeight="310" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:UninstallTraceRowViewModel">
                                <Border Padding="10,7" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="0,0,0,1">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="26" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="125" />
                                            <ColumnDefinition Width="85" />
                                            <ColumnDefinition Width="62" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}" MinWidth="0" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Title}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind TargetPath}" FontSize="10.5" Foreground="{ThemeResource GwTextMutedBrush}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind TargetPath}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{x:Bind KindBadge}" FontSize="11" Foreground="{ThemeResource GwTextSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="3" Text="{x:Bind SizeOrScopeText}" FontSize="11.5" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        <Button Grid.Column="4" Content="Open" Tag="{x:Bind TargetPath}" Style="{StaticResource GwCompactButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="OnOpenTracePathClick" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>
            </Grid>

            <!-- STAGE 5: COMPLETE SUMMARY -->
            <StackPanel x:Name="StageDonePanel" Spacing="14" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="540">
                <Border Padding="20,18" CornerRadius="8" Background="{ThemeResource GwSignalGreenBgBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                    <StackPanel Spacing="8" HorizontalAlignment="Center">
                        <FontIcon x:Name="DoneStatusIcon" Glyph="&#xE73E;" FontSize="28" Foreground="{ThemeResource GwSignalGreenBrush}" HorizontalAlignment="Center" />
                        <TextBlock x:Name="DoneTitleText" Text="Uninstall Complete" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" HorizontalAlignment="Center" TextAlignment="Center" />
                        <TextBlock x:Name="DoneSummaryText" Text="Summary details..." FontSize="12.5" Foreground="{ThemeResource GwTextSecondaryBrush}" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- CUSTOM REVO-STYLE WIZARD FOOTER BAR -->
        <Grid Grid.Row="3" Padding="0,12,0,0" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="FooterHintText" Text="Step 1: Run the official uninstaller first." FontSize="12" Foreground="{ThemeResource GwTextMutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button x:Name="SecondaryActionBtn" Content="Skip" Style="{StaticResource GwSecondaryButtonStyle}" Visibility="Collapsed" Click="OnSecondaryActionClick" />
                <Button x:Name="CancelActionBtn" Content="Cancel" Style="{StaticResource GwSecondaryButtonStyle}" Click="OnCancelActionClick" />
                <Button x:Name="PrimaryActionBtn" Content="Start Uninstaller →" Style="{StaticResource GwPrimaryButtonStyle}" Click="OnPrimaryActionClick" />
            </StackPanel>
        </Grid>
    </Grid>
</ContentDialog>
