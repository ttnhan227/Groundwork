<Window
    x:Class="Groundwork.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Groundwork.Desktop"
    xmlns:engineModels="using:Groundwork.Engine.Models"
    Title="Groundwork — Storage &amp; Cleanup">

    <Grid Background="{ThemeResource GwPageBackgroundBrush}" KeyDown="OnRootGridKeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. TOP BRANDED COMMAND BAR (Ink Blue & White Signature Header) -->
        <Border Grid.Row="0" Background="{ThemeResource GwHeaderBackgroundBrush}" RequestedTheme="Dark" BorderBrush="{ThemeResource GwCardBorderStrongBrush}" BorderThickness="0,0,0,1" Padding="16,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Brand Identity -->
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="0,0,24,0">
                    <Image Source="ms-appx:///Assets/icon.png" Width="26" Height="26" VerticalAlignment="Center" />
                    <TextBlock Text="Groundwork" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                    <Border Padding="6,2" CornerRadius="4" Background="#1E3A5F" BorderBrush="#2D5A8C" BorderThickness="1" VerticalAlignment="Center">
                        <TextBlock Text="v1.0.0" FontSize="10" FontWeight="SemiBold" Foreground="#93C5FD" />
                    </Border>
                </StackPanel>

                <!-- Top Horizontal Navigation Tabs (Files, Cleanup, Apps, Hardware, Agent, Organize) -->
                <NavigationView
                    x:Name="TopCommandNav"
                    Grid.Column="1"
                    PaneDisplayMode="Top"
                    IsBackButtonVisible="Collapsed"
                    IsSettingsVisible="False"
                    SelectionChanged="OnNavigationSelectionChanged"
                    Background="Transparent">
                    <NavigationView.MenuItems>
                        <NavigationViewItem Content="Storage Analyzer" Tag="Storage" IsSelected="True">
                            <NavigationViewItem.Icon><FontIcon Glyph="&#xEDA2;" /></NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem Content="Storage Cleanup" Tag="Cleanup">
                            <NavigationViewItem.Icon><SymbolIcon Symbol="Delete" /></NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem Content="Installed Apps" Tag="Apps">
                            <NavigationViewItem.Icon><SymbolIcon Symbol="AllApps" /></NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem Content="Hardware &amp; Specs" Tag="Hardware">
                            <NavigationViewItem.Icon><FontIcon Glyph="&#xE7F8;" /></NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem Content="Agent" Tag="Agent">
                            <NavigationViewItem.Icon><SymbolIcon Symbol="Message" /></NavigationViewItem.Icon>
                        </NavigationViewItem>
                    </NavigationView.MenuItems>
                    <NavigationView.FooterMenuItems>
                        <NavigationViewItem Content="Settings" Tag="Settings">
                            <NavigationViewItem.Icon><SymbolIcon Symbol="Setting" /></NavigationViewItem.Icon>
                        </NavigationViewItem>
                    </NavigationView.FooterMenuItems>
                </NavigationView>

                <!-- Right Side Empty (Clean Minimal Design) -->
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock x:Name="SidecarStatusBadge" Visibility="Collapsed" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. MAIN CONTENT AREA (Tabbed Workspaces) -->
        <Grid Grid.Row="1" Padding="20,16" Background="{ThemeResource GwPageBackgroundBrush}">

            <!-- ======================================================== -->
            <!-- 1. FILES & STORAGE WORKSPACE -->
            <!-- ======================================================== -->
            <Grid x:Name="StoragePanel" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Row 0: Responsive Volume Selector & Quick Controls -->
                <Border Grid.Row="0" Margin="0,0,0,8" Padding="12,8" CornerRadius="8" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="2.2*" MinWidth="160" MaxWidth="340" />
                            <ColumnDefinition Width="3*" MinWidth="140" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Drive:" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" x:Name="DrivesComboBox" HorizontalAlignment="Stretch" SelectionChanged="OnDrivesComboBoxSelectionChanged" VerticalAlignment="Center" ToolTipService.ToolTip="Select a drive or folder to scan" />
                        <TextBox Grid.Column="2" x:Name="ScanPathTextBox" PlaceholderText="Folder or drive path..." HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                        <Button Grid.Column="3" Content="Browse..." Style="{StaticResource GwSecondaryButtonStyle}" Click="OnScanCustomPathClick" VerticalAlignment="Center" ToolTipService.ToolTip="Browse for a folder on your PC" />
                        <Button Grid.Column="4" Content="Scan" Style="{StaticResource GwPrimaryButtonStyle}" Padding="18,6" Click="OnRunScanPathClick" VerticalAlignment="Center" ToolTipService.ToolTip="Scan selected drive or folder" />
                        <Button Grid.Column="5" x:Name="CancelScanButton" Content="Cancel" IsEnabled="False" Style="{StaticResource GwSecondaryButtonStyle}" Click="OnCancelScanClick" VerticalAlignment="Center" />
                        <Button Grid.Column="6" Content="Refresh" Style="{StaticResource GwSecondaryButtonStyle}" Click="OnRefreshDrivesClick" ToolTipService.ToolTip="Re-detect mounted drives" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Row 1: Proportional Storage Breakdown Bar -->
                <Border Grid.Row="1" Margin="0,0,0,8" Padding="12,8" CornerRadius="8" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                    <StackPanel Spacing="6">
                        <!-- Segmented Visual Bar -->
                        <Border Height="11" CornerRadius="3" Background="{ThemeResource GwCardBackgroundHoverBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                            <Grid x:Name="StorageBreakdownBarGrid" />
                        </Border>
                        <!-- Legend Pills -->
                        <Grid>
                            <ItemsControl x:Name="StorageBreakdownLegendControl">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="16" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="local:StorageBarSegmentViewModel">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind TooltipText}">
                                            <Border Width="9" Height="9" CornerRadius="2" Background="{x:Bind ColorHex}" VerticalAlignment="Center" />
                                            <TextBlock Text="{x:Bind Name}" FontSize="11" FontWeight="Medium" Foreground="{ThemeResource GwTextPrimaryBrush}" VerticalAlignment="Center" />
                                            <TextBlock Text="{x:Bind FormattedSize}" FontSize="11" Foreground="{ThemeResource GwTextMutedBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="StorageBreakdownSummaryText" Visibility="Collapsed" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Row 2: Hierarchical Explorer & File Table (Full Height) -->
                <Border Grid.Row="2" CornerRadius="8" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Unified Explorer Header: Unified Tree / Flat Files Toggle + Instant Filter -->
                        <Border Grid.Row="0" Background="{ThemeResource GwCardBackgroundHoverBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="0,0,0,1" Padding="12,6">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" MinWidth="140" MaxWidth="380" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" x:Name="ViewTreeTabButton" Content="Tree (Folders &amp; Files)" Style="{StaticResource GwPrimaryButtonStyle}" Padding="12,5" FontSize="12" Click="OnViewTreeTabClick" />
                                <Button Grid.Column="1" x:Name="ViewFileTabButton" Content="Largest Files (Flat)" Style="{StaticResource GwSecondaryButtonStyle}" Padding="12,5" FontSize="12" Click="OnViewFileTabClick" />
                                <Border Grid.Column="2" Width="1" Height="16" Background="{ThemeResource GwCardBorderBrush}" Margin="2,0" />
                                <TextBox Grid.Column="3" x:Name="TreeFilterTextBox" PlaceholderText="Filter by name, extension (e.g. *.mp4)..." HorizontalAlignment="Stretch" TextChanged="OnTreeFilterTextChanged" />
                                <Button Grid.Column="4" Content="Clear" Style="{StaticResource GwSecondaryButtonStyle}" Padding="8,4" FontSize="11" Click="OnClearTreeFilterClick" />
                                <Button Grid.Column="6" Content="Collapse All" Style="{StaticResource GwSecondaryButtonStyle}" Padding="8,4" FontSize="11" Click="OnCollapseAllTreeNodesClick" />
                                <TextBlock x:Name="ViewTabSummaryText" Visibility="Collapsed" />
                            </Grid>
                        </Border>

                        <!-- ================= 3A. TREE VIEW ================= -->
                        <Grid x:Name="TreeContentGrid" Grid.Row="1" Visibility="Visible">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Tree Column Header -->
                            <Border Grid.Row="0" Background="{ThemeResource GwCardBackgroundHoverBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="0,0,0,1" Padding="12,7">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="220" />
                                        <ColumnDefinition Width="105" />
                                        <ColumnDefinition Width="85" />
                                        <ColumnDefinition Width="85" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="65" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Folder / File Name" FontWeight="SemiBold" FontSize="11" Foreground="{ThemeResource GwTextPrimaryBrush}" />
                                    <TextBlock Grid.Column="1" Text="% of Drive" FontWeight="SemiBold" FontSize="11" Foreground="{ThemeResource GwTextSecondaryBrush}" />
                                    <TextBlock Grid.Column="2" Text="Size" FontWeight="SemiBold" FontSize="11" Foreground="{ThemeResource GwTextSecondaryBrush}" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="3" Text="Allocated" FontWeight="SemiBold" FontSize="11" Foreground="{ThemeResource GwTextSecondaryBrush}" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="4" Text="Files" FontWeight="SemiBold" FontSize="11" Foreground="{ThemeResource GwTextSecondaryBrush}" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="5" Text="Folders" FontWeight="SemiBold" FontSize="11" Foreground="{ThemeResource GwTextSecondaryBrush}" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="6" Text="Attributes" FontWeight="SemiBold" FontSize="11" Foreground="{ThemeResource GwTextSecondaryBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Grid.Column="7" Text="Modified" FontWeight="SemiBold" FontSize="11" Foreground="{ThemeResource GwTextSecondaryBrush}" HorizontalAlignment="Right" />
                                </Grid>
                            </Border>

                            <!-- Virtualized Hierarchical Tree ListView -->
                            <ListView x:Name="StorageTreeListView" Grid.Row="1" SelectionMode="Single" SelectionChanged="OnStorageTreeSelectionChanged" KeyDown="OnStorageTreeKeyDown">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="Padding" Value="12,0,12,0" />
                                        <Setter Property="Margin" Value="0" />
                                        <Setter Property="MinHeight" Value="28" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:StorageTreeNodeViewModel">
                                        <Grid Margin="0" Padding="0,3" ColumnSpacing="8" Background="Transparent" RightTapped="OnTreeRowRightTapped" DoubleTapped="OnTreeRowDoubleTapped">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" MinWidth="220" />
                                                <ColumnDefinition Width="105" />
                                                <ColumnDefinition Width="85" />
                                                <ColumnDefinition Width="85" />
                                                <ColumnDefinition Width="70" />
                                                <ColumnDefinition Width="70" />
                                                <ColumnDefinition Width="65" />
                                                <ColumnDefinition Width="120" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Indented Expander + Folder Icon + Name -->
                                            <Grid Margin="{x:Bind IndentThickness}" ColumnSpacing="6" VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid Width="20" Height="20" VerticalAlignment="Center">
                                                    <Button
                                                        Width="20"
                                                        Height="20"
                                                        Padding="0"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Visibility="{x:Bind HasChildrenVisibility}"
                                                        Click="OnTreeNodeExpanderClick">
                                                        <FontIcon Glyph="{x:Bind ExpanderGlyph, Mode=OneWay}" FontSize="10" Foreground="{ThemeResource GwTextMutedBrush}" />
                                                    </Button>
                                                </Grid>

                                                <FontIcon Grid.Column="1" Glyph="{x:Bind NodeGlyph}" FontSize="14" Foreground="{x:Bind NodeGlyphColor}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Text="{x:Bind Name}" FontWeight="Medium" Foreground="{ThemeResource GwTextPrimaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            </Grid>

                                            <!-- % of Drive Mini Bar -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <ProgressBar Value="{x:Bind PercentOfDrive}" Maximum="100" Width="55" Height="5" CornerRadius="2" Foreground="{ThemeResource GwAccentBrush}" VerticalAlignment="Center" />
                                                <TextBlock Text="{x:Bind PercentLabel}" FontSize="11" Foreground="{ThemeResource GwTextSecondaryBrush}" VerticalAlignment="Center" />
                                            </StackPanel>

                                            <!-- Formatted Size -->
                                            <TextBlock Grid.Column="2" Text="{x:Bind FormattedSize}" FontWeight="SemiBold" Foreground="{ThemeResource GwAccentBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" />

                                            <!-- Allocated Size -->
                                            <TextBlock Grid.Column="3" Text="{x:Bind FormattedAllocated}" FontSize="11" Foreground="{ThemeResource GwTextSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" />

                                            <!-- Files Count -->
                                            <TextBlock Grid.Column="4" Text="{x:Bind FilesCountFormatted}" FontSize="11" Foreground="{ThemeResource GwTextMutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" />

                                            <!-- Folders Count -->
                                            <TextBlock Grid.Column="5" Text="{x:Bind FoldersCountFormatted}" FontSize="11" Foreground="{ThemeResource GwTextMutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" />

                                            <!-- Attributes -->
                                            <TextBlock Grid.Column="6" Text="{x:Bind Attributes}" FontSize="10" Foreground="{ThemeResource GwTextMutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />

                                            <!-- Last Modified -->
                                            <TextBlock Grid.Column="7" Text="{x:Bind LastModifiedFormatted}" FontSize="11" Foreground="{ThemeResource GwTextMutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>

                        <!-- ================= 3B. FILE VIEW (Flat Largest Files Table) ================= -->
                        <Grid x:Name="FileContentGrid" Grid.Row="1" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- File Table Column Header -->
                            <Border Grid.Row="0" Background="{ThemeResource GwCardBackgroundHoverBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="0,0,0,1" Padding="12,7">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" MinWidth="180" />
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="65" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="3*" MinWidth="160" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="File Name ⬍" FontWeight="SemiBold" FontSize="11" Foreground="{ThemeResource GwTextPrimaryBrush}" PointerPressed="OnSortFileNameClick" />
                                    <TextBlock Grid.Column="1" Text="Ext ⬍" FontWeight="SemiBold" FontSize="11" Foreground="{ThemeResource GwTextSecondaryBrush}" PointerPressed="OnSortExtClick" />
                                    <TextBlock Grid.Column="2" Text="Type" FontWeight="SemiBold" FontSize="11" Foreground="{ThemeResource GwTextSecondaryBrush}" />
                                    <TextBlock Grid.Column="3" Text="% of Total" FontWeight="SemiBold" FontSize="11" Foreground="{ThemeResource GwTextSecondaryBrush}" />
                                    <TextBlock Grid.Column="4" Text="Size ⬍" FontWeight="SemiBold" FontSize="11" Foreground="{ThemeResource GwTextSecondaryBrush}" HorizontalAlignment="Right" PointerPressed="OnSortSizeClick" />
                                    <TextBlock Grid.Column="5" Text="Allocated" FontWeight="SemiBold" FontSize="11" Foreground="{ThemeResource GwTextSecondaryBrush}" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="6" Text="Attributes" FontWeight="SemiBold" FontSize="11" Foreground="{ThemeResource GwTextSecondaryBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Grid.Column="7" Text="Modified ⬍" FontWeight="SemiBold" FontSize="11" Foreground="{ThemeResource GwTextSecondaryBrush}" HorizontalAlignment="Right" PointerPressed="OnSortModifiedClick" />
                                    <TextBlock Grid.Column="8" Text="Folder Path" FontWeight="SemiBold" FontSize="11" Foreground="{ThemeResource GwTextSecondaryBrush}" />
                                </Grid>
                            </Border>

                            <!-- Virtualized File Table ListView -->
                            <ListView x:Name="StorageFileListView" Grid.Row="1" SelectionMode="Single" SelectionChanged="OnStorageFileSelectionChanged">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="Padding" Value="12,0,12,0" />
                                        <Setter Property="Margin" Value="0" />
                                        <Setter Property="MinHeight" Value="28" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:FileRowViewModel">
                                        <Grid Margin="0" Padding="0,3" ColumnSpacing="8" Background="Transparent" RightTapped="OnFileRowRightTapped" DoubleTapped="OnFileRowDoubleTapped">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*" MinWidth="180" />
                                                <ColumnDefinition Width="60" />
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="65" />
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="3*" MinWidth="160" />
                                            </Grid.ColumnDefinitions>

                                            <!-- File Icon + Name -->
                                            <Grid ColumnSpacing="6" VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <FontIcon Glyph="{x:Bind Glyph}" FontSize="14" Foreground="{x:Bind GlyphColor}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind Name}" FontWeight="Medium" Foreground="{ThemeResource GwTextPrimaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            </Grid>

                                            <!-- Extension -->
                                            <TextBlock Grid.Column="1" Text="{x:Bind Extension}" FontSize="11" Foreground="{ThemeResource GwTextSecondaryBrush}" VerticalAlignment="Center" />

                                            <!-- Type -->
                                            <TextBlock Grid.Column="2" Text="{x:Bind FileType}" FontSize="11" Foreground="{ThemeResource GwTextMutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                                            <!-- % Progress Bar -->
                                            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <ProgressBar Value="{x:Bind PercentOfTotal}" Maximum="100" Width="50" Height="5" CornerRadius="2" Foreground="{ThemeResource GwAccentBrush}" VerticalAlignment="Center" />
                                                <TextBlock Text="{x:Bind PercentLabel}" FontSize="11" Foreground="{ThemeResource GwTextSecondaryBrush}" VerticalAlignment="Center" />
                                            </StackPanel>

                                            <!-- Size -->
                                            <TextBlock Grid.Column="4" Text="{x:Bind FormattedSize}" FontWeight="SemiBold" Foreground="{ThemeResource GwAccentBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" />

                                            <!-- Allocated -->
                                            <TextBlock Grid.Column="5" Text="{x:Bind FormattedAllocated}" FontSize="11" Foreground="{ThemeResource GwTextSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" />

                                            <!-- Attributes -->
                                            <TextBlock Grid.Column="6" Text="{x:Bind Attributes}" FontSize="10" Foreground="{ThemeResource GwTextMutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />

                                            <!-- Modified -->
                                            <TextBlock Grid.Column="7" Text="{x:Bind LastModifiedFormatted}" FontSize="11" Foreground="{ThemeResource GwTextMutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" />

                                            <!-- Folder Path -->
                                            <TextBlock Grid.Column="8" Text="{x:Bind Folder}" FontSize="11" Foreground="{ThemeResource GwTextMutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Collapsed Legacy Summary & Inspector Controls (Preserves Code-Behind Data Binding Safely) -->
                <StackPanel Visibility="Collapsed">
                    <TextBlock x:Name="ScanSummaryHeaderText" />
                    <TextBlock x:Name="ScanMetricsDetailText" />
                    <ProgressBar x:Name="ScanActivityProgressBar" />
                    <TextBlock Text="{x:Bind SelectedMetadata.Name, Mode=OneWay}" />
                    <TextBlock Text="{x:Bind SelectedMetadata.FullPath, Mode=OneWay}" />
                    <TextBlock Text="{x:Bind SelectedMetadata.FormattedSize, Mode=OneWay}" />
                    <TextBlock Text="{x:Bind SelectedMetadata.ExactBytes, Mode=OneWay}" />
                    <TextBlock Text="{x:Bind SelectedMetadata.FormattedAllocated, Mode=OneWay}" />
                    <TextBlock Text="{x:Bind SelectedMetadata.ItemsSummary, Mode=OneWay}" />
                    <TextBlock Text="{x:Bind SelectedMetadata.Glyph, Mode=OneWay}" />
                    <TextBlock Text="{x:Bind SelectedMetadata.KindLabel, Mode=OneWay}" />
                    <TextBlock Text="{x:Bind SelectedMetadata.Attributes, Mode=OneWay}" />
                    <TextBlock Text="{x:Bind SelectedMetadata.LastModifiedDate, Mode=OneWay}" />
                    <TextBlock Text="{x:Bind SelectedMetadata.CreatedDate, Mode=OneWay}" />
                </StackPanel>
            </Grid>

            <!-- ======================================================== -->
            <!-- 2. STORAGE CLEANUP & RECOMMENDATIONS PANEL (STORAGE SENSE) -->
            <!-- ======================================================== -->
            <ScrollViewer x:Name="CleanupPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="16">
                    <!-- Storage Sense Hero Card -->
                    <Border Padding="16,14" CornerRadius="8" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                <Border Width="42" Height="42" CornerRadius="8" Background="{ThemeResource GwTealBgBrush}" BorderBrush="{ThemeResource GwTealBrush}" BorderThickness="1">
                                    <SymbolIcon Symbol="Delete" Foreground="{ThemeResource GwTealBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Storage Cleanup &amp; Recommendations" Style="{StaticResource GwPanelTitleStyle}" FontSize="18" />
                                    <TextBlock Text="Storage Sense recommendations: Instant, safe cleanup of temporary files, Recycle Bin, crash dumps, and caches." Style="{StaticResource GwPanelSubtitleStyle}" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <ComboBox x:Name="CleanupModeComboBox" SelectedIndex="0" Width="225" VerticalAlignment="Center">
                                    <ComboBoxItem Content="Move to Recycle Bin (Safe)" Tag="recycle" />
                                    <ComboBoxItem Content="Permanent Delete" Tag="permanent" />
                                </ComboBox>
                                <Button x:Name="RescanDiagnosticsButton" Style="{StaticResource GwSecondaryButtonStyle}" Click="OnPreloadCleanupClick" VerticalAlignment="Center" ToolTipService.ToolTip="Refresh storage recommendations">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <SymbolIcon Symbol="Refresh" />
                                        <TextBlock Text="Rescan" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="AnalyzeCleanupButton" Visibility="Collapsed" Click="OnRunCleanupScanClick" />
                                <Button x:Name="ReviewAndCleanButton" Content="Clean Selected Categories..." Style="{StaticResource GwPrimaryButtonStyle}" Padding="16,7" Click="OnReviewAndCleanSelectedClick" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Storage Sense Summary Banner -->
                    <Border Padding="16,12" CornerRadius="8" Background="{ThemeResource GwCardBackgroundHoverBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE74D;" FontSize="16" Foreground="{ThemeResource GwAccentBrush}" />
                                    <TextBlock Text="Total Reclaimable Space:" FontSize="13" Foreground="{ThemeResource GwTextSecondaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="CleanupTotalReclaimableText" Text="Calculating..." FontSize="20" FontWeight="Bold" Foreground="{ThemeResource GwAccentBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock x:Name="CleanupTotalReclaimableSubText" Text="Safe recommendations ready for removal across selected categories." FontSize="11" Foreground="{ThemeResource GwTextMutedBrush}" />
                                <TextBlock x:Name="CleanupSummaryBannerText" FontSize="11" Foreground="{ThemeResource GwTealBrush}" TextWrapping="Wrap" />
                                <ProgressBar x:Name="CleanupProgressBar" IsIndeterminate="True" Height="3" Visibility="Collapsed" CornerRadius="2" Foreground="{ThemeResource GwAccentBrush}" Margin="0,4,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button Content="Select Recommended" Style="{StaticResource GwSecondaryButtonStyle}" Padding="10,4" FontSize="11" Click="OnSelectRecommendedCategoriesClick" ToolTipService.ToolTip="Select safe categories (Recycle Bin, Temp, Crash Dumps)" />
                                <Button Content="Select All" Style="{StaticResource GwSecondaryButtonStyle}" Padding="10,4" FontSize="11" Click="OnSelectAllCategoriesClick" />
                                <Button Content="Deselect All" Style="{StaticResource GwSecondaryButtonStyle}" Padding="10,4" FontSize="11" Click="OnSelectNoneCategoriesClick" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Storage Sense Recommendation Cards -->
                    <ItemsControl x:Name="StorageSenseCardsControl" ItemsSource="{x:Bind StorageSenseCategories}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:StorageSenseCategoryCardViewModel">
                                <Border Margin="0,0,0,12" Padding="16,14" CornerRadius="8"
                                        Background="{ThemeResource GwCardBackgroundBrush}"
                                        BorderBrush="{ThemeResource GwCardBorderBrush}"
                                        BorderThickness="1">
                                    <StackPanel Spacing="10">
                                        <!-- Main Category Card Row -->
                                        <Grid ColumnSpacing="14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="42" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Checkbox to select/deselect category -->
                                            <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                                      VerticalAlignment="Center" Margin="0,0,4,0" />

                                            <!-- Category Icon -->
                                            <Border Grid.Column="1" Width="38" Height="38" CornerRadius="8"
                                                    Background="{x:Bind GlyphBg}"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <FontIcon Glyph="{x:Bind Glyph}" FontSize="18"
                                                          Foreground="{x:Bind GlyphColor}"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>

                                            <!-- Details: Title, Location Badge, Description -->
                                            <StackPanel Grid.Column="2" Spacing="3" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind Title}" FontSize="14" FontWeight="SemiBold"
                                                               Foreground="{ThemeResource GwTextPrimaryBrush}" />
                                                    <Border Padding="6,1" CornerRadius="4"
                                                            Background="{ThemeResource GwCardBackgroundHoverBrush}"
                                                            BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                                                        <TextBlock Text="{x:Bind LocationDisplay}" FontSize="10" FontFamily="Consolas"
                                                                   Foreground="{ThemeResource GwTealBrush}" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{x:Bind Description}" FontSize="12"
                                                           Foreground="{ThemeResource GwTextSecondaryBrush}" TextWrapping="Wrap" />
                                                <TextBlock Text="{x:Bind CountSummary}" FontSize="11"
                                                           Foreground="{ThemeResource GwTextMutedBrush}" />
                                            </StackPanel>

                                            <!-- Quick Action Button (e.g. Empty Bin) -->
                                            <Button Grid.Column="3" Content="{x:Bind QuickActionText}"
                                                    Visibility="{x:Bind QuickActionVisibility}"
                                                    Style="{StaticResource GwSecondaryButtonStyle}"
                                                    FontSize="11" Padding="10,4"
                                                    Click="OnCategoryQuickActionClick"
                                                    VerticalAlignment="Center" Margin="0,0,8,0" />

                                            <!-- Formatted Size & Drawer Expand Toggle -->
                                            <StackPanel Grid.Column="4" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="4">
                                                <TextBlock Text="{x:Bind FormattedSize}" FontSize="17" FontWeight="Bold"
                                                           Foreground="{ThemeResource GwAccentBrush}" HorizontalAlignment="Right" />
                                                <Button Content="{x:Bind ExpandToggleText, Mode=OneWay}"
                                                        Visibility="{x:Bind HasItemsVisibility}"
                                                        Style="{StaticResource GwSecondaryButtonStyle}"
                                                        FontSize="11" Padding="8,3"
                                                        Click="OnToggleCategoryExpandClick"
                                                        HorizontalAlignment="Right" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- Expandable File Details Drawer -->
                                        <Border Visibility="{x:Bind DetailsVisibility, Mode=OneWay}"
                                                Margin="48,4,0,0" Padding="12,10" CornerRadius="6"
                                                Background="{ThemeResource GwCardBackgroundHoverBrush}"
                                                BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                                            <StackPanel Spacing="8">
                                                <TextBlock Text="Files in this category:" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{ThemeResource GwTextSecondaryBrush}" />
                                                <ListView ItemsSource="{x:Bind Items}" SelectionMode="None" MaxHeight="220">
                                                    <ListView.ItemTemplate>
                                                        <DataTemplate x:DataType="local:CleanupCandidateRowViewModel">
                                                            <Grid Padding="4,3" ColumnSpacing="10">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}" VerticalAlignment="Center" />
                                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                    <TextBlock Text="{x:Bind Name}" FontSize="12" FontWeight="Medium"
                                                                               Foreground="{ThemeResource GwTextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Text="{x:Bind DisplayPath}" FontSize="10"
                                                                               Foreground="{ThemeResource GwTextMutedBrush}" TextTrimming="CharacterEllipsis" />
                                                                </StackPanel>
                                                                <TextBlock Grid.Column="2" Text="{x:Bind FormattedSize}" FontSize="11"
                                                                           FontWeight="SemiBold" Foreground="{ThemeResource GwAccentBrush}"
                                                                           VerticalAlignment="Center" HorizontalAlignment="Right" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ListView.ItemTemplate>
                                                </ListView>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Collapsed Legacy Controls to preserve code-behind API compatibility -->
                    <Grid Visibility="Collapsed">
                        <TextBlock x:Name="CleanupRecycleBinText" />
                        <TextBlock x:Name="CleanupRecycleBinSubText" />
                        <TextBlock x:Name="CleanupTempFilesText" />
                        <TextBlock x:Name="CleanupTempFilesSubText" />
                        <TextBlock x:Name="CleanupDuplicatesText" />
                        <TextBlock x:Name="CleanupDuplicatesSubText" />
                        <Button x:Name="EmptyRecycleBinButton" Click="OnEmptyRecycleBinClick" />
                        <ListView x:Name="CleanupCandidatesListView" />
                        <ListView x:Name="DuplicateGroupsListView" />
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- ======================================================== -->
            <!-- 3. INSTALLED APPS & LEFTOVERS PANEL -->
            <!-- ======================================================== -->
            <Grid x:Name="AppsPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Header & Search Filter -->
                <Border Grid.Row="0" Margin="0,0,0,12" Padding="14,12" CornerRadius="8" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <Border Width="38" Height="38" CornerRadius="7" Background="{ThemeResource GwTealBgBrush}" BorderBrush="{ThemeResource GwTealBrush}" BorderThickness="1">
                                <SymbolIcon Symbol="AllApps" Foreground="{ThemeResource GwTealBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Spacing="2">
                                <TextBlock Text="Installed Applications, Uninstaller &amp; Leftovers" Style="{StaticResource GwPanelTitleStyle}" FontSize="17" />
                                <TextBlock Text="Two-step guided uninstall: monitors process exit code, then scans AppData, ProgramData and Registry for leftovers." Style="{StaticResource GwPanelSubtitleStyle}" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <TextBox x:Name="AppSearchFilterBox" PlaceholderText="Search applications or publishers..." MinWidth="180" MaxWidth="320" TextChanged="OnAppFilterTextChanged" VerticalAlignment="Center" />
                            <Button x:Name="RefreshAppsButton" Content="Refresh Apps" Style="{StaticResource GwSecondaryButtonStyle}" Click="OnRefreshInstalledAppsClick" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Two-Column Layout: Left = App Grid, Right = 2-Step Workflow & Leftovers -->
                <Grid Grid.Row="1" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.25*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <!-- Apps Grid -->
                    <Border Grid.Column="0" Padding="16,14" CornerRadius="8" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="InstalledAppsCountText" Text="Installed Applications" FontWeight="SemiBold" FontSize="14" Foreground="{ThemeResource GwTextPrimaryBrush}" Margin="0,0,0,6" />
                            <ProgressBar Grid.Row="1" x:Name="AppsProgressBar" IsIndeterminate="True" Height="3" Visibility="Collapsed" Margin="0,0,0,8" CornerRadius="2" Foreground="{ThemeResource GwAccentBrush}" />
                            <ListView x:Name="InstalledAppsListView" Grid.Row="2" SelectionMode="Single" SelectionChanged="OnInstalledAppSelectionChanged">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:InstalledAppRowViewModel">
                                        <Border Padding="8,7" Margin="0,2" CornerRadius="5" Background="{ThemeResource GwCardBackgroundHoverBrush}">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="28" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="100" />
                                                    <ColumnDefinition Width="90" />
                                                </Grid.ColumnDefinitions>
                                                <!-- Genuine Windows Application Icon with Fallback -->
                                                <Grid Width="24" Height="24" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                    <FontIcon Glyph="&#xE71D;" FontSize="18" Foreground="{ThemeResource GwAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    <Image Source="{x:Bind AppIcon, Mode=OneTime}" Width="24" Height="24" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Grid>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{x:Bind Publisher}" FontSize="11" Foreground="{ThemeResource GwTextMutedBrush}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{x:Bind Version}" FontSize="11" Foreground="{ThemeResource GwTextSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="3" Text="{x:Bind FormattedSize}" FontWeight="SemiBold" Foreground="{ThemeResource GwAccentBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>

                    <!-- 2-Step Guided Workflow & Leftovers Inspector -->
                    <Border Grid.Column="1" Padding="16,14" CornerRadius="8" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="Guided Uninstallation &amp; Leftover Traces" FontWeight="SemiBold" FontSize="14" Foreground="{ThemeResource GwTextPrimaryBrush}" Margin="0,0,0,8" />

                            <!-- Action Card -->
                            <Border Grid.Row="1" Margin="0,0,0,12" Padding="12,10" CornerRadius="6" Background="{ThemeResource GwCardBackgroundHoverBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="Application Uninstaller" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource GwTextPrimaryBrush}" />
                                        <TextBlock Text="Launches the official uninstaller and automatically identifies leftovers." FontSize="11" Foreground="{ThemeResource GwTextSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Uninstall Selected App..." Style="{StaticResource GwPrimaryButtonStyle}" Click="OnUninstallSelectedAppClick" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <!-- Leftovers List -->
                            <Grid Grid.Row="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="LeftoversSummaryText" Text="Select an application on the left to inspect leftover directories and registry entries." FontSize="11" Foreground="{ThemeResource GwTextSecondaryBrush}" Margin="0,0,0,6" TextWrapping="Wrap" />
                                <ListView x:Name="LeftoversListView" Grid.Row="1" SelectionMode="Multiple">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="local:LeftoverItemRowViewModel">
                                            <Border Padding="6,5" Margin="0,2" CornerRadius="4" Background="{ThemeResource GwCardBackgroundHoverBrush}">
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="80" />
                                                        <ColumnDefinition Width="75" />
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}" VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Bind Name}" FontWeight="Medium" FontSize="12" Foreground="{ThemeResource GwTextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{x:Bind FullPath}" FontSize="10" Foreground="{ThemeResource GwTextMutedBrush}" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="{x:Bind Confidence}" FontSize="10" Foreground="{ThemeResource GwTextSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                                    <TextBlock Grid.Column="3" Text="{x:Bind FormattedSize}" FontWeight="SemiBold" FontSize="11" Foreground="{ThemeResource GwAccentBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>

                            <!-- Clean Selected Leftovers Button -->
                            <Button Grid.Row="3" Margin="0,10,0,0" Content="Safe Clean Selected Leftovers (Recycle Bin)" Style="{StaticResource GwPrimaryButtonStyle}" HorizontalAlignment="Stretch" Click="OnCleanSelectedLeftoversClick" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- ======================================================== -->
            <!-- 3.5 HARDWARE & SYSTEM SPECS PANEL -->
            <!-- ======================================================== -->
            <ScrollViewer x:Name="HardwarePanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="16" MaxWidth="1080" HorizontalAlignment="Stretch">

                    <!-- Header Banner -->
                    <Border Padding="16,14" CornerRadius="8" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                <Border Width="40" Height="40" CornerRadius="7" Background="{ThemeResource GwAccentBgBrush}" BorderBrush="{ThemeResource GwAccentBrush}" BorderThickness="1">
                                    <FontIcon Glyph="&#xE7F8;" FontSize="18" Foreground="{ThemeResource GwAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Hardware Specifications &amp; Diagnostics" Style="{StaticResource GwPanelTitleStyle}" FontSize="17" />
                                    <TextBlock Text="Comprehensive hardware inventory, live component topology, and signed driver status." Style="{StaticResource GwPanelSubtitleStyle}" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <ProgressBar x:Name="HardwareProgressBar" IsIndeterminate="True" Width="80" Height="4" Visibility="Collapsed" VerticalAlignment="Center" Foreground="{ThemeResource GwAccentBrush}" />
                                <Button Style="{StaticResource GwSecondaryButtonStyle}" Click="OnRefreshHardwareClick">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <SymbolIcon Symbol="Refresh" />
                                        <TextBlock Text="Refresh Specs" />
                                    </StackPanel>
                                </Button>
                                <Button Content="Copy Specs" Style="{StaticResource GwSecondaryButtonStyle}" Click="OnCopyHardwareSummaryClick" ToolTipService.ToolTip="Copy system specs summary to clipboard" />
                                <Button Content="Export Report" Style="{StaticResource GwPrimaryButtonStyle}" Click="OnExportHardwareReportClick" ToolTipService.ToolTip="Export detailed diagnostic report to .txt file" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Key System KPI Ribbon (4 Hero Tiles: CPU, GPU, RAM, OS/Uptime) -->
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- CPU Hero Tile -->
                        <Border Grid.Column="0" Padding="14,12" CornerRadius="8" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Border Width="28" Height="28" CornerRadius="5" Background="{ThemeResource GwAccentBgBrush}" BorderBrush="{ThemeResource GwAccentBrush}" BorderThickness="1">
                                        <FontIcon Glyph="&#xE950;" FontSize="14" Foreground="{ThemeResource GwAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="PROCESSOR" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource GwTextMutedBrush}" />
                                </StackPanel>
                                <TextBlock x:Name="HwCpuTitleText" Text="Loading..." FontSize="15" FontWeight="Bold" Foreground="{ThemeResource GwTextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="HwCpuSubText" Text="" FontSize="11" Foreground="{ThemeResource GwAccentBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>

                        <!-- GPU Hero Tile -->
                        <Border Grid.Column="1" Padding="14,12" CornerRadius="8" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Border Width="28" Height="28" CornerRadius="5" Background="{ThemeResource GwTealBgBrush}" BorderBrush="{ThemeResource GwTealBrush}" BorderThickness="1">
                                        <FontIcon Glyph="&#xE7F4;" FontSize="14" Foreground="{ThemeResource GwTealBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="GRAPHICS" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource GwTextMutedBrush}" />
                                </StackPanel>
                                <TextBlock x:Name="HwGpuTitleText" Text="Loading..." FontSize="15" FontWeight="Bold" Foreground="{ThemeResource GwTextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="HwGpuSubText" Text="" FontSize="11" Foreground="{ThemeResource GwTealBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>

                        <!-- RAM Hero Tile -->
                        <Border Grid.Column="2" Padding="14,12" CornerRadius="8" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Border Width="28" Height="28" CornerRadius="5" Background="{ThemeResource GwPurpleBgBrush}" BorderBrush="{ThemeResource GwPurpleBrush}" BorderThickness="1">
                                        <FontIcon Glyph="&#xE770;" FontSize="14" Foreground="{ThemeResource GwPurpleBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="SYSTEM MEMORY" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource GwTextMutedBrush}" />
                                </StackPanel>
                                <TextBlock x:Name="HwRamTitleText" Text="Loading..." FontSize="15" FontWeight="Bold" Foreground="{ThemeResource GwTextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="HwRamSubText" Text="" FontSize="11" Foreground="{ThemeResource GwPurpleBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>

                        <!-- OS / Uptime Hero Tile -->
                        <Border Grid.Column="3" Padding="14,12" CornerRadius="8" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Border Width="28" Height="28" CornerRadius="5" Background="{ThemeResource GwAmberBgBrush}" BorderBrush="{ThemeResource GwAmberBrush}" BorderThickness="1">
                                        <FontIcon Glyph="&#xE700;" FontSize="14" Foreground="{ThemeResource GwAmberBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="PLATFORM" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource GwTextMutedBrush}" />
                                </StackPanel>
                                <TextBlock x:Name="HwOsTitleText" Text="Loading..." FontSize="15" FontWeight="Bold" Foreground="{ThemeResource GwTextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="HwOsSubText" Text="" FontSize="11" Foreground="{ThemeResource GwAmberBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Row 1: Processor Specs Card & Motherboard/BIOS Card -->
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Processor Details -->
                        <Border Grid.Column="0" Padding="16,14" CornerRadius="8" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                            <StackPanel Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE950;" FontSize="15" Foreground="{ThemeResource GwAccentBrush}" />
                                    <TextBlock Text="Central Processor (CPU Specs)" Style="{StaticResource GwCardTitleStyle}" />
                                </StackPanel>

                                <Grid RowSpacing="8" ColumnSpacing="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Processor Model" FontSize="12" Foreground="{ThemeResource GwTextSecondaryBrush}" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="HwCpuModelVal" Text="-" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" TextWrapping="Wrap" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Cores / Threads" FontSize="12" Foreground="{ThemeResource GwTextSecondaryBrush}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="HwCpuCoresVal" Text="-" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Max Frequency" FontSize="12" Foreground="{ThemeResource GwTextSecondaryBrush}" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="HwCpuClockVal" Text="-" FontWeight="SemiBold" Foreground="{ThemeResource GwAccentBrush}" />

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Socket / Package" FontSize="12" Foreground="{ThemeResource GwTextSecondaryBrush}" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="HwCpuSocketVal" Text="-" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" />

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Caches &amp; Virt" FontSize="12" Foreground="{ThemeResource GwTextSecondaryBrush}" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" x:Name="HwCpuCacheVal" Text="-" FontWeight="SemiBold" Foreground="{ThemeResource GwTextSecondaryBrush}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Motherboard & BIOS Card -->
                        <Border Grid.Column="1" Padding="16,14" CornerRadius="8" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                            <StackPanel Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE770;" FontSize="15" Foreground="{ThemeResource GwTealBrush}" />
                                    <TextBlock Text="Motherboard &amp; BIOS Firmware" Style="{StaticResource GwCardTitleStyle}" />
                                </StackPanel>

                                <Grid RowSpacing="8" ColumnSpacing="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Manufacturer" FontSize="12" Foreground="{ThemeResource GwTextSecondaryBrush}" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="HwMoboMfgVal" Text="-" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Board Model" FontSize="12" Foreground="{ThemeResource GwTextSecondaryBrush}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="HwMoboModelVal" Text="-" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Serial Number" FontSize="12" Foreground="{ThemeResource GwTextSecondaryBrush}" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="HwMoboSerialVal" Text="-" FontWeight="SemiBold" Foreground="{ThemeResource GwTextMutedBrush}" />

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="BIOS Version" FontSize="12" Foreground="{ThemeResource GwTextSecondaryBrush}" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="HwBiosVerVal" Text="-" FontWeight="SemiBold" Foreground="{ThemeResource GwTealBrush}" />

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Secure Boot Status" FontSize="12" Foreground="{ThemeResource GwTextSecondaryBrush}" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" x:Name="HwSecureBootVal" Text="-" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Row 2: Physical Disks & Memory Modules -->
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Physical Disks & Controllers -->
                        <Border Grid.Column="0" Padding="16,14" CornerRadius="8" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xEDA2;" FontSize="15" Foreground="{ThemeResource GwAccentBrush}" />
                                    <TextBlock Text="Physical Storage Disks &amp; Controllers" Style="{StaticResource GwCardTitleStyle}" />
                                </StackPanel>

                                <ListView x:Name="HardwareDisksListView" SelectionMode="None" MaxHeight="220">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="engineModels:PhysicalDiskSpecsInfo">
                                            <Border Padding="8,6" Margin="0,2" CornerRadius="5" Background="{ThemeResource GwCardBackgroundHoverBrush}">
                                                <Grid ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <FontIcon Glyph="&#xEDA2;" FontSize="15" Foreground="{ThemeResource GwAccentBrush}" VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Bind Model}" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource GwTextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{x:Bind MediaType}" FontSize="11" Foreground="{ThemeResource GwTextMutedBrush}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Bind FormattedSize}" FontWeight="Bold" FontSize="12" Foreground="{ThemeResource GwAccentBrush}" HorizontalAlignment="Right" />
                                                        <TextBlock Text="{x:Bind InterfaceType}" FontSize="10" Foreground="{ThemeResource GwTextSecondaryBrush}" HorizontalAlignment="Right" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Border>

                        <!-- Installed Memory DIMMs (SPD Topology) -->
                        <Border Grid.Column="1" Padding="16,14" CornerRadius="8" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE770;" FontSize="15" Foreground="{ThemeResource GwPurpleBrush}" />
                                    <TextBlock Text="Memory Modules (SPD Topology)" Style="{StaticResource GwCardTitleStyle}" />
                                </StackPanel>

                                <ListView x:Name="HardwareMemoryListView" SelectionMode="None" MaxHeight="220">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="engineModels:MemoryModuleInfo">
                                            <Border Padding="8,6" Margin="0,2" CornerRadius="5" Background="{ThemeResource GwCardBackgroundHoverBrush}">
                                                <Grid ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <FontIcon Glyph="&#xE770;" FontSize="14" Foreground="{ThemeResource GwPurpleBrush}" VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Bind BankLocator}" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource GwTextPrimaryBrush}" />
                                                        <TextBlock Text="{x:Bind PartNumber}" FontSize="11" Foreground="{ThemeResource GwTextMutedBrush}" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Bind FormattedCapacity}" FontWeight="Bold" FontSize="12" Foreground="{ThemeResource GwPurpleBrush}" HorizontalAlignment="Right" />
                                                        <TextBlock Text="{x:Bind FormattedSpeed}" FontSize="10" Foreground="{ThemeResource GwTextSecondaryBrush}" HorizontalAlignment="Right" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Row 3: Graphics (GPUs) & Network Interfaces -->
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Graphics Adapters List -->
                        <Border Grid.Column="0" Padding="16,14" CornerRadius="8" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE7F4;" FontSize="15" Foreground="{ThemeResource GwTealBrush}" />
                                    <TextBlock Text="Graphics Processors &amp; Displays" Style="{StaticResource GwCardTitleStyle}" />
                                </StackPanel>

                                <ListView x:Name="HardwareGpusListView" SelectionMode="None" MaxHeight="220">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="engineModels:GpuSpecsInfo">
                                            <Border Padding="8,6" Margin="0,2" CornerRadius="5" Background="{ThemeResource GwCardBackgroundHoverBrush}">
                                                <Grid ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <FontIcon Glyph="&#xE7F4;" FontSize="15" Foreground="{ThemeResource GwTealBrush}" VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource GwTextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{x:Bind DriverVersion}" FontSize="10" Foreground="{ThemeResource GwTextMutedBrush}" />
                                                        <TextBlock Text="{x:Bind ResolutionAndRefreshRate}" FontSize="11" Foreground="{ThemeResource GwTextSecondaryBrush}" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="{x:Bind FormattedDedicatedMemory}" FontWeight="Bold" FontSize="11" Foreground="{ThemeResource GwTealBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Border>

                        <!-- Network Adapters List -->
                        <Border Grid.Column="1" Padding="16,14" CornerRadius="8" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE839;" FontSize="15" Foreground="{ThemeResource GwAmberBrush}" />
                                    <TextBlock Text="Network Adapters &amp; Interfaces" Style="{StaticResource GwCardTitleStyle}" />
                                </StackPanel>

                                <ListView x:Name="HardwareNetworkListView" SelectionMode="None" MaxHeight="220">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="engineModels:NetworkAdapterSpecsInfo">
                                            <Border Padding="8,6" Margin="0,2" CornerRadius="5" Background="{ThemeResource GwCardBackgroundHoverBrush}">
                                                <Grid ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <FontIcon Glyph="&#xE839;" FontSize="14" Foreground="{ThemeResource GwAmberBrush}" VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource GwTextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{x:Bind MacAddress}" FontSize="10" Foreground="{ThemeResource GwTextMutedBrush}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Bind FormattedSpeed}" FontWeight="Bold" FontSize="11" Foreground="{ThemeResource GwAmberBrush}" HorizontalAlignment="Right" />
                                                        <TextBlock Text="{x:Bind Status}" FontSize="10" Foreground="{ThemeResource GwTextSecondaryBrush}" HorizontalAlignment="Right" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Row 4: Verified Hardware Drivers Inventory -->
                    <Border Padding="16,14" CornerRadius="8" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                        <StackPanel Spacing="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE770;" FontSize="15" Foreground="{ThemeResource GwAccentBrush}" />
                                    <TextBlock Text="Verified Signed Hardware Drivers" Style="{StaticResource GwCardTitleStyle}" />
                                </StackPanel>
                                <TextBlock x:Name="HardwareDriversCountText" Grid.Column="1" Text="0 drivers verified" FontSize="12" Foreground="{ThemeResource GwTextMutedBrush}" VerticalAlignment="Center" />
                            </Grid>

                            <ListView x:Name="HardwareDriversListView" SelectionMode="None" MaxHeight="280">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:HardwareDriverRowViewModel">
                                        <Border Padding="8,5" Margin="0,2" CornerRadius="5" Background="{ThemeResource GwCardBackgroundHoverBrush}">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="90" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="130" />
                                                    <ColumnDefinition Width="110" />
                                                    <ColumnDefinition Width="90" />
                                                </Grid.ColumnDefinitions>
                                                <Border Padding="6,1" CornerRadius="3" Background="{ThemeResource GwPageBackgroundBrush}" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind DeviceClass}" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource GwAccentBrush}" />
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{x:Bind DeviceName}" FontWeight="Medium" FontSize="12" Foreground="{ThemeResource GwTextPrimaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Text="{x:Bind Manufacturer}" FontSize="11" Foreground="{ThemeResource GwTextSecondaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="3" Text="{x:Bind DriverVersion}" FontSize="11" Foreground="{ThemeResource GwTextMutedBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="4" Text="{x:Bind DriverDate}" FontSize="11" Foreground="{ThemeResource GwTextMutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- ======================================================== -->
            <!-- 4. AGENTIC AI ASSISTANT & SEARCH PANEL -->
            <!-- ======================================================== -->
            <ScrollViewer x:Name="AssistantPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="16,14">
                <StackPanel Spacing="16" MaxWidth="1100" HorizontalAlignment="Stretch">
                    
                    <!-- 1. Header Card (Agent Identity & Active Provider Status) -->
                    <Border Padding="16,12" CornerRadius="8" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                <Border Width="40" Height="40" CornerRadius="7" Background="{ThemeResource GwPurpleBgBrush}" BorderBrush="{ThemeResource GwPurpleBrush}" BorderThickness="1">
                                    <FontIcon Glyph="&#xE946;" FontSize="18" Foreground="{ThemeResource GwPurpleBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Groundwork Agent" Style="{StaticResource GwPanelTitleStyle}" FontSize="17" />
                                    <TextBlock Text="Natural language disk queries, game &amp; software locator, and storage diagnosis powered by on-device and cloud LLMs." Style="{StaticResource GwPanelSubtitleStyle}" />
                                </StackPanel>
                            </StackPanel>

                            <Border Grid.Column="1" Padding="10,6" CornerRadius="6" Background="{ThemeResource GwPurpleBgBrush}" BorderBrush="{ThemeResource GwPurpleBrush}" BorderThickness="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Ellipse Width="8" Height="8" Fill="{ThemeResource GwTealBrush}" />
                                    <TextBlock x:Name="AssistantProviderBadge" Text="Setup Required" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource GwPurpleBrush}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- PROVIDER SETUP REQUIRED HERO CARD (Visible if no provider configured) -->
                        <StackPanel x:Name="AgentProviderSetupRequiredGrid" Visibility="Visible" Spacing="16">
                            <Border Padding="28,24" CornerRadius="10" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                                <StackPanel Spacing="18" HorizontalAlignment="Center" MaxWidth="860">
                                    <StackPanel Orientation="Horizontal" Spacing="14" HorizontalAlignment="Center">
                                        <Border Width="48" Height="48" CornerRadius="10" Background="{ThemeResource GwPurpleBgBrush}" BorderBrush="{ThemeResource GwPurpleBrush}" BorderThickness="1">
                                            <FontIcon Glyph="&#xE946;" FontSize="24" Foreground="{ThemeResource GwPurpleBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Text="AI Provider Setup Required" FontSize="20" FontWeight="Bold" Foreground="{ThemeResource GwTextPrimaryBrush}" />
                                            <TextBlock Text="Connect a local or cloud AI provider to activate the Groundwork Agent" FontSize="13" Foreground="{ThemeResource GwTextSecondaryBrush}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <TextBlock Text="To ensure genuine reasoning and eliminate fake or hardcoded answers, the Agent requires an active AI provider. Groundwork never runs background bloat—you choose whether to connect a 100% free offline on-device model or a cloud API." 
                                               FontSize="13" Foreground="{ThemeResource GwTextSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" LineHeight="20" />

                                    <Grid ColumnSpacing="12" Margin="0,6,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" MinWidth="180" />
                                            <ColumnDefinition Width="*" MinWidth="180" />
                                            <ColumnDefinition Width="*" MinWidth="180" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Local Ollama Card -->
                                        <Border Grid.Column="0" Padding="14,12" CornerRadius="8" Background="{ThemeResource GwCardBackgroundHoverBrush}" BorderBrush="{ThemeResource GwAccentBrush}" BorderThickness="1">
                                            <StackPanel Spacing="6">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon Glyph="&#xE7F4;" FontSize="16" Foreground="{ThemeResource GwAccentBrush}" />
                                                    <TextBlock Text="Local Ollama" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" />
                                                </StackPanel>
                                                <TextBlock Text="100% Free &amp; Private. Runs on-device via loopback (http://127.0.0.1:11434)." FontSize="11" Foreground="{ThemeResource GwTextMutedBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Cloud Gemini Card -->
                                        <Border Grid.Column="1" Padding="14,12" CornerRadius="8" Background="{ThemeResource GwTealBgBrush}" BorderBrush="{ThemeResource GwTealBrush}" BorderThickness="1">
                                            <StackPanel Spacing="6">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon Glyph="&#xE9CE;" FontSize="16" Foreground="{ThemeResource GwTealBrush}" />
                                                    <TextBlock Text="Google Gemini" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" />
                                                </StackPanel>
                                                <TextBlock Text="Generous free tier. Fast reasoning via Gemini API key from Google AI Studio." FontSize="11" Foreground="{ThemeResource GwTextMutedBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Cloud OpenAI Card -->
                                        <Border Grid.Column="2" Padding="14,12" CornerRadius="8" Background="{ThemeResource GwPurpleBgBrush}" BorderBrush="{ThemeResource GwPurpleBrush}" BorderThickness="1">
                                            <StackPanel Spacing="6">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon Glyph="&#xE72D;" FontSize="16" Foreground="{ThemeResource GwPurpleBrush}" />
                                                    <TextBlock Text="OpenAI" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" />
                                                </StackPanel>
                                                <TextBlock Text="GPT-4o &amp; modern reasoning models with your standard OpenAI API key." FontSize="11" Foreground="{ThemeResource GwTextMutedBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <Button Style="{StaticResource GwPrimaryButtonStyle}" Padding="20,10" HorizontalAlignment="Center" Click="OnConfigureProviderFromAgentClick">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <SymbolIcon Symbol="Setting" />
                                            <TextBlock Text="Configure AI Provider in Settings" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- AGENT ACTIVE CONTENT PANEL (Only visible when provider is configured) -->
                        <StackPanel x:Name="AgentActiveContentPanel" Visibility="Collapsed" Spacing="16">

                        <!-- 2. Interactive Input Bar -->
                        <Border Padding="14,12" CornerRadius="8" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="AssistantQuestionBox" PlaceholderText="Ask the agent: e.g. Where is my Trails in the Sky game located? or Find all videos over 500 MB..." VerticalAlignment="Center" KeyDown="OnAssistantQuestionBoxKeyDown" />
                                <Button x:Name="AssistantAnalyzeButton" Grid.Column="1" Style="{StaticResource GwPrimaryButtonStyle}" Click="OnAskOperatorClick" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <SymbolIcon Symbol="Find" />
                                        <TextBlock Text="Ask Agent" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- 3. VIEW MODE A: STANDBY PROMPT CARDS (Visible before a question is asked) -->
                        <StackPanel x:Name="AssistantStandbyGrid" Visibility="Visible" Spacing="14">
                            <TextBlock Text="What would you like the agent to do?" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" />
                            
                            <Grid RowSpacing="10" ColumnSpacing="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Prompt 1: Game / Software Locator -->
                                <Button Grid.Row="0" Grid.Column="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="14,12" CornerRadius="8" Style="{StaticResource GwSecondaryButtonStyle}" Click="OnOperatorPromptPresetClick" Tag="Where is my game located?">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="34" Height="34" CornerRadius="6" Background="{ThemeResource GwPurpleBgBrush}" BorderBrush="{ThemeResource GwPurpleBrush}" BorderThickness="1" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE7FC;" FontSize="16" Foreground="{ThemeResource GwPurpleBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="Locate Installed Games &amp; Software" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" TextWrapping="Wrap" />
                                            <TextBlock Text="Find folder paths for Steam, GOG, Epic, or desktop games" FontSize="11" Foreground="{ThemeResource GwTextMutedBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </Button>

                                <!-- Prompt 2: Heavy Applications -->
                                <Button Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="14,12" CornerRadius="8" Style="{StaticResource GwSecondaryButtonStyle}" Click="OnOperatorPromptPresetClick" Tag="Which installed applications take the most space?">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="34" Height="34" CornerRadius="6" Background="{ThemeResource GwPurpleBgBrush}" BorderBrush="{ThemeResource GwPurpleBrush}" BorderThickness="1" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE71D;" FontSize="16" Foreground="{ThemeResource GwPurpleBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="Audit Heavy Installed Applications" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" TextWrapping="Wrap" />
                                            <TextBlock Text="Identify largest software suites and inspect leftover traces" FontSize="11" Foreground="{ThemeResource GwTextMutedBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </Button>

                                <!-- Prompt 3: Developer Build Caches -->
                                <Button Grid.Row="1" Grid.Column="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="14,12" CornerRadius="8" Style="{StaticResource GwSecondaryButtonStyle}" Click="OnOperatorPromptPresetClick" Tag="Find heavy developer build caches like node_modules, bin/obj, and venv">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="34" Height="34" CornerRadius="6" Background="{ThemeResource GwCardBackgroundHoverBrush}" BorderBrush="{ThemeResource GwAccentBrush}" BorderThickness="1" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE7BE;" FontSize="16" Foreground="{ThemeResource GwAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="Hunt Developer Build Caches" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" TextWrapping="Wrap" />
                                            <TextBlock Text="Locate and clean node_modules, bin, obj, and venv trees" FontSize="11" Foreground="{ThemeResource GwTextMutedBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </Button>

                                <!-- Prompt 4: Large Media & ISOs -->
                                <Button Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="14,12" CornerRadius="8" Style="{StaticResource GwSecondaryButtonStyle}" Click="OnOperatorPromptPresetClick" Tag="Find all large videos and media over 500 MB">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="34" Height="34" CornerRadius="6" Background="{ThemeResource GwAmberBgBrush}" BorderBrush="{ThemeResource GwAmberBrush}" BorderThickness="1" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE714;" FontSize="16" Foreground="{ThemeResource GwAmberBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="Find Large Videos &amp; Media (> 500 MB)" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" TextWrapping="Wrap" />
                                            <TextBlock Text="Isolate heavy movies, recordings, archives, and disk images" FontSize="11" Foreground="{ThemeResource GwTextMutedBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </Button>

                                <!-- Prompt 5: Duplicate Audit -->
                                <Button Grid.Row="2" Grid.Column="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="14,12" CornerRadius="8" Style="{StaticResource GwSecondaryButtonStyle}" Click="OnOperatorPromptPresetClick" Tag="Find duplicate files and summarize reclaimable waste">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="34" Height="34" CornerRadius="6" Background="{ThemeResource GwAmberBgBrush}" BorderBrush="{ThemeResource GwAmberBrush}" BorderThickness="1" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE74D;" FontSize="16" Foreground="{ThemeResource GwAmberBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="Audit Duplicate Files &amp; Waste" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" TextWrapping="Wrap" />
                                            <TextBlock Text="SHA-256 duplicate clusters safe to send to Recycle Bin" FontSize="11" Foreground="{ThemeResource GwTextMutedBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </Button>

                                <!-- Prompt 6: Drive Space Overview -->
                                <Button Grid.Row="2" Grid.Column="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="14,12" CornerRadius="8" Style="{StaticResource GwSecondaryButtonStyle}" Click="OnOperatorPromptPresetClick" Tag="What is taking up the most space on my drive?">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="34" Height="34" CornerRadius="6" Background="{ThemeResource GwTealBgBrush}" BorderBrush="{ThemeResource GwTealBrush}" BorderThickness="1" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xEDA2;" FontSize="16" Foreground="{ThemeResource GwTealBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="Analyze Drive Storage Hoggers" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" TextWrapping="Wrap" />
                                            <TextBlock Text="Identify the heaviest directories and space consumers" FontSize="11" Foreground="{ThemeResource GwTextMutedBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                        </Grid>
                    </StackPanel>

                    <!-- 4. VIEW MODE B: ACTIVE AGENT RESPONSE (Shown after query execution) -->
                    <StackPanel x:Name="AssistantResultsGrid" Visibility="Collapsed" Spacing="16">
                        
                        <!-- Query Context Header + New Query Button -->
                        <Border Padding="12,10" CornerRadius="6" Background="{ThemeResource GwCardBackgroundHoverBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock Text="Agent Query:" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource GwTextSecondaryBrush}" />
                                    <TextBlock x:Name="AssistantActiveQueryLabel" Text="" FontSize="12" FontWeight="Bold" Foreground="{ThemeResource GwAccentBrush}" TextTrimming="CharacterEllipsis" MaxWidth="600" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="New Query / Reset" Style="{StaticResource GwSecondaryButtonStyle}" Padding="10,4" FontSize="11" Click="OnResetAssistantQueryClick" />
                            </Grid>
                        </Border>

                        <!-- Dynamic Contextual KPI Cards -->
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Card 1 -->
                            <Border Grid.Column="0" Padding="14,12" CornerRadius="8" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                                <StackPanel Spacing="6">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Border Width="28" Height="28" CornerRadius="5" Background="{ThemeResource GwAccentBgBrush}" BorderBrush="{ThemeResource GwAccentBrush}" BorderThickness="1">
                                            <FontIcon x:Name="AssistantTargetKpiIcon" Glyph="&#xEDA2;" FontSize="14" Foreground="{ThemeResource GwAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock x:Name="AssistantTargetKpiTitle" Text="Matched Target" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource GwTextSecondaryBrush}" />
                                    </StackPanel>
                                    <TextBlock x:Name="AssistantTargetKpiValue" Text="-" FontSize="20" FontWeight="Bold" Foreground="{ThemeResource GwTextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="AssistantTargetKpiSub" Text="" FontSize="11" Foreground="{ThemeResource GwTextMutedBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>

                            <!-- Card 2 -->
                            <Border Grid.Column="1" Padding="14,12" CornerRadius="8" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                                <StackPanel Spacing="6">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Border Width="28" Height="28" CornerRadius="5" Background="{ThemeResource GwAmberBgBrush}" BorderBrush="{ThemeResource GwAmberBrush}" BorderThickness="1">
                                            <FontIcon x:Name="AssistantWasteKpiIcon" Glyph="&#xE74D;" FontSize="14" Foreground="{ThemeResource GwAmberBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock x:Name="AssistantWasteKpiTitle" Text="Allocated Space" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource GwTextSecondaryBrush}" />
                                    </StackPanel>
                                    <TextBlock x:Name="AssistantWasteKpiValue" Text="-" FontSize="20" FontWeight="Bold" Foreground="{ThemeResource GwAmberBrush}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="AssistantWasteKpiSub" Text="" FontSize="11" Foreground="{ThemeResource GwTextMutedBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>

                            <!-- Card 3 -->
                            <Border Grid.Column="2" Padding="14,12" CornerRadius="8" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                                <StackPanel Spacing="6">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Border Width="28" Height="28" CornerRadius="5" Background="{ThemeResource GwPurpleBgBrush}" BorderBrush="{ThemeResource GwPurpleBrush}" BorderThickness="1">
                                            <FontIcon x:Name="AssistantAppKpiIcon" Glyph="&#xE71D;" FontSize="14" Foreground="{ThemeResource GwPurpleBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock x:Name="AssistantAppKpiTitle" Text="Location Status" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource GwTextSecondaryBrush}" />
                                    </StackPanel>
                                    <TextBlock x:Name="AssistantAppKpiValue" Text="-" FontSize="20" FontWeight="Bold" Foreground="{ThemeResource GwTextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="AssistantAppKpiSub" Text="" FontSize="11" Foreground="{ThemeResource GwTextMutedBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Agent Analysis & Formatted Reasoning -->
                        <Border Padding="18,16" CornerRadius="8" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                            <StackPanel Spacing="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Border Width="26" Height="26" CornerRadius="5" Background="{ThemeResource GwPurpleBgBrush}" BorderBrush="{ThemeResource GwPurpleBrush}" BorderThickness="1">
                                            <FontIcon Glyph="&#xE946;" FontSize="13" Foreground="{ThemeResource GwPurpleBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="Agent Analysis &amp; Findings" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Copy Response" Style="{StaticResource GwSecondaryButtonStyle}" Padding="10,4" FontSize="11" Click="OnCopyAssistantResponseClick" ToolTipService.ToolTip="Copy response to clipboard" />
                                </Grid>

                                <!-- Rich Formatted Output Container -->
                                <RichTextBlock x:Name="AssistantAnswerRichBlock" IsTextSelectionEnabled="True" LineHeight="24" FontSize="13" Foreground="{ThemeResource GwTextPrimaryBrush}" />
                            </StackPanel>
                        </Border>

                        <!-- Actionable Recommendations -->
                        <StackPanel Spacing="10">
                            <TextBlock Text="Recommended Actions" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" />
                            
                            <ItemsControl x:Name="AssistantRecommendationsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,8" Padding="14,12" CornerRadius="8" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="6" Background="{ThemeResource GwCardBackgroundHoverBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1" VerticalAlignment="Center">
                                                    <FontIcon Glyph="{Binding IconGlyph}" FontSize="16" Foreground="{Binding IconColor}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" />
                                                    <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{ThemeResource GwTextSecondaryBrush}" TextWrapping="Wrap" />
                                                </StackPanel>

                                                <Button Grid.Column="2" Content="{Binding ActionButtonText}" Tag="{Binding ActionTag}" Style="{StaticResource GwPrimaryButtonStyle}" Click="OnAssistantActionClick" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Located Items & Culprits Table -->
                        <StackPanel Spacing="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Located Elements &amp; Artifacts" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" VerticalAlignment="Center" />
                                <TextBlock x:Name="AssistantItemsCountLabel" Grid.Column="1" Text="0 items detected" FontSize="12" Foreground="{ThemeResource GwTextMutedBrush}" VerticalAlignment="Center" />
                            </Grid>

                            <Border CornerRadius="8" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                                <ListView x:Name="AssistantItemsListView" SelectionMode="None" MaxHeight="380">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="10,8" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="0,0,0,1">
                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <Border Grid.Column="0" Width="32" Height="32" CornerRadius="6" Background="{ThemeResource GwCardBackgroundHoverBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1" VerticalAlignment="Center">
                                                        <FontIcon Glyph="{Binding Glyph}" FontSize="15" Foreground="{Binding GlyphColor}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>

                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding DisplayPath}" FontSize="11" Foreground="{ThemeResource GwTextMutedBrush}" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>

                                                    <Border Grid.Column="2" Padding="6,2" CornerRadius="4" Background="{Binding BadgeBackground}" VerticalAlignment="Center" Margin="8,0">
                                                        <TextBlock Text="{Binding CategoryBadge}" FontSize="10" FontWeight="SemiBold" Foreground="{Binding BadgeForeground}" />
                                                    </Border>

                                                    <TextBlock Grid.Column="3" Text="{Binding FormattedSize}" FontSize="13" FontWeight="Bold" Foreground="{ThemeResource GwAccentBrush}" VerticalAlignment="Center" MinWidth="70" TextAlignment="Right" />

                                                    <!-- Item Inline Explorer Button -->
                                                    <Button Grid.Column="4" Padding="6,4" ToolTipService.ToolTip="Open folder in File Explorer" Tag="{Binding FullPath}" Click="OnOpenItemInExplorerClick" Style="{StaticResource GwSecondaryButtonStyle}" VerticalAlignment="Center">
                                                        <SymbolIcon Symbol="OpenLocal" />
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Border>
                        </StackPanel>

                    </StackPanel>
                    <!-- End of AssistantResultsGrid -->

                    </StackPanel>
                    <!-- End of AgentActiveContentPanel -->

                </StackPanel>
            </ScrollViewer>

            <!-- ======================================================== -->
            <!-- 6. FILE ORGANIZATION PANEL -->
            <!-- ======================================================== -->
            <ScrollViewer x:Name="OrganizePanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="16">
                    <Border Padding="16,14" CornerRadius="8" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <Border Width="40" Height="40" CornerRadius="7" Background="{ThemeResource GwAmberBgBrush}" BorderBrush="{ThemeResource GwAmberBrush}" BorderThickness="1">
                                <SymbolIcon Symbol="Folder" Foreground="{ThemeResource GwAmberBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Spacing="2">
                                <TextBlock Text="Smart File Organizer &amp; Safe Undo" Style="{StaticResource GwPanelTitleStyle}" FontSize="17" />
                                <TextBlock Text="Cleanly sort and organize your files by category or date with one-click safe restore." Style="{StaticResource GwPanelSubtitleStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Padding="14,12" CornerRadius="8" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="OrganizeFolderBox" PlaceholderText="Folder path to preview organization..." VerticalAlignment="Center" />
                            <ComboBox x:Name="OrganizeRuleTypeComboBox" Grid.Column="1" SelectedIndex="0" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                <ComboBoxItem Content="By File Category" Tag="category" />
                                <ComboBoxItem Content="By Modified Month" Tag="date" />
                                <ComboBoxItem Content="By Extension" Tag="extension" />
                            </ComboBox>
                            <Button Grid.Column="2" Content="Preview Plan" Style="{StaticResource GwPrimaryButtonStyle}" Click="OnPreviewOrganizeClick" VerticalAlignment="Center" />
                            <Button Grid.Column="3" Content="Refresh History" Style="{StaticResource GwSecondaryButtonStyle}" Click="OnRefreshOrganizationHistoryClick" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <Border Padding="16,14" CornerRadius="8" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Organization Preview &amp; Undo History" Style="{StaticResource GwCardTitleStyle}" />
                            <TextBlock x:Name="OrganizationStatusText" Text="Select a target folder above to preview organization rules and safe stream-preserving undo history." Style="{StaticResource GwPanelSubtitleStyle}" />
                            <ListView x:Name="OrganizationHistoryListView" SelectionMode="None" MaxHeight="300" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ======================================================== -->
            <!-- 7. DEDICATED NATIVE SETTINGS PANEL (Power-User Engine Experience) -->
            <!-- ======================================================== -->
            <ScrollViewer x:Name="SettingsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="16" MaxWidth="1080" HorizontalAlignment="Stretch">
                    
                    <!-- Header Banner -->
                    <Border Padding="16,14" CornerRadius="8" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                <Border Width="40" Height="40" CornerRadius="7" Background="{ThemeResource GwCardBackgroundHoverBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                                    <SymbolIcon Symbol="Setting" Foreground="{ThemeResource GwAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Preferences &amp; Engine Configuration" Style="{StaticResource GwPanelTitleStyle}" FontSize="17" />
                                    <TextBlock Text="Configure scan workers and exclusions, cleanup confirmation, privacy, and AI providers." Style="{StaticResource GwPanelSubtitleStyle}" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock x:Name="SettingsSavedNoticeText" Text="" FontSize="12" Foreground="{ThemeResource GwSignalGreenBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <Button Content="Open AppData Folder" Style="{StaticResource GwSecondaryButtonStyle}" Click="OnOpenAppDataFolderClick" ToolTipService.ToolTip="Open Groundwork configuration directory in File Explorer" />
                                <Button Content="Reset Defaults" Style="{StaticResource GwSecondaryButtonStyle}" Click="OnResetSettingsClick" ToolTipService.ToolTip="Reset all settings to factory defaults" />
                                <Button Content="Save Preferences" Style="{StaticResource GwPrimaryButtonStyle}" Click="OnSaveSettingsClick" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Section 1: General & UI Appearance -->
                    <Border Padding="16,14" CornerRadius="8" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                        <StackPanel Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE790;" FontSize="15" Foreground="{ThemeResource GwAccentBrush}" />
                                <TextBlock Text="General &amp; Visual Appearance" Style="{StaticResource GwCardTitleStyle}" />
                            </StackPanel>

                            <Grid RowSpacing="12" ColumnSpacing="16">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <ComboBox x:Name="ThemeModeComboBox" Grid.Row="0" Grid.Column="0" Header="Visual Theme Palette" HorizontalAlignment="Stretch" SelectionChanged="OnThemeModeSelectionChanged">
                                    <ComboBoxItem Content="Light Theme (Modern Blue &amp; White) [Default]" Tag="Light" />
                                    <ComboBoxItem Content="Dark Theme (Control Room)" Tag="Dark" />
                                    <ComboBoxItem Content="Use Windows System Setting" Tag="System" />
                                </ComboBox>

                                <ComboBox x:Name="SizeUnitComboBox" Grid.Row="0" Grid.Column="1" Header="File Size Display Format" HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="Auto-Fit (B / KB / MB / GB / TB) [Default]" Tag="Auto" />
                                    <ComboBoxItem Content="Binary / IEC Standard (1024 base: KiB, MiB, GiB)" Tag="Binary" />
                                    <ComboBoxItem Content="Decimal / SI Standard (1000 base: KB, MB, GB)" Tag="Decimal" />
                                </ComboBox>

                                <ToggleSwitch x:Name="MaskSerialsToggle" Grid.Row="1" Grid.Column="0" Header="Mask hardware serial numbers in specs &amp; reports (Privacy Guard)" IsOn="True" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="Temperature readings are not available from a reliable, universal Windows sensor source." FontSize="12" Foreground="{ThemeResource GwTextSecondaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Section 2: Storage Scanner Engine & Concurrency -->
                    <Border Padding="16,14" CornerRadius="8" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                        <StackPanel Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xEDA2;" FontSize="15" Foreground="{ThemeResource GwTealBrush}" />
                                <TextBlock Text="Storage Scanner Engine &amp; Concurrency" Style="{StaticResource GwCardTitleStyle}" />
                            </StackPanel>

                            <Grid RowSpacing="12" ColumnSpacing="16">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBox x:Name="DefaultScanPathBox" Grid.Row="0" Grid.Column="0" Header="Default Scan Target Path" Text="C:\" />
                                <TextBox x:Name="ParallelThreadsBox" Grid.Row="0" Grid.Column="1" Header="Parallel Worker Threads (2 - 16)" Text="8" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Directory junctions and symbolic links are always skipped to avoid cycles and crossing volumes. No automatic elevation is performed." FontSize="12" Foreground="{ThemeResource GwTextSecondaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="Raw MFT parsing is not available in this build. Volume and folder analysis uses the Windows file enumerator." FontSize="12" Foreground="{ThemeResource GwTextSecondaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />

                                <TextBox x:Name="ExcludedPathsBox" Grid.Row="2" Grid.Column="0" Header="Global Excluded Paths (comma-separated)" Text="$Recycle.Bin,System Volume Information" />
                                <TextBox x:Name="ExcludedExtensionsBox" Grid.Row="2" Grid.Column="1" Header="Excluded File Extensions" Text=".tmp,.bak,.log" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Section 3: Cleanup Safety & Uninstaller Guards -->
                    <Border Padding="16,14" CornerRadius="8" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                        <StackPanel Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE74D;" FontSize="15" Foreground="{ThemeResource GwAmberBrush}" />
                                <TextBlock Text="Cleanup Safety &amp; Uninstaller Guards" Style="{StaticResource GwCardTitleStyle}" />
                            </StackPanel>

                            <Grid RowSpacing="12" ColumnSpacing="16">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <ToggleSwitch x:Name="ConfirmBeforeDeleteToggle" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Header="Require confirmation before cleanup (permanent delete and emptying Recycle Bin always require confirmation)" IsOn="True" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="Uninstallers are launched only after confirmation. Leftover locations are inspected with bounded, read-only matching; removal is a separate reviewed action." FontSize="12" Foreground="{ThemeResource GwTextSecondaryBrush}" TextWrapping="Wrap" />
                            </Grid>

                            <Border Padding="10,8" CornerRadius="6" Background="{ThemeResource GwCardBackgroundHoverBrush}">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE72E;" FontSize="13" Foreground="{ThemeResource GwTealBrush}" />
                                    <TextBlock Text="Protected System Paths: C:\Windows, C:\Program Files, System32, and root boot sectors are permanently guarded against deletion." FontSize="11" Foreground="{ThemeResource GwTextSecondaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Section 4: AI Agent Provider & Privacy -->
                    <Border Padding="16,14" CornerRadius="8" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                        <StackPanel Spacing="14">
                            <StackPanel Spacing="3">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE946;" FontSize="15" Foreground="{ThemeResource GwPurpleBrush}" />
                                    <TextBlock Text="AI Agent Provider &amp; Model Integration" Style="{StaticResource GwCardTitleStyle}" />
                                </StackPanel>
                                <TextBlock Text="Connect a 100% free offline on-device LLM (Ollama) or a cloud API (Google Gemini, OpenAI, Mistral) to power the Groundwork Agent. Web search is optional and off by default; turn it on in the Gemini or Mistral section for questions that need current information." FontSize="12" Foreground="{ThemeResource GwTextSecondaryBrush}" />
                            </StackPanel>

                            <ComboBox x:Name="SettingsAiProviderComboBox" Header="Active Intelligence Provider" Width="380" SelectionChanged="OnSettingsAiProviderSelectionChanged">
                                <ComboBoxItem Content="None (Require Setup)" Tag="none" />
                                <ComboBoxItem Content="Ollama (Local On-Device LLM - 100% Free &amp; Private)" Tag="ollama" />
                                <ComboBoxItem Content="Google Gemini (Cloud API - Fast Reasoning)" Tag="gemini" />
                                <ComboBoxItem Content="OpenAI (Cloud API - GPT-4o / GPT-4o-mini)" Tag="openai" />
                                <ComboBoxItem Content="Mistral (Cloud API - Optional Web Search)" Tag="mistral" />
                            </ComboBox>

                            <!-- Ollama Options -->
                            <StackPanel x:Name="SettingsOllamaPanel" Spacing="8" Visibility="Collapsed">
                                <TextBox x:Name="SettingsOllamaUrlBox" Header="Ollama Loopback URL" Text="http://127.0.0.1:11434" Width="440" HorizontalAlignment="Left" />
                                <TextBox x:Name="SettingsOllamaModelBox" Header="Model Name (e.g. llama3.3:latest, deepseek-r1:latest, qwen2.5:latest)" Text="llama3.3:latest" Width="440" HorizontalAlignment="Left" />
                                <StackPanel Spacing="6" Margin="0,4,0,0">
                                    <Button Content="Test &amp; Activate Ollama" Style="{StaticResource GwPrimaryButtonStyle}" Click="OnTestOllamaClick" HorizontalAlignment="Left" />
                                    <TextBlock x:Name="SettingsOllamaStatusText" Text="" FontSize="12" TextWrapping="Wrap" MaxWidth="560" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Gemini Options -->
                            <StackPanel x:Name="SettingsGeminiPanel" Spacing="8" Visibility="Collapsed">
                                <PasswordBox x:Name="SettingsGeminiApiKeyBox" Header="Gemini API Key" Width="440" HorizontalAlignment="Left" />
                                <TextBox x:Name="SettingsGeminiModelBox" Header="Gemini Model (e.g. gemini-3.5-flash-lite, gemini-3.8-flash, gemini-flash-latest)" Text="gemini-3.5-flash-lite" Width="440" HorizontalAlignment="Left" />
                                <TextBox x:Name="SettingsGeminiEndpointBox" Header="Custom Base URL (Optional / Regional Proxy)" PlaceholderText="https://generativelanguage.googleapis.com" Width="440" HorizontalAlignment="Left" />
                                <ToggleSwitch x:Name="GeminiGoogleSearchToggle" Header="Allow Gemini Google Search for current questions (sends the prompt and supplied context to Google)" IsOn="False" />
                                <StackPanel Spacing="6" Margin="0,4,0,0">
                                    <Button Content="Test &amp; Activate Gemini" Style="{StaticResource GwPrimaryButtonStyle}" Click="OnTestGeminiClick" HorizontalAlignment="Left" />
                                    <TextBlock x:Name="SettingsGeminiStatusText" Text="" FontSize="12" TextWrapping="Wrap" MaxWidth="560" />
                                </StackPanel>
                            </StackPanel>

                            <ToggleSwitch x:Name="RememberAgentConversationToggle" Header="Remember the last five agent turns on this PC (stored locally; off by default)" IsOn="False" />

                            <!-- OpenAI Options -->
                            <StackPanel x:Name="SettingsOpenAiPanel" Spacing="8" Visibility="Collapsed">
                                <PasswordBox x:Name="SettingsOpenAiApiKeyBox" Header="OpenAI API Key" Width="440" HorizontalAlignment="Left" />
                                <TextBox x:Name="SettingsOpenAiModelBox" Header="OpenAI Model (e.g. gpt-4o, o3-mini, gpt-4.5)" Text="gpt-4o" Width="440" HorizontalAlignment="Left" />
                                <TextBox x:Name="SettingsOpenAiEndpointBox" Header="Custom Base URL (Optional / Proxy)" PlaceholderText="https://api.openai.com/v1" Width="440" HorizontalAlignment="Left" />
                                <StackPanel Spacing="6" Margin="0,4,0,0">
                                    <Button Content="Test &amp; Activate OpenAI" Style="{StaticResource GwPrimaryButtonStyle}" Click="OnTestOpenAiClick" HorizontalAlignment="Left" />
                                    <TextBlock x:Name="SettingsOpenAiStatusText" Text="" FontSize="12" TextWrapping="Wrap" MaxWidth="560" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Mistral Options -->
                            <StackPanel x:Name="SettingsMistralPanel" Spacing="8" Visibility="Collapsed">
                                <PasswordBox x:Name="SettingsMistralApiKeyBox" Header="Mistral API Key" Width="440" HorizontalAlignment="Left" />
                                <TextBox x:Name="SettingsMistralModelBox" Header="Mistral Model (e.g. mistral-medium-latest, mistral-large-latest, mistral-small-latest)" Text="mistral-medium-latest" Width="440" HorizontalAlignment="Left" />
                                <TextBox x:Name="SettingsMistralEndpointBox" Header="Custom Base URL (Optional)" PlaceholderText="https://api.mistral.ai/v1" Width="440" HorizontalAlignment="Left" />
                                <ToggleSwitch x:Name="MistralWebSearchToggle" Header="Allow Mistral web search for current questions (sends the prompt and supplied context to Mistral)" IsOn="False" />
                                <StackPanel Spacing="6" Margin="0,4,0,0">
                                    <Button Content="Test &amp; Activate Mistral" Style="{StaticResource GwPrimaryButtonStyle}" Click="OnTestMistralClick" HorizontalAlignment="Left" />
                                    <TextBlock x:Name="SettingsMistralStatusText" Text="" FontSize="12" TextWrapping="Wrap" MaxWidth="560" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Section 5: Engine Architecture & About -->
                    <Border Padding="16,14" CornerRadius="8" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <Border Width="32" Height="32" CornerRadius="6" Background="{ThemeResource GwTealBgBrush}" BorderBrush="{ThemeResource GwTealBrush}" BorderThickness="1">
                                    <FontIcon Glyph="&#xEDA2;" FontSize="16" Foreground="{ThemeResource GwTealBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="About Groundwork 1.1 Enterprise Engine" Style="{StaticResource GwCardTitleStyle}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="Native WinUI 3 &amp; .NET 10 storage analyzer, hardware inventory, multi-volume scanner, and reviewed cleanup engine." FontSize="11" Foreground="{ThemeResource GwTextSecondaryBrush}" />
                            <TextBlock Text="• Multi-Drive Concurrent Scanner: Analyzes all mounted physical and logical drives simultaneously." FontSize="11" Foreground="{ThemeResource GwTextMutedBrush}" />
                            <TextBlock Text="• Fast Win32 Walker: Traverses directories at &gt;175,000 files/sec without blocking UI." FontSize="11" Foreground="{ThemeResource GwTextMutedBrush}" />
                            <TextBlock Text="• Storage scans use the Windows file enumerator; junctions and symbolic links are skipped." FontSize="11" Foreground="{ThemeResource GwTextMutedBrush}" />
                            <TextBlock Text="• Hardware Topology: Live component inspection, socket analysis, SPD memory modules, and WHQL driver status." FontSize="11" Foreground="{ThemeResource GwTextMutedBrush}" />
                            <TextBlock Text="• Leftover Scanner: Detects registry traces and leftover files after application uninstallation." FontSize="11" Foreground="{ThemeResource GwTextMutedBrush}" />
                            <TextBlock Text="• Keyboard Shortcuts: Double-Click / Enter to expand folder or open file; Right-Click for context actions." FontSize="11" Foreground="{ThemeResource GwTextMutedBrush}" />
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

        </Grid>

        <!-- 3. BOTTOM STATUS BAR -->
        <Border Grid.Row="2" Background="{ThemeResource GwHeaderBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="0,1,0,0" Padding="14,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="FooterStatusText" Text="Ready." FontSize="11" Foreground="{ThemeResource GwTextMutedBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" x:Name="FooterDriveSpaceText" Text="" FontSize="11" Foreground="{ThemeResource GwTextMutedBrush}" VerticalAlignment="Center" />
                <TextBlock x:Name="FooterEngineText" Visibility="Collapsed" />
            </Grid>
        </Border>

        <!-- ======================================================== -->
        <!-- 4. MODAL OVERLAY: STARTUP DRIVE SELECTION & INSTANT SCAN -->
        <!-- ======================================================== -->
        <Grid x:Name="StartupDriveModalOverlay" Grid.RowSpan="3" Background="#80000000" Visibility="Collapsed" PointerPressed="OnModalBackdropPointerPressed">
            <Border
                Width="760"
                MaxHeight="580"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Padding="28,24"
                CornerRadius="12"
                Background="{ThemeResource GwPageBackgroundBrush}"
                BorderBrush="{ThemeResource GwCardBorderBrush}"
                BorderThickness="1"
                PointerPressed="OnModalCardPointerPressed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Modal Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <Border Width="34" Height="34" CornerRadius="8" Background="{ThemeResource GwTealBgBrush}" BorderBrush="{ThemeResource GwTealBrush}" BorderThickness="1">
                                    <FontIcon Glyph="&#xEDA2;" FontSize="18" Foreground="{ThemeResource GwTealBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Select Drive to Analyze" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="Choose a local drive to view storage space, discover large files, and clean up waste." FontSize="12" Foreground="{ThemeResource GwTextSecondaryBrush}" Margin="44,0,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1" VerticalAlignment="Top" Padding="6" Background="Transparent" BorderThickness="0" Click="OnCloseDriveModalClick">
                            <SymbolIcon Symbol="Cancel" Foreground="{ThemeResource GwTextMutedBrush}" />
                        </Button>
                    </Grid>

                    <!-- Drives Cards List -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
                        <StackPanel Spacing="6">
                            <ItemsControl x:Name="ModalDrivesItemsControl" ItemsSource="{x:Bind Volumes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:VolumeRowViewModel">
                                    <Border Margin="0,4" Padding="14,12" CornerRadius="8" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="42" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Drive Disk Icon -->
                                            <Border Width="40" Height="40" CornerRadius="8" Background="{ThemeResource GwCardBackgroundHoverBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1" VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xEDA2;" FontSize="20" Foreground="{ThemeResource GwAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>

                                            <!-- Details & Progress Bar -->
                                            <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Text="{x:Bind VolumeName}" FontWeight="SemiBold" FontSize="14" Foreground="{ThemeResource GwTextPrimaryBrush}" MaxWidth="280" TextTrimming="CharacterEllipsis" />
                                                        <Border Padding="6,1" CornerRadius="4" Background="{ThemeResource GwCardBackgroundHoverBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{x:Bind FileSystemLabel}" FontSize="10" Foreground="{ThemeResource GwTextSecondaryBrush}" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{x:Bind CapacitySummary}" FontSize="12" FontWeight="Medium" Foreground="{ThemeResource GwTextSecondaryBrush}" VerticalAlignment="Center" />
                                                </Grid>
                                                <ProgressBar Value="{x:Bind UsedPercent}" Maximum="100" Height="6" CornerRadius="3" Foreground="{ThemeResource GwAccentBrush}" />
                                            </StackPanel>

                                            <!-- Scan Action -->
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <Button Content="Scan" Tag="{x:Bind RootPath}" Style="{StaticResource GwPrimaryButtonStyle}" Padding="18,6" Click="OnModalScanDriveClick" ToolTipService.ToolTip="Scan this drive with the Windows file enumerator" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Bottom Action Row: Scan All Drives + Folder Picker + CSV + Close -->
                    <Border Grid.Row="2" Padding="0,12,0,0" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button Content="Scan All Drives" Style="{StaticResource GwSecondaryButtonStyle}" Click="OnModalScanAllDrivesClick" ToolTipService.ToolTip="Scan and combine all storage drives on your PC into one view" />
                                <Button Content="Browse Folder..." Style="{StaticResource GwSecondaryButtonStyle}" Click="OnModalBrowseCustomFolderClick" />
                                <Button Content="Import CSV..." Style="{StaticResource GwSecondaryButtonStyle}" Click="OnModalOpenCsvClick" ToolTipService.ToolTip="Import a previously saved drive scan report" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Dismiss" Style="{StaticResource GwSecondaryButtonStyle}" Click="OnCloseDriveModalClick" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ======================================================== -->
        <!-- 5. FULL-SCREEN BLOCKING LOADING OVERLAY DURING SCAN / LOAD -->
        <!-- ======================================================== -->
        <Grid x:Name="StorageLoadingOverlay" Grid.RowSpan="3" Background="#80000000" Visibility="Collapsed" IsHitTestVisible="True">
            <Border
                Width="540"
                Padding="32,28"
                CornerRadius="14"
                Background="{ThemeResource GwPageBackgroundBrush}"
                BorderBrush="{ThemeResource GwCardBorderBrush}"
                BorderThickness="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <StackPanel Spacing="20">
                    <!-- Header with ProgressRing and Title -->
                    <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                        <ProgressRing x:Name="LoadingProgressRing" IsActive="True" Width="36" Height="36" Foreground="{ThemeResource GwAccentBrush}" />
                        <StackPanel Spacing="3">
                            <TextBlock x:Name="LoadingTargetTitleText" Text="Scanning Drive (C:)..." FontSize="17" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" />
                            <TextBlock x:Name="LoadingSubtitleText" Text="Fast multi-threaded engine analyzing file system hierarchy..." FontSize="12" Foreground="{ThemeResource GwTextSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Real-Time Metrics Grid -->
                    <Border Padding="16,14" CornerRadius="8" Background="{ThemeResource GwCardBackgroundHoverBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                        <Grid RowSpacing="10" ColumnSpacing="16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Spacing="2">
                                <TextBlock Text="FILES SCANNED" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource GwTextMutedBrush}" />
                                <TextBlock x:Name="LoadingFilesCountText" Text="0" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" />
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="1" Spacing="2">
                                <TextBlock Text="FOLDERS SCANNED" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource GwTextMutedBrush}" />
                                <TextBlock x:Name="LoadingFoldersCountText" Text="0" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Spacing="2">
                                <TextBlock Text="DATA DISCOVERED" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource GwTextMutedBrush}" />
                                <TextBlock x:Name="LoadingDataDiscoveredText" Text="0 B" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource GwAccentBrush}" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="1" Spacing="2">
                                <TextBlock Text="SCAN SPEED" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource GwTextMutedBrush}" />
                                <TextBlock x:Name="LoadingScanSpeedText" Text="Calculating..." FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource GwTealBrush}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Current Directory Path -->
                    <StackPanel Spacing="6">
                        <TextBlock x:Name="LoadingCurrentPathText" Text="Initializing parallel workers..." FontSize="11" Foreground="{ThemeResource GwTextMutedBrush}" TextTrimming="CharacterEllipsis" MaxWidth="480" />
                        <ProgressBar x:Name="LoadingProgressBar" IsIndeterminate="True" Height="6" CornerRadius="3" Foreground="{ThemeResource GwAccentBrush}" />
                    </StackPanel>

                    <!-- Bottom Notice & Cancel Button -->
                    <Grid>
                        <TextBlock Text="Please wait while disk contents are indexed..." FontSize="11" Foreground="{ThemeResource GwTextMutedBrush}" VerticalAlignment="Center" />
                        <Button Content="Cancel Scan" Style="{StaticResource GwSecondaryButtonStyle}" HorizontalAlignment="Right" Click="OnCancelScanClick" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
