<Window
    x:Class="Groundwork.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Groundwork.Desktop"
    xmlns:engineModels="using:Groundwork.Engine.Models"
    Title="Groundwork — Windows System Management &amp; Diagnostics Toolkit">

    <Grid Background="{ThemeResource GwPageBackgroundBrush}" KeyDown="OnRootGridKeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. TOP BRANDED COMMAND BAR (Ink Blue & White Signature Header) -->
        <Border Grid.Row="0" Background="{ThemeResource GwHeaderBackgroundBrush}" RequestedTheme="Dark" BorderBrush="{ThemeResource GwCardBorderStrongBrush}" BorderThickness="0,0,0,1" Padding="16,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Brand Identity -->
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="0,0,24,0">
                    <Image Source="ms-appx:///Assets/icon.png" Width="26" Height="26" VerticalAlignment="Center" />
                    <TextBlock Text="Groundwork" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                    <Border Padding="6,2" CornerRadius="4" Background="#1E3A5F" BorderBrush="#2D5A8C" BorderThickness="1" VerticalAlignment="Center">
                        <TextBlock Text="v1.1.0" FontSize="10" FontWeight="SemiBold" Foreground="#93C5FD" />
                    </Border>
                </StackPanel>

                <!-- Top Horizontal Navigation Tabs -->
                <NavigationView
                    x:Name="TopCommandNav"
                    Grid.Column="1"
                    PaneDisplayMode="Top"
                    IsBackButtonVisible="Collapsed"
                    IsSettingsVisible="False"
                    SelectionChanged="OnNavigationSelectionChanged"
                    Background="Transparent">
                    <NavigationView.MenuItems>
                        <NavigationViewItem Content="Overview" Tag="Overview" IsSelected="True">
                            <NavigationViewItem.Icon><SymbolIcon Symbol="Home" /></NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem Content="Analyze" Tag="Storage">
                            <NavigationViewItem.Icon><FontIcon Glyph="&#xEDA2;" /></NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem Content="Optimize" Tag="Optimize">
                            <NavigationViewItem.Icon><FontIcon Glyph="&#xE945;" /></NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem Content="Troubleshoot" Tag="Troubleshoot">
                            <NavigationViewItem.Icon><FontIcon Glyph="&#xE90F;" /></NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem Content="Maintenance" Tag="Cleanup">
                            <NavigationViewItem.Icon><SymbolIcon Symbol="Delete" /></NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem Content="Applications" Tag="Apps">
                            <NavigationViewItem.Icon><SymbolIcon Symbol="AllApps" /></NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem Content="AI Assistant" Tag="Agent">
                            <NavigationViewItem.Icon><SymbolIcon Symbol="Message" /></NavigationViewItem.Icon>
                        </NavigationViewItem>
                    </NavigationView.MenuItems>
                    <NavigationView.FooterMenuItems>
                        <NavigationViewItem Content="Settings" Tag="Settings">
                            <NavigationViewItem.Icon><SymbolIcon Symbol="Setting" /></NavigationViewItem.Icon>
                        </NavigationViewItem>
                    </NavigationView.FooterMenuItems>
                </NavigationView>

                <!-- Right Side Empty (Clean Minimal Design) -->
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. MAIN CONTENT AREA (Tabbed Workspaces) -->
        <Grid Grid.Row="1" Padding="20,16" Background="{ThemeResource GwPageBackgroundBrush}">

            <!-- ======================================================== -->
            <!-- 1. FILES & STORAGE WORKSPACE -->
            <!-- ======================================================== -->
            <Grid x:Name="StoragePanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Row 0: Responsive Volume Selector & Quick Controls -->
                <Border Grid.Row="0" Margin="0,0,0,8" Padding="12,8" CornerRadius="8" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="2.2*" MinWidth="160" MaxWidth="340" />
                            <ColumnDefinition Width="3*" MinWidth="140" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Drive:" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" x:Name="DrivesComboBox" HorizontalAlignment="Stretch" SelectionChanged="OnDrivesComboBoxSelectionChanged" VerticalAlignment="Center" ToolTipService.ToolTip="Select a drive or folder to scan" AutomationProperties.Name="Select drive or storage source" />
                        <TextBox Grid.Column="2" x:Name="ScanPathTextBox" PlaceholderText="Folder or drive path..." HorizontalAlignment="Stretch" VerticalAlignment="Center" AutomationProperties.Name="Target folder or drive path" KeyDown="OnScanPathTextBoxKeyDown" />
                        <Button Grid.Column="3" Content="Browse..." Style="{StaticResource GwSecondaryButtonStyle}" Click="OnScanCustomPathClick" VerticalAlignment="Center" ToolTipService.ToolTip="Browse for a folder on your PC" AutomationProperties.Name="Browse for folder" />
                        <Button Grid.Column="4" Content="Scan" Style="{StaticResource GwPrimaryButtonStyle}" Padding="18,6" Click="OnRunScanPathClick" VerticalAlignment="Center" ToolTipService.ToolTip="Scan selected drive or folder" AutomationProperties.Name="Run storage scan" />
                        <Button Grid.Column="5" x:Name="CancelScanButton" Content="Cancel" IsEnabled="False" Style="{StaticResource GwSecondaryButtonStyle}" Click="OnCancelScanClick" VerticalAlignment="Center" ToolTipService.ToolTip="Cancel current scan operation" AutomationProperties.Name="Cancel storage scan" />
                        <Button Grid.Column="6" Content="Drive Picker" Style="{StaticResource GwSecondaryButtonStyle}" Click="OnOpenDriveModalClick" ToolTipService.ToolTip="Open visual drive selection modal" VerticalAlignment="Center" AutomationProperties.Name="Open drive picker modal" />
                        <Button Grid.Column="7" Content="Refresh" Style="{StaticResource GwSecondaryButtonStyle}" Click="OnRefreshDrivesClick" ToolTipService.ToolTip="Re-detect mounted drives" VerticalAlignment="Center" AutomationProperties.Name="Refresh drives list" />
                        <Button Grid.Column="8" Content="Hardware &amp; Specs →" Tag="Hardware" Style="{StaticResource GwSecondaryButtonStyle}" Click="OnAssistantActionClick" ToolTipService.ToolTip="Switch to Analyze: Hardware Specifications &amp; Diagnostics" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Row 1: Proportional Storage Breakdown Bar -->
                <Border Grid.Row="1" Margin="0,0,0,8" Padding="12,8" CornerRadius="8" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                    <StackPanel Spacing="6">
                        <!-- Segmented Visual Bar -->
                        <Border Height="11" CornerRadius="3" Background="{ThemeResource GwCardBackgroundHoverBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                            <Grid x:Name="StorageBreakdownBarGrid" />
                        </Border>
                        <!-- Legend Pills -->
                        <Grid>
                            <ItemsControl x:Name="StorageBreakdownLegendControl">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="16" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="local:StorageBarSegmentViewModel">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind TooltipText}">
                                            <Border Width="9" Height="9" CornerRadius="2" Background="{x:Bind ColorHex}" VerticalAlignment="Center" />
                                            <TextBlock Text="{x:Bind Name}" FontSize="11" FontWeight="Medium" Foreground="{ThemeResource GwTextPrimaryBrush}" VerticalAlignment="Center" />
                                            <TextBlock Text="{x:Bind FormattedSize}" FontSize="11" Foreground="{ThemeResource GwTextMutedBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="StorageBreakdownSummaryText" Visibility="Collapsed" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Row 2: Hierarchical Explorer & File Table (Full Height) -->
                <Border Grid.Row="2" CornerRadius="8" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Unified Explorer Header: Unified Tree / Flat Files Toggle + Instant Filter -->
                        <Border Grid.Row="0" Background="{ThemeResource GwCardBackgroundHoverBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="0,0,0,1" Padding="12,6">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" MinWidth="140" MaxWidth="380" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" x:Name="ViewTreeTabButton" Content="Tree (Folders &amp; Files)" Style="{StaticResource GwPrimaryButtonStyle}" Padding="12,5" FontSize="12" Click="OnViewTreeTabClick" />
                                <Button Grid.Column="1" x:Name="ViewFileTabButton" Content="Largest Files (Flat)" Style="{StaticResource GwSecondaryButtonStyle}" Padding="12,5" FontSize="12" Click="OnViewFileTabClick" />
                                <Border Grid.Column="2" Width="1" Height="16" Background="{ThemeResource GwCardBorderBrush}" Margin="2,0" />
                                <TextBox Grid.Column="3" x:Name="TreeFilterTextBox" PlaceholderText="Filter by name, extension (e.g. *.mp4)..." HorizontalAlignment="Stretch" TextChanged="OnTreeFilterTextChanged" AutomationProperties.Name="Filter scanned files and folders" />
                                <Button Grid.Column="4" Content="Clear" Style="{StaticResource GwSecondaryButtonStyle}" Padding="8,4" FontSize="11" Click="OnClearTreeFilterClick" AutomationProperties.Name="Clear filter" />
                                <Button Grid.Column="6" Content="Collapse All" Style="{StaticResource GwSecondaryButtonStyle}" Padding="8,4" FontSize="11" Click="OnCollapseAllTreeNodesClick" AutomationProperties.Name="Collapse all tree folders" />
                                <TextBlock x:Name="ViewTabSummaryText" Visibility="Collapsed" />
                            </Grid>
                        </Border>

                        <!-- ================= 3A. TREE VIEW ================= -->
                        <Grid x:Name="TreeContentGrid" Grid.Row="1" Visibility="Visible">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Tree Column Header -->
                            <Border Grid.Row="0" Background="{ThemeResource GwCardBackgroundHoverBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="0,0,0,1" Padding="12,7">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="220" />
                                        <ColumnDefinition Width="105" />
                                        <ColumnDefinition Width="85" />
                                        <ColumnDefinition Width="85" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="65" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Folder / File Name" FontWeight="SemiBold" FontSize="11" Foreground="{ThemeResource GwTextPrimaryBrush}" />
                                    <TextBlock Grid.Column="1" Text="% of Drive" FontWeight="SemiBold" FontSize="11" Foreground="{ThemeResource GwTextSecondaryBrush}" />
                                    <TextBlock Grid.Column="2" Text="Size" FontWeight="SemiBold" FontSize="11" Foreground="{ThemeResource GwTextSecondaryBrush}" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="3" Text="Allocated" FontWeight="SemiBold" FontSize="11" Foreground="{ThemeResource GwTextSecondaryBrush}" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="4" Text="Files" FontWeight="SemiBold" FontSize="11" Foreground="{ThemeResource GwTextSecondaryBrush}" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="5" Text="Folders" FontWeight="SemiBold" FontSize="11" Foreground="{ThemeResource GwTextSecondaryBrush}" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="6" Text="Attributes" FontWeight="SemiBold" FontSize="11" Foreground="{ThemeResource GwTextSecondaryBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Grid.Column="7" Text="Modified" FontWeight="SemiBold" FontSize="11" Foreground="{ThemeResource GwTextSecondaryBrush}" HorizontalAlignment="Right" />
                                </Grid>
                            </Border>

                            <!-- Tree Empty State Placeholder -->
                            <Border x:Name="TreeEmptyStateBorder" Grid.Row="1" Visibility="Visible" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="32">
                                <StackPanel Spacing="14" HorizontalAlignment="Center" MaxWidth="460">
                                    <Border Width="56" Height="56" CornerRadius="12" Background="{ThemeResource GwAccentBgBrush}" BorderBrush="{ThemeResource GwAccentBrush}" BorderThickness="1" HorizontalAlignment="Center">
                                        <FontIcon Glyph="&#xEDA2;" FontSize="24" Foreground="{ThemeResource GwAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="No Drive or Folder Scanned Yet" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="Select a drive or folder from the toolbar above and click 'Scan' to visualize your disk usage, proportional folder tree, and space allocation." FontSize="12" Foreground="{ThemeResource GwTextSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" LineHeight="18" />
                                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" Margin="0,6,0,0">
                                        <Button Content="Scan Primary Drive" Style="{StaticResource GwPrimaryButtonStyle}" Click="OnQuickScanPrimaryDriveClick" AutomationProperties.Name="Scan primary Windows drive" />
                                        <Button Content="Browse Folder..." Style="{StaticResource GwSecondaryButtonStyle}" Click="OnScanCustomPathClick" AutomationProperties.Name="Browse folder to scan" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Virtualized Hierarchical Tree ListView -->
                            <ListView x:Name="StorageTreeListView" Grid.Row="1" Visibility="Collapsed" SelectionMode="Single" SelectionChanged="OnStorageTreeSelectionChanged" KeyDown="OnStorageTreeKeyDown">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="Padding" Value="12,0,12,0" />
                                        <Setter Property="Margin" Value="0" />
                                        <Setter Property="MinHeight" Value="28" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:StorageTreeNodeViewModel">
                                        <Grid Margin="0" Padding="0,3" ColumnSpacing="8" Background="Transparent" RightTapped="OnTreeRowRightTapped" DoubleTapped="OnTreeRowDoubleTapped">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" MinWidth="220" />
                                                <ColumnDefinition Width="105" />
                                                <ColumnDefinition Width="85" />
                                                <ColumnDefinition Width="85" />
                                                <ColumnDefinition Width="70" />
                                                <ColumnDefinition Width="70" />
                                                <ColumnDefinition Width="65" />
                                                <ColumnDefinition Width="120" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Indented Expander + Folder Icon + Name -->
                                            <Grid Margin="{x:Bind IndentThickness}" ColumnSpacing="6" VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid Width="20" Height="20" VerticalAlignment="Center">
                                                    <Button
                                                        Width="20"
                                                        Height="20"
                                                        Padding="0"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Visibility="{x:Bind HasChildrenVisibility}"
                                                        Click="OnTreeNodeExpanderClick"
                                                        AutomationProperties.Name="{x:Bind ExpanderAutomationName}"
                                                        ToolTipService.ToolTip="{x:Bind ExpanderAutomationName}">
                                                        <FontIcon Glyph="{x:Bind ExpanderGlyph, Mode=OneWay}" FontSize="10" Foreground="{ThemeResource GwTextMutedBrush}" />
                                                    </Button>
                                                </Grid>

                                                <FontIcon Grid.Column="1" Glyph="{x:Bind NodeGlyph}" FontSize="14" Foreground="{x:Bind NodeGlyphColor}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Text="{x:Bind Name}" FontWeight="Medium" Foreground="{ThemeResource GwTextPrimaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            </Grid>

                                            <!-- % of Drive Mini Bar -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <ProgressBar Value="{x:Bind PercentOfDrive}" Maximum="100" Width="55" Height="5" CornerRadius="2" Foreground="{ThemeResource GwAccentBrush}" VerticalAlignment="Center" />
                                                <TextBlock Text="{x:Bind PercentLabel}" FontSize="11" Foreground="{ThemeResource GwTextSecondaryBrush}" VerticalAlignment="Center" />
                                            </StackPanel>

                                            <!-- Formatted Size -->
                                            <TextBlock Grid.Column="2" Text="{x:Bind FormattedSize}" FontWeight="SemiBold" Foreground="{ThemeResource GwAccentBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" />

                                            <!-- Allocated Size -->
                                            <TextBlock Grid.Column="3" Text="{x:Bind FormattedAllocated}" FontSize="11" Foreground="{ThemeResource GwTextSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" />

                                            <!-- Files Count -->
                                            <TextBlock Grid.Column="4" Text="{x:Bind FilesCountFormatted}" FontSize="11" Foreground="{ThemeResource GwTextMutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" />

                                            <!-- Folders Count -->
                                            <TextBlock Grid.Column="5" Text="{x:Bind FoldersCountFormatted}" FontSize="11" Foreground="{ThemeResource GwTextMutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" />

                                            <!-- Attributes -->
                                            <TextBlock Grid.Column="6" Text="{x:Bind Attributes}" FontSize="10" Foreground="{ThemeResource GwTextMutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />

                                            <!-- Last Modified -->
                                            <TextBlock Grid.Column="7" Text="{x:Bind LastModifiedFormatted}" FontSize="11" Foreground="{ThemeResource GwTextMutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>

                        <!-- ================= 3B. FILE VIEW (Flat Largest Files Table) ================= -->
                        <Grid x:Name="FileContentGrid" Grid.Row="1" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- File Table Column Header -->
                            <Border Grid.Row="0" Background="{ThemeResource GwCardBackgroundHoverBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="0,0,0,1" Padding="12,7">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" MinWidth="180" />
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="65" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="3*" MinWidth="160" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="SortFileNameHeader" Text="File Name ⬍" FontWeight="SemiBold" FontSize="11" Foreground="{ThemeResource GwTextPrimaryBrush}" PointerPressed="OnSortFileNameClick" ToolTipService.ToolTip="Click to sort by file name" AutomationProperties.Name="Sort by file name" />
                                    <TextBlock Grid.Column="1" x:Name="SortExtHeader" Text="Ext ⬍" FontWeight="SemiBold" FontSize="11" Foreground="{ThemeResource GwTextSecondaryBrush}" PointerPressed="OnSortExtClick" ToolTipService.ToolTip="Click to sort by extension" AutomationProperties.Name="Sort by extension" />
                                    <TextBlock Grid.Column="2" Text="Type" FontWeight="SemiBold" FontSize="11" Foreground="{ThemeResource GwTextSecondaryBrush}" />
                                    <TextBlock Grid.Column="3" Text="% of Total" FontWeight="SemiBold" FontSize="11" Foreground="{ThemeResource GwTextSecondaryBrush}" />
                                    <TextBlock Grid.Column="4" x:Name="SortSizeHeader" Text="Size ⬍" FontWeight="SemiBold" FontSize="11" Foreground="{ThemeResource GwTextSecondaryBrush}" HorizontalAlignment="Right" PointerPressed="OnSortSizeClick" ToolTipService.ToolTip="Click to sort by file size" AutomationProperties.Name="Sort by file size" />
                                    <TextBlock Grid.Column="5" Text="Allocated" FontWeight="SemiBold" FontSize="11" Foreground="{ThemeResource GwTextSecondaryBrush}" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="6" Text="Attributes" FontWeight="SemiBold" FontSize="11" Foreground="{ThemeResource GwTextSecondaryBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Grid.Column="7" x:Name="SortModifiedHeader" Text="Modified ⬍" FontWeight="SemiBold" FontSize="11" Foreground="{ThemeResource GwTextSecondaryBrush}" HorizontalAlignment="Right" PointerPressed="OnSortModifiedClick" ToolTipService.ToolTip="Click to sort by modified date" AutomationProperties.Name="Sort by modified date" />
                                    <TextBlock Grid.Column="8" Text="Folder Path" FontWeight="SemiBold" FontSize="11" Foreground="{ThemeResource GwTextSecondaryBrush}" />
                                </Grid>
                            </Border>

                            <!-- File Empty State Placeholder -->
                            <Border x:Name="FileEmptyStateBorder" Grid.Row="1" Visibility="Visible" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="32">
                                <StackPanel Spacing="14" HorizontalAlignment="Center" MaxWidth="440">
                                    <Border Width="56" Height="56" CornerRadius="12" Background="{ThemeResource GwAccentBgBrush}" BorderBrush="{ThemeResource GwAccentBrush}" BorderThickness="1" HorizontalAlignment="Center">
                                        <FontIcon Glyph="&#xE8A5;" FontSize="24" Foreground="{ThemeResource GwAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="No Files Scanned" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="Run a scan on any drive or folder to identify the largest flat files taking up your storage space." FontSize="12" Foreground="{ThemeResource GwTextSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" LineHeight="18" />
                                </StackPanel>
                            </Border>

                            <!-- Virtualized File Table ListView -->
                            <ListView x:Name="StorageFileListView" Grid.Row="1" Visibility="Collapsed" SelectionMode="Single" SelectionChanged="OnStorageFileSelectionChanged" KeyDown="OnStorageFileKeyDown">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="Padding" Value="12,0,12,0" />
                                        <Setter Property="Margin" Value="0" />
                                        <Setter Property="MinHeight" Value="28" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:FileRowViewModel">
                                        <Grid Margin="0" Padding="0,3" ColumnSpacing="8" Background="Transparent" RightTapped="OnFileRowRightTapped" DoubleTapped="OnFileRowDoubleTapped">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*" MinWidth="180" />
                                                <ColumnDefinition Width="60" />
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="65" />
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="3*" MinWidth="160" />
                                            </Grid.ColumnDefinitions>

                                            <!-- File Icon + Name -->
                                            <Grid ColumnSpacing="6" VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <FontIcon Glyph="{x:Bind Glyph}" FontSize="14" Foreground="{x:Bind GlyphColor}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind Name}" FontWeight="Medium" Foreground="{ThemeResource GwTextPrimaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            </Grid>

                                            <!-- Extension -->
                                            <TextBlock Grid.Column="1" Text="{x:Bind Extension}" FontSize="11" Foreground="{ThemeResource GwTextSecondaryBrush}" VerticalAlignment="Center" />

                                            <!-- Type -->
                                            <TextBlock Grid.Column="2" Text="{x:Bind FileType}" FontSize="11" Foreground="{ThemeResource GwTextMutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                                            <!-- % Progress Bar -->
                                            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <ProgressBar Value="{x:Bind PercentOfTotal}" Maximum="100" Width="50" Height="5" CornerRadius="2" Foreground="{ThemeResource GwAccentBrush}" VerticalAlignment="Center" />
                                                <TextBlock Text="{x:Bind PercentLabel}" FontSize="11" Foreground="{ThemeResource GwTextSecondaryBrush}" VerticalAlignment="Center" />
                                            </StackPanel>

                                            <!-- Size -->
                                            <TextBlock Grid.Column="4" Text="{x:Bind FormattedSize}" FontWeight="SemiBold" Foreground="{ThemeResource GwAccentBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" />

                                            <!-- Allocated -->
                                            <TextBlock Grid.Column="5" Text="{x:Bind FormattedAllocated}" FontSize="11" Foreground="{ThemeResource GwTextSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" />

                                            <!-- Attributes -->
                                            <TextBlock Grid.Column="6" Text="{x:Bind Attributes}" FontSize="10" Foreground="{ThemeResource GwTextMutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />

                                            <!-- Modified -->
                                            <TextBlock Grid.Column="7" Text="{x:Bind LastModifiedFormatted}" FontSize="11" Foreground="{ThemeResource GwTextMutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" />

                                            <!-- Folder Path -->
                                            <TextBlock Grid.Column="8" Text="{x:Bind Folder}" FontSize="11" Foreground="{ThemeResource GwTextMutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Collapsed Legacy Summary & Inspector Controls (Preserves Code-Behind Data Binding Safely) -->
                <StackPanel Visibility="Collapsed">
                    <TextBlock x:Name="ScanSummaryHeaderText" />
                    <TextBlock x:Name="ScanMetricsDetailText" />
                    <ProgressBar x:Name="ScanActivityProgressBar" />
                    <TextBlock Text="{x:Bind SelectedMetadata.Name, Mode=OneWay}" />
                    <TextBlock Text="{x:Bind SelectedMetadata.FullPath, Mode=OneWay}" />
                    <TextBlock Text="{x:Bind SelectedMetadata.FormattedSize, Mode=OneWay}" />
                    <TextBlock Text="{x:Bind SelectedMetadata.ExactBytes, Mode=OneWay}" />
                    <TextBlock Text="{x:Bind SelectedMetadata.FormattedAllocated, Mode=OneWay}" />
                    <TextBlock Text="{x:Bind SelectedMetadata.ItemsSummary, Mode=OneWay}" />
                    <TextBlock Text="{x:Bind SelectedMetadata.Glyph, Mode=OneWay}" />
                    <TextBlock Text="{x:Bind SelectedMetadata.KindLabel, Mode=OneWay}" />
                    <TextBlock Text="{x:Bind SelectedMetadata.Attributes, Mode=OneWay}" />
                    <TextBlock Text="{x:Bind SelectedMetadata.LastModifiedDate, Mode=OneWay}" />
                    <TextBlock Text="{x:Bind SelectedMetadata.CreatedDate, Mode=OneWay}" />
                </StackPanel>
            </Grid>

            <!-- ======================================================== -->
            <!-- 2. STORAGE CLEANUP & RECOMMENDATIONS PANEL (STORAGE SENSE) -->
            <!-- ======================================================== -->
            <ScrollViewer x:Name="CleanupPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="16">
                    <!-- Storage Sense Hero Card -->
                    <Border Padding="16,14" CornerRadius="8" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid ColumnSpacing="12" VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Width="42" Height="42" CornerRadius="8" Background="{ThemeResource GwTealBgBrush}" BorderBrush="{ThemeResource GwTealBrush}" BorderThickness="1">
                                    <SymbolIcon Symbol="Delete" Foreground="{ThemeResource GwTealBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="Storage Cleanup &amp; Recommendations" Style="{StaticResource GwPanelTitleStyle}" FontSize="18" />
                                    <TextBlock Text="Storage Sense recommendations: Instant, safe cleanup of temporary files, Recycle Bin, crash dumps, and caches." Style="{StaticResource GwPanelSubtitleStyle}" />
                                </StackPanel>
                            </Grid>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <ComboBox x:Name="CleanupModeComboBox" SelectedIndex="0" Width="225" VerticalAlignment="Center" AutomationProperties.Name="Select cleanup deletion mode">
                                    <ComboBoxItem Content="Move to Recycle Bin (Safe)" Tag="recycle" />
                                    <ComboBoxItem Content="Permanent Delete" Tag="permanent" />
                                </ComboBox>
                                <Button x:Name="RescanDiagnosticsButton" Style="{StaticResource GwSecondaryButtonStyle}" Click="OnPreloadCleanupClick" VerticalAlignment="Center" ToolTipService.ToolTip="Refresh storage recommendations" AutomationProperties.Name="Rescan storage diagnostics">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <SymbolIcon Symbol="Refresh" />
                                        <TextBlock Text="Rescan" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="AnalyzeCleanupButton" Visibility="Collapsed" Click="OnRunCleanupScanClick" />
                                <Button x:Name="ReviewAndCleanButton" Content="Clean Selected Categories..." Style="{StaticResource GwPrimaryButtonStyle}" Padding="16,7" Click="OnReviewAndCleanSelectedClick" VerticalAlignment="Center" AutomationProperties.Name="Clean selected categories" />
                                <Button Content="Organizer &amp; History →" Tag="Organize" Style="{StaticResource GwSecondaryButtonStyle}" Click="OnAssistantActionClick" VerticalAlignment="Center" ToolTipService.ToolTip="Switch to Maintenance: Smart File Organizer &amp; Safe Operation History" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Storage Sense Summary Banner -->
                    <Border Padding="16,12" CornerRadius="8" Background="{ThemeResource GwCardBackgroundHoverBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE74D;" FontSize="16" Foreground="{ThemeResource GwAccentBrush}" />
                                    <TextBlock Text="Total Reclaimable Space:" FontSize="13" Foreground="{ThemeResource GwTextSecondaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="CleanupTotalReclaimableText" Text="Calculating..." FontSize="20" FontWeight="Bold" Foreground="{ThemeResource GwAccentBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock x:Name="CleanupTotalReclaimableSubText" Text="Safe recommendations ready for removal across selected categories." FontSize="11" Foreground="{ThemeResource GwTextMutedBrush}" />
                                <TextBlock x:Name="CleanupSummaryBannerText" FontSize="11" Foreground="{ThemeResource GwTealBrush}" TextWrapping="Wrap" />
                                <ProgressBar x:Name="CleanupProgressBar" IsIndeterminate="True" Height="3" Visibility="Collapsed" CornerRadius="2" Foreground="{ThemeResource GwAccentBrush}" Margin="0,4,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button Content="Select Recommended" Style="{StaticResource GwSecondaryButtonStyle}" Padding="10,4" FontSize="11" Click="OnSelectRecommendedCategoriesClick" ToolTipService.ToolTip="Select safe categories (Recycle Bin, Temp, Crash Dumps)" />
                                <Button Content="Select All" Style="{StaticResource GwSecondaryButtonStyle}" Padding="10,4" FontSize="11" Click="OnSelectAllCategoriesClick" />
                                <Button Content="Deselect All" Style="{StaticResource GwSecondaryButtonStyle}" Padding="10,4" FontSize="11" Click="OnSelectNoneCategoriesClick" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Storage Sense Recommendation Cards -->
                    <ItemsControl x:Name="StorageSenseCardsControl" ItemsSource="{x:Bind StorageSenseCategories}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:StorageSenseCategoryCardViewModel">
                                <Border Margin="0,0,0,12" Padding="16,14" CornerRadius="8"
                                        Background="{ThemeResource GwCardBackgroundBrush}"
                                        BorderBrush="{ThemeResource GwCardBorderBrush}"
                                        BorderThickness="1">
                                    <StackPanel Spacing="10">
                                        <!-- Main Category Card Row -->
                                        <Grid ColumnSpacing="14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="42" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Checkbox to select/deselect category -->
                                            <CheckBox MinWidth="0" IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                                      VerticalAlignment="Center" Margin="0,0,4,0"
                                                      AutomationProperties.Name="{x:Bind Title}" />

                                            <!-- Category Icon -->
                                            <Border Grid.Column="1" Width="38" Height="38" CornerRadius="8"
                                                    Background="{x:Bind GlyphBg}"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <FontIcon Glyph="{x:Bind Glyph}" FontSize="18"
                                                          Foreground="{x:Bind GlyphColor}"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>

                                            <!-- Details: Title, Location Badge, Description -->
                                            <StackPanel Grid.Column="2" Spacing="3" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind Title}" FontSize="14" FontWeight="SemiBold"
                                                               Foreground="{ThemeResource GwTextPrimaryBrush}" />
                                                    <Border Padding="6,1" CornerRadius="4"
                                                            Background="{ThemeResource GwCardBackgroundHoverBrush}"
                                                            BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                                                        <TextBlock Text="{x:Bind LocationDisplay}" FontSize="10" FontFamily="Consolas"
                                                                   Foreground="{ThemeResource GwTealBrush}" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{x:Bind Description}" FontSize="12"
                                                           Foreground="{ThemeResource GwTextSecondaryBrush}" TextWrapping="Wrap" />
                                                <TextBlock Text="{x:Bind CountSummary}" FontSize="11"
                                                           Foreground="{ThemeResource GwTextMutedBrush}" />
                                            </StackPanel>

                                            <!-- Quick Action Button (e.g. Empty Bin) -->
                                            <Button Grid.Column="3" Content="{x:Bind QuickActionText}"
                                                    Visibility="{x:Bind QuickActionVisibility}"
                                                    Style="{StaticResource GwSecondaryButtonStyle}"
                                                    FontSize="11" Padding="10,4"
                                                    Click="OnCategoryQuickActionClick"
                                                    VerticalAlignment="Center" Margin="0,0,8,0" />

                                            <!-- Formatted Size & Drawer Expand Toggle -->
                                            <StackPanel Grid.Column="4" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="4">
                                                <TextBlock Text="{x:Bind FormattedSize}" FontSize="17" FontWeight="Bold"
                                                           Foreground="{ThemeResource GwAccentBrush}" HorizontalAlignment="Right" />
                                                <Button Content="{x:Bind ExpandToggleText, Mode=OneWay}"
                                                        Visibility="{x:Bind HasItemsVisibility}"
                                                        Style="{StaticResource GwSecondaryButtonStyle}"
                                                        FontSize="11" Padding="8,3"
                                                        Click="OnToggleCategoryExpandClick"
                                                        HorizontalAlignment="Right" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- Expandable File Details Drawer -->
                                        <Border Visibility="{x:Bind DetailsVisibility, Mode=OneWay}"
                                                Margin="48,4,0,0" Padding="12,10" CornerRadius="6"
                                                Background="{ThemeResource GwCardBackgroundHoverBrush}"
                                                BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                                            <StackPanel Spacing="8">
                                                <TextBlock Text="Files in this category:" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{ThemeResource GwTextSecondaryBrush}" />
                                                <ListView ItemsSource="{x:Bind Items}" SelectionMode="None" MaxHeight="220">
                                                    <ListView.ItemTemplate>
                                                        <DataTemplate x:DataType="local:CleanupCandidateRowViewModel">
                                                            <Grid Padding="4,3" ColumnSpacing="10">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <CheckBox MinWidth="0" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" VerticalAlignment="Center" AutomationProperties.Name="{x:Bind Name}" />
                                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                    <TextBlock Text="{x:Bind Name}" FontSize="12" FontWeight="Medium"
                                                                               Foreground="{ThemeResource GwTextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Text="{x:Bind DisplayPath}" FontSize="10"
                                                                               Foreground="{ThemeResource GwTextMutedBrush}" TextTrimming="CharacterEllipsis" />
                                                                </StackPanel>
                                                                <TextBlock Grid.Column="2" Text="{x:Bind FormattedSize}" FontSize="11"
                                                                           FontWeight="SemiBold" Foreground="{ThemeResource GwAccentBrush}"
                                                                           VerticalAlignment="Center" HorizontalAlignment="Right" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ListView.ItemTemplate>
                                                </ListView>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Collapsed Legacy Controls to preserve code-behind API compatibility -->
                    <Grid Visibility="Collapsed">
                        <TextBlock x:Name="CleanupRecycleBinText" />
                        <TextBlock x:Name="CleanupRecycleBinSubText" />
                        <TextBlock x:Name="CleanupTempFilesText" />
                        <TextBlock x:Name="CleanupTempFilesSubText" />
                        <TextBlock x:Name="CleanupDuplicatesText" />
                        <TextBlock x:Name="CleanupDuplicatesSubText" />
                        <Button x:Name="EmptyRecycleBinButton" Click="OnEmptyRecycleBinClick" />
                        <ListView x:Name="CleanupCandidatesListView" />
                        <ListView x:Name="DuplicateGroupsListView" />
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- ======================================================== -->
            <!-- 3. INSTALLED APPS & LEFTOVERS PANEL -->
            <!-- ======================================================== -->
            <Grid x:Name="AppsPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Header & Search Filter -->
                <Border Grid.Row="0" Margin="0,0,0,12" Padding="14,12" CornerRadius="8" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid ColumnSpacing="12" VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Width="38" Height="38" CornerRadius="7" Background="{ThemeResource GwTealBgBrush}" BorderBrush="{ThemeResource GwTealBrush}" BorderThickness="1">
                                <SymbolIcon Symbol="AllApps" Foreground="{ThemeResource GwTealBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Installed Applications, Uninstaller &amp; Leftovers" Style="{StaticResource GwPanelTitleStyle}" FontSize="17" />
                                <TextBlock Text="Two-step guided uninstall: monitors process exit code, then scans AppData, ProgramData and Registry for leftovers." Style="{StaticResource GwPanelSubtitleStyle}" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <TextBox x:Name="AppSearchFilterBox" PlaceholderText="Search applications or publishers..." MinWidth="180" MaxWidth="320" TextChanged="OnAppFilterTextChanged" VerticalAlignment="Center" />
                            <Button x:Name="RefreshAppsButton" Content="Refresh Apps" Style="{StaticResource GwSecondaryButtonStyle}" Click="OnRefreshInstalledAppsClick" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Two-Column Layout: Left = App Grid, Right = 2-Step Workflow & Leftovers -->
                <Grid Grid.Row="1" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.25*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <!-- Apps Grid -->
                    <Border Grid.Column="0" Padding="16,14" CornerRadius="8" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="InstalledAppsCountText" Text="Installed Applications" FontWeight="SemiBold" FontSize="14" Foreground="{ThemeResource GwTextPrimaryBrush}" Margin="0,0,0,6" />
                            <ProgressBar Grid.Row="1" x:Name="AppsProgressBar" IsIndeterminate="True" Height="3" Visibility="Collapsed" Margin="0,0,0,8" CornerRadius="2" Foreground="{ThemeResource GwAccentBrush}" />
                            
                            <!-- Apps Column Header Bar -->
                            <Border Grid.Row="2" Background="{ThemeResource GwCardBackgroundHoverBrush}" Padding="8,6" CornerRadius="4" Margin="0,0,0,4">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="1" Text="Application Name &amp; Publisher" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource GwTextSecondaryBrush}" />
                                    <TextBlock Grid.Column="2" Text="Version" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource GwTextSecondaryBrush}" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="3" Text="Estimated Size" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource GwTextSecondaryBrush}" HorizontalAlignment="Right" />
                                </Grid>
                            </Border>

                            <!-- Apps Empty State Placeholder -->
                            <Border x:Name="AppsEmptyStateBorder" Grid.Row="3" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24">
                                <StackPanel Spacing="10" HorizontalAlignment="Center" MaxWidth="320">
                                    <FontIcon Glyph="&#xE71D;" FontSize="28" Foreground="{ThemeResource GwTextMutedBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="No Applications Found" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="No matching applications found. Clear search filter or click Refresh Apps." FontSize="11" Foreground="{ThemeResource GwTextMutedBrush}" TextAlignment="Center" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <ListView x:Name="InstalledAppsListView" Grid.Row="3" SelectionMode="Single" SelectionChanged="OnInstalledAppSelectionChanged">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:InstalledAppRowViewModel">
                                        <Border Padding="8,7" Margin="0,2" CornerRadius="5" Background="{ThemeResource GwCardBackgroundHoverBrush}">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="28" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="100" />
                                                    <ColumnDefinition Width="90" />
                                                </Grid.ColumnDefinitions>
                                                <!-- Genuine Windows Application Icon with Fallback -->
                                                <Grid Width="24" Height="24" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                    <FontIcon Glyph="&#xE71D;" FontSize="18" Foreground="{ThemeResource GwAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    <Image Source="{x:Bind AppIcon, Mode=OneTime}" Width="24" Height="24" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Grid>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{x:Bind Publisher}" FontSize="11" Foreground="{ThemeResource GwTextMutedBrush}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{x:Bind Version}" FontSize="11" Foreground="{ThemeResource GwTextSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="3" Text="{x:Bind FormattedSize}" FontWeight="SemiBold" Foreground="{ThemeResource GwAccentBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>

                    <!-- 2-Step Guided Workflow & Leftovers Inspector -->
                    <Border Grid.Column="1" Padding="16,14" CornerRadius="8" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="Guided Uninstallation &amp; Leftover Traces" FontWeight="SemiBold" FontSize="14" Foreground="{ThemeResource GwTextPrimaryBrush}" Margin="0,0,0,8" />

                            <!-- Action Card -->
                            <Border Grid.Row="1" Margin="0,0,0,12" Padding="12,10" CornerRadius="6" Background="{ThemeResource GwCardBackgroundHoverBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="Application Uninstaller" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource GwTextPrimaryBrush}" />
                                        <TextBlock Text="Launches the official uninstaller and automatically identifies leftovers." FontSize="11" Foreground="{ThemeResource GwTextSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button x:Name="UninstallSelectedAppButton" Grid.Column="1" Content="Uninstall Selected App..." IsEnabled="False" Style="{StaticResource GwPrimaryButtonStyle}" Click="OnUninstallSelectedAppClick" VerticalAlignment="Center" AutomationProperties.Name="Uninstall selected application" ToolTipService.ToolTip="Select an application to launch uninstaller" />
                                </Grid>
                            </Border>

                            <!-- Leftovers List -->
                            <Grid Grid.Row="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="LeftoversSummaryText" Text="Select an application on the left to inspect leftover directories and registry entries." FontSize="11" Foreground="{ThemeResource GwTextSecondaryBrush}" Margin="0,0,0,6" TextWrapping="Wrap" />
                                
                                <!-- Leftovers Empty State Placeholder -->
                                <Border x:Name="LeftoversEmptyStateBorder" Grid.Row="1" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20">
                                    <StackPanel Spacing="8" HorizontalAlignment="Center" MaxWidth="280">
                                        <FontIcon Glyph="&#xE73E;" FontSize="24" Foreground="{ThemeResource GwSignalGreenBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="No Leftover Traces Found" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="No residual files, caches, or registry entries were detected for this application." FontSize="11" Foreground="{ThemeResource GwTextMutedBrush}" TextAlignment="Center" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <ListView x:Name="LeftoversListView" Grid.Row="1" SelectionMode="Multiple">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="local:LeftoverItemRowViewModel">
                                            <Border Padding="6,5" Margin="0,2" CornerRadius="4" Background="{ThemeResource GwCardBackgroundHoverBrush}">
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="80" />
                                                        <ColumnDefinition Width="75" />
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox MinWidth="0" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" VerticalAlignment="Center" AutomationProperties.Name="{x:Bind Name}" />
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Bind Name}" FontWeight="Medium" FontSize="12" Foreground="{ThemeResource GwTextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{x:Bind FullPath}" FontSize="10" Foreground="{ThemeResource GwTextMutedBrush}" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="{x:Bind Confidence}" FontSize="10" Foreground="{ThemeResource GwTextSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                                    <TextBlock Grid.Column="3" Text="{x:Bind FormattedSize}" FontWeight="SemiBold" FontSize="11" Foreground="{ThemeResource GwAccentBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>

                            <!-- Clean Selected Leftovers Button -->
                            <Button x:Name="CleanSelectedLeftoversButton" Grid.Row="3" Margin="0,10,0,0" Content="Safe Clean Selected Leftovers (Recycle Bin)" IsEnabled="False" Style="{StaticResource GwPrimaryButtonStyle}" HorizontalAlignment="Stretch" Click="OnCleanSelectedLeftoversClick" AutomationProperties.Name="Safe clean selected leftovers" ToolTipService.ToolTip="Select leftover items above to clean" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- ======================================================== -->
            <!-- 3.5 HARDWARE & SYSTEM SPECS PANEL -->
            <!-- ======================================================== -->
            <ScrollViewer x:Name="HardwarePanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="16" MaxWidth="1080" HorizontalAlignment="Stretch">

                    <!-- Header Banner -->
                    <Border Padding="16,14" CornerRadius="8" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Grid ColumnSpacing="12" VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Width="40" Height="40" CornerRadius="7" Background="{ThemeResource GwAccentBgBrush}" BorderBrush="{ThemeResource GwAccentBrush}" BorderThickness="1">
                                    <FontIcon Glyph="&#xE7F8;" FontSize="18" Foreground="{ThemeResource GwAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="Hardware Specifications &amp; Diagnostics" Style="{StaticResource GwPanelTitleStyle}" FontSize="17" />
                                    <TextBlock Text="Comprehensive hardware inventory, live component topology, and signed driver status." Style="{StaticResource GwPanelSubtitleStyle}" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <ProgressBar x:Name="HardwareProgressBar" IsIndeterminate="True" Width="80" Height="4" Visibility="Collapsed" VerticalAlignment="Center" Foreground="{ThemeResource GwAccentBrush}" />
                                <Button Content="← Storage Analyzer" Tag="Storage" Style="{StaticResource GwSecondaryButtonStyle}" Click="OnAssistantActionClick" ToolTipService.ToolTip="Switch to Analyze: Storage Analyzer" />
                                <Button Style="{StaticResource GwSecondaryButtonStyle}" Click="OnRefreshHardwareClick">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <SymbolIcon Symbol="Refresh" />
                                        <TextBlock Text="Refresh Specs" />
                                    </StackPanel>
                                </Button>
                                <Button Content="Copy Specs" Style="{StaticResource GwSecondaryButtonStyle}" Click="OnCopyHardwareSummaryClick" ToolTipService.ToolTip="Copy system specs summary to clipboard" />
                                <Button Content="Export Report" Style="{StaticResource GwPrimaryButtonStyle}" Click="OnExportHardwareReportClick" ToolTipService.ToolTip="Export detailed diagnostic report to .txt file" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Key System KPI Ribbon (4 Hero Tiles: CPU, GPU, RAM, OS/Uptime) -->
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- CPU Hero Tile -->
                        <Border Grid.Column="0" Padding="14,12" CornerRadius="8" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Border Width="28" Height="28" CornerRadius="5" Background="{ThemeResource GwAccentBgBrush}" BorderBrush="{ThemeResource GwAccentBrush}" BorderThickness="1">
                                        <FontIcon Glyph="&#xE950;" FontSize="14" Foreground="{ThemeResource GwAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="PROCESSOR" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource GwTextMutedBrush}" />
                                </StackPanel>
                                <TextBlock x:Name="HwCpuTitleText" Text="Loading..." FontSize="15" FontWeight="Bold" Foreground="{ThemeResource GwTextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="HwCpuSubText" Text="" FontSize="11" Foreground="{ThemeResource GwAccentBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>

                        <!-- GPU Hero Tile -->
                        <Border Grid.Column="1" Padding="14,12" CornerRadius="8" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Border Width="28" Height="28" CornerRadius="5" Background="{ThemeResource GwTealBgBrush}" BorderBrush="{ThemeResource GwTealBrush}" BorderThickness="1">
                                        <FontIcon Glyph="&#xE7F4;" FontSize="14" Foreground="{ThemeResource GwTealBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="GRAPHICS" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource GwTextMutedBrush}" />
                                </StackPanel>
                                <TextBlock x:Name="HwGpuTitleText" Text="Loading..." FontSize="15" FontWeight="Bold" Foreground="{ThemeResource GwTextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="HwGpuSubText" Text="" FontSize="11" Foreground="{ThemeResource GwTealBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>

                        <!-- RAM Hero Tile -->
                        <Border Grid.Column="2" Padding="14,12" CornerRadius="8" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Border Width="28" Height="28" CornerRadius="5" Background="{ThemeResource GwPurpleBgBrush}" BorderBrush="{ThemeResource GwPurpleBrush}" BorderThickness="1">
                                        <FontIcon Glyph="&#xE770;" FontSize="14" Foreground="{ThemeResource GwPurpleBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="SYSTEM MEMORY" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource GwTextMutedBrush}" />
                                </StackPanel>
                                <TextBlock x:Name="HwRamTitleText" Text="Loading..." FontSize="15" FontWeight="Bold" Foreground="{ThemeResource GwTextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="HwRamSubText" Text="" FontSize="11" Foreground="{ThemeResource GwPurpleBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>

                        <!-- OS / Uptime Hero Tile -->
                        <Border Grid.Column="3" Padding="14,12" CornerRadius="8" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Border Width="28" Height="28" CornerRadius="5" Background="{ThemeResource GwAmberBgBrush}" BorderBrush="{ThemeResource GwAmberBrush}" BorderThickness="1">
                                        <FontIcon Glyph="&#xE700;" FontSize="14" Foreground="{ThemeResource GwAmberBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="PLATFORM" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource GwTextMutedBrush}" />
                                </StackPanel>
                                <TextBlock x:Name="HwOsTitleText" Text="Loading..." FontSize="15" FontWeight="Bold" Foreground="{ThemeResource GwTextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="HwOsSubText" Text="" FontSize="11" Foreground="{ThemeResource GwAmberBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Row 1: Processor Specs Card & Motherboard/BIOS Card -->
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Processor Details -->
                        <Border Grid.Column="0" Padding="16,14" CornerRadius="8" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                            <StackPanel Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE950;" FontSize="15" Foreground="{ThemeResource GwAccentBrush}" />
                                    <TextBlock Text="Central Processor (CPU Specs)" Style="{StaticResource GwCardTitleStyle}" />
                                </StackPanel>

                                <Grid RowSpacing="8" ColumnSpacing="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Processor Model" FontSize="12" Foreground="{ThemeResource GwTextSecondaryBrush}" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="HwCpuModelVal" Text="-" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" TextWrapping="Wrap" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Cores / Threads" FontSize="12" Foreground="{ThemeResource GwTextSecondaryBrush}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="HwCpuCoresVal" Text="-" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Max Frequency" FontSize="12" Foreground="{ThemeResource GwTextSecondaryBrush}" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="HwCpuClockVal" Text="-" FontWeight="SemiBold" Foreground="{ThemeResource GwAccentBrush}" />

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Socket / Package" FontSize="12" Foreground="{ThemeResource GwTextSecondaryBrush}" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="HwCpuSocketVal" Text="-" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" TextWrapping="Wrap" />

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Caches &amp; Virt" FontSize="12" Foreground="{ThemeResource GwTextSecondaryBrush}" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" x:Name="HwCpuCacheVal" Text="-" FontWeight="SemiBold" Foreground="{ThemeResource GwTextSecondaryBrush}" TextWrapping="Wrap" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Motherboard & BIOS Card -->
                        <Border Grid.Column="1" Padding="16,14" CornerRadius="8" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                            <StackPanel Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE770;" FontSize="15" Foreground="{ThemeResource GwTealBrush}" />
                                    <TextBlock Text="Motherboard &amp; BIOS Firmware" Style="{StaticResource GwCardTitleStyle}" />
                                </StackPanel>

                                <Grid RowSpacing="8" ColumnSpacing="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Manufacturer" FontSize="12" Foreground="{ThemeResource GwTextSecondaryBrush}" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="HwMoboMfgVal" Text="-" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" TextWrapping="Wrap" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Board Model" FontSize="12" Foreground="{ThemeResource GwTextSecondaryBrush}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="HwMoboModelVal" Text="-" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" TextWrapping="Wrap" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Serial Number" FontSize="12" Foreground="{ThemeResource GwTextSecondaryBrush}" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="HwMoboSerialVal" Text="-" FontWeight="SemiBold" Foreground="{ThemeResource GwTextMutedBrush}" TextWrapping="Wrap" />

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="BIOS Version" FontSize="12" Foreground="{ThemeResource GwTextSecondaryBrush}" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="HwBiosVerVal" Text="-" FontWeight="SemiBold" Foreground="{ThemeResource GwTealBrush}" TextWrapping="Wrap" />

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Secure Boot Status" FontSize="12" Foreground="{ThemeResource GwTextSecondaryBrush}" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" x:Name="HwSecureBootVal" Text="-" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" TextWrapping="Wrap" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Row 2: Physical Disks & Memory Modules -->
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Physical Disks & Controllers -->
                        <Border Grid.Column="0" Padding="16,14" CornerRadius="8" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xEDA2;" FontSize="15" Foreground="{ThemeResource GwAccentBrush}" />
                                    <TextBlock Text="Physical Storage Disks &amp; Controllers" Style="{StaticResource GwCardTitleStyle}" />
                                </StackPanel>

                                <ListView x:Name="HardwareDisksListView" SelectionMode="None" MaxHeight="220">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="engineModels:PhysicalDiskSpecsInfo">
                                            <Border Padding="8,6" Margin="0,2" CornerRadius="5" Background="{ThemeResource GwCardBackgroundHoverBrush}">
                                                <Grid ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <FontIcon Glyph="&#xEDA2;" FontSize="15" Foreground="{ThemeResource GwAccentBrush}" VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Bind Model}" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource GwTextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{x:Bind MediaType}" FontSize="11" Foreground="{ThemeResource GwTextMutedBrush}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Bind FormattedSize}" FontWeight="Bold" FontSize="12" Foreground="{ThemeResource GwAccentBrush}" HorizontalAlignment="Right" />
                                                        <TextBlock Text="{x:Bind InterfaceType}" FontSize="10" Foreground="{ThemeResource GwTextSecondaryBrush}" HorizontalAlignment="Right" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Border>

                        <!-- Installed Memory DIMMs (SPD Topology) -->
                        <Border Grid.Column="1" Padding="16,14" CornerRadius="8" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE770;" FontSize="15" Foreground="{ThemeResource GwPurpleBrush}" />
                                    <TextBlock Text="Memory Modules (SPD Topology)" Style="{StaticResource GwCardTitleStyle}" />
                                </StackPanel>

                                <ListView x:Name="HardwareMemoryListView" SelectionMode="None" MaxHeight="220">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="engineModels:MemoryModuleInfo">
                                            <Border Padding="8,6" Margin="0,2" CornerRadius="5" Background="{ThemeResource GwCardBackgroundHoverBrush}">
                                                <Grid ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <FontIcon Glyph="&#xE770;" FontSize="14" Foreground="{ThemeResource GwPurpleBrush}" VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Bind BankLocator}" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource GwTextPrimaryBrush}" />
                                                        <TextBlock Text="{x:Bind PartNumber}" FontSize="11" Foreground="{ThemeResource GwTextMutedBrush}" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Bind FormattedCapacity}" FontWeight="Bold" FontSize="12" Foreground="{ThemeResource GwPurpleBrush}" HorizontalAlignment="Right" />
                                                        <TextBlock Text="{x:Bind FormattedSpeed}" FontSize="10" Foreground="{ThemeResource GwTextSecondaryBrush}" HorizontalAlignment="Right" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Row 3: Graphics (GPUs) & Network Interfaces -->
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Graphics Adapters List -->
                        <Border Grid.Column="0" Padding="16,14" CornerRadius="8" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE7F4;" FontSize="15" Foreground="{ThemeResource GwTealBrush}" />
                                    <TextBlock Text="Graphics Processors &amp; Displays" Style="{StaticResource GwCardTitleStyle}" />
                                </StackPanel>

                                <ListView x:Name="HardwareGpusListView" SelectionMode="None" MaxHeight="220">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="engineModels:GpuSpecsInfo">
                                            <Border Padding="8,6" Margin="0,2" CornerRadius="5" Background="{ThemeResource GwCardBackgroundHoverBrush}">
                                                <Grid ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <FontIcon Glyph="&#xE7F4;" FontSize="15" Foreground="{ThemeResource GwTealBrush}" VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource GwTextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{x:Bind DriverVersion}" FontSize="10" Foreground="{ThemeResource GwTextMutedBrush}" />
                                                        <TextBlock Text="{x:Bind ResolutionAndRefreshRate}" FontSize="11" Foreground="{ThemeResource GwTextSecondaryBrush}" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="{x:Bind FormattedDedicatedMemory}" FontWeight="Bold" FontSize="11" Foreground="{ThemeResource GwTealBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Border>

                        <!-- Network Adapters List -->
                        <Border Grid.Column="1" Padding="16,14" CornerRadius="8" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE839;" FontSize="15" Foreground="{ThemeResource GwAmberBrush}" />
                                    <TextBlock Text="Network Adapters &amp; Interfaces" Style="{StaticResource GwCardTitleStyle}" />
                                </StackPanel>

                                <ListView x:Name="HardwareNetworkListView" SelectionMode="None" MaxHeight="220">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="engineModels:NetworkAdapterSpecsInfo">
                                            <Border Padding="8,6" Margin="0,2" CornerRadius="5" Background="{ThemeResource GwCardBackgroundHoverBrush}">
                                                <Grid ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <FontIcon Glyph="&#xE839;" FontSize="14" Foreground="{ThemeResource GwAmberBrush}" VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource GwTextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{x:Bind MacAddress}" FontSize="10" Foreground="{ThemeResource GwTextMutedBrush}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Bind FormattedSpeed}" FontWeight="Bold" FontSize="11" Foreground="{ThemeResource GwAmberBrush}" HorizontalAlignment="Right" />
                                                        <TextBlock Text="{x:Bind Status}" FontSize="10" Foreground="{ThemeResource GwTextSecondaryBrush}" HorizontalAlignment="Right" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Row 4: Verified Hardware Drivers Inventory -->
                    <Border Padding="16,14" CornerRadius="8" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                        <StackPanel Spacing="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE770;" FontSize="15" Foreground="{ThemeResource GwAccentBrush}" />
                                    <TextBlock Text="Verified Signed Hardware Drivers" Style="{StaticResource GwCardTitleStyle}" />
                                </StackPanel>
                                <TextBlock x:Name="HardwareDriversCountText" Grid.Column="1" Text="0 drivers verified" FontSize="12" Foreground="{ThemeResource GwTextMutedBrush}" VerticalAlignment="Center" />
                            </Grid>

                            <!-- Drivers Column Header Bar -->
                            <Border Background="{ThemeResource GwCardBackgroundHoverBrush}" Padding="8,5" CornerRadius="4" Margin="0,4,0,2">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Device Class" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource GwTextSecondaryBrush}" />
                                    <TextBlock Grid.Column="1" Text="Device Name" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource GwTextSecondaryBrush}" />
                                    <TextBlock Grid.Column="2" Text="Manufacturer" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource GwTextSecondaryBrush}" />
                                    <TextBlock Grid.Column="3" Text="Driver Version" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource GwTextSecondaryBrush}" />
                                    <TextBlock Grid.Column="4" Text="Driver Date" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource GwTextSecondaryBrush}" HorizontalAlignment="Right" />
                                </Grid>
                            </Border>

                            <ListView x:Name="HardwareDriversListView" SelectionMode="None" MaxHeight="280">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:HardwareDriverRowViewModel">
                                        <Border Padding="8,5" Margin="0,2" CornerRadius="5" Background="{ThemeResource GwCardBackgroundHoverBrush}">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="90" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="130" />
                                                    <ColumnDefinition Width="110" />
                                                    <ColumnDefinition Width="90" />
                                                </Grid.ColumnDefinitions>
                                                <Border Padding="6,1" CornerRadius="3" Background="{ThemeResource GwPageBackgroundBrush}" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind DeviceClass}" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource GwAccentBrush}" />
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{x:Bind DeviceName}" FontWeight="Medium" FontSize="12" Foreground="{ThemeResource GwTextPrimaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Text="{x:Bind Manufacturer}" FontSize="11" Foreground="{ThemeResource GwTextSecondaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="3" Text="{x:Bind DriverVersion}" FontSize="11" Foreground="{ThemeResource GwTextMutedBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="4" Text="{x:Bind DriverDate}" FontSize="11" Foreground="{ThemeResource GwTextMutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- ======================================================== -->
            <!-- 4. AGENTIC AI ASSISTANT & SEARCH PANEL -->
            <!-- ======================================================== -->
            <ScrollViewer x:Name="AssistantPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="16,14">
                <StackPanel Spacing="16" MaxWidth="1100" HorizontalAlignment="Stretch">
                    
                    <!-- 1. Header Card (Agent Identity & Active Provider Status) -->
                    <Border Padding="16,12" CornerRadius="8" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            
                            <Grid ColumnSpacing="12" VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Width="40" Height="40" CornerRadius="7" Background="{ThemeResource GwPurpleBgBrush}" BorderBrush="{ThemeResource GwPurpleBrush}" BorderThickness="1">
                                    <FontIcon Glyph="&#xE946;" FontSize="18" Foreground="{ThemeResource GwPurpleBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="Groundwork System Companion &amp; AI Assistant" Style="{StaticResource GwPanelTitleStyle}" FontSize="17" />
                                    <TextBlock Text="System-aware Windows diagnostics, guided investigations, and safe operations powered by 20 registered live telemetry tools." Style="{StaticResource GwPanelSubtitleStyle}" />
                                </StackPanel>
                            </Grid>

                            <Border Grid.Column="1" Padding="10,6" CornerRadius="6" Background="{ThemeResource GwPurpleBgBrush}" BorderBrush="{ThemeResource GwPurpleBrush}" BorderThickness="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Ellipse Width="8" Height="8" Fill="{ThemeResource GwTealBrush}" />
                                    <TextBlock x:Name="AssistantProviderBadge" Text="Setup Required" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource GwPurpleBrush}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- PROVIDER SETUP REQUIRED HERO CARD (Visible if no provider configured) -->
                        <StackPanel x:Name="AgentProviderSetupRequiredGrid" Visibility="Visible" Spacing="16">
                            <Border Padding="28,24" CornerRadius="10" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                                <StackPanel Spacing="18" HorizontalAlignment="Center" MaxWidth="860">
                                    <StackPanel Orientation="Horizontal" Spacing="14" HorizontalAlignment="Center">
                                        <Border Width="48" Height="48" CornerRadius="10" Background="{ThemeResource GwPurpleBgBrush}" BorderBrush="{ThemeResource GwPurpleBrush}" BorderThickness="1">
                                            <FontIcon Glyph="&#xE946;" FontSize="24" Foreground="{ThemeResource GwPurpleBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Text="AI Provider Setup Required" FontSize="20" FontWeight="Bold" Foreground="{ThemeResource GwTextPrimaryBrush}" />
                                            <TextBlock Text="Connect a local or cloud AI provider to activate the Groundwork Agent" FontSize="13" Foreground="{ThemeResource GwTextSecondaryBrush}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <TextBlock Text="To ensure genuine reasoning and eliminate fake or hardcoded answers, the Agent requires an active AI provider. Groundwork never runs background bloat—you choose whether to connect a 100% free offline on-device model or a cloud API." 
                                               FontSize="13" Foreground="{ThemeResource GwTextSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" LineHeight="20" />

                                    <Grid ColumnSpacing="12" Margin="0,6,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" MinWidth="180" />
                                            <ColumnDefinition Width="*" MinWidth="180" />
                                            <ColumnDefinition Width="*" MinWidth="180" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Local Ollama Card -->
                                        <Border Grid.Column="0" Padding="14,12" CornerRadius="8" Background="{ThemeResource GwCardBackgroundHoverBrush}" BorderBrush="{ThemeResource GwAccentBrush}" BorderThickness="1">
                                            <StackPanel Spacing="6">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon Glyph="&#xE7F4;" FontSize="16" Foreground="{ThemeResource GwAccentBrush}" />
                                                    <TextBlock Text="Ollama &amp; LM Studio" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" />
                                                </StackPanel>
                                                <TextBlock Text="100% Free &amp; Private. Runs offline on-device via local loopback." FontSize="11" Foreground="{ThemeResource GwTextMutedBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Cloud Gemini Card -->
                                        <Border Grid.Column="1" Padding="14,12" CornerRadius="8" Background="{ThemeResource GwTealBgBrush}" BorderBrush="{ThemeResource GwTealBrush}" BorderThickness="1">
                                            <StackPanel Spacing="6">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon Glyph="&#xE9CE;" FontSize="16" Foreground="{ThemeResource GwTealBrush}" />
                                                    <TextBlock Text="Gemini, Claude &amp; Mistral" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" />
                                                </StackPanel>
                                                <TextBlock Text="Fast cloud reasoning and optional web search with your own API key." FontSize="11" Foreground="{ThemeResource GwTextMutedBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Cloud OpenAI Card -->
                                        <Border Grid.Column="2" Padding="14,12" CornerRadius="8" Background="{ThemeResource GwPurpleBgBrush}" BorderBrush="{ThemeResource GwPurpleBrush}" BorderThickness="1">
                                            <StackPanel Spacing="6">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon Glyph="&#xE72D;" FontSize="16" Foreground="{ThemeResource GwPurpleBrush}" />
                                                    <TextBlock Text="OpenAI, Groq &amp; DeepSeek" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" />
                                                </StackPanel>
                                                <TextBlock Text="GPT-4o or any OpenAI-compatible endpoint (Groq, DeepSeek, OpenRouter)." FontSize="11" Foreground="{ThemeResource GwTextMutedBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <Button Style="{StaticResource GwPrimaryButtonStyle}" Padding="20,10" HorizontalAlignment="Center" Click="OnConfigureProviderFromAgentClick">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <SymbolIcon Symbol="Setting" />
                                            <TextBlock Text="Configure AI Provider in Settings" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- AGENT ACTIVE CONTENT PANEL (Only visible when provider is configured) -->
                        <StackPanel x:Name="AgentActiveContentPanel" Visibility="Collapsed" Spacing="16">

                        <!-- 2. Interactive Input Bar -->
                        <Border Padding="14,12" CornerRadius="8" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="AssistantQuestionBox" PlaceholderText="Describe a symptom or ask Groundwork: e.g. 'My computer feels slower than usual', 'Why is my C drive almost full?', 'Switch my DNS to Cloudflare'..." VerticalAlignment="Center" KeyDown="OnAssistantQuestionBoxKeyDown" AutomationProperties.Name="Groundwork Agent question input" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="AssistantCancelButton" Content="Cancel" Visibility="Collapsed" Style="{StaticResource GwSecondaryButtonStyle}" Click="OnCancelAssistantQueryClick" VerticalAlignment="Center" AutomationProperties.Name="Cancel active agent query" />
                                    <Button x:Name="AssistantAnalyzeButton" Style="{StaticResource GwPrimaryButtonStyle}" Click="OnAskOperatorClick" VerticalAlignment="Center" AutomationProperties.Name="Submit query to Groundwork Agent">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <SymbolIcon Symbol="Find" />
                                            <TextBlock Text="Investigate / Ask" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 3. VIEW MODE A: STANDBY PROMPT CARDS (Visible before a question is asked) -->
                        <StackPanel x:Name="AssistantStandbyGrid" Visibility="Visible" Spacing="14">
                            <TextBlock Text="Suggested System Investigations &amp; Guided Requests" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" />
                            
                            <Grid RowSpacing="10" ColumnSpacing="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Prompt 1: Performance Investigation -->
                                <Button Grid.Row="0" Grid.Column="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="14,12" CornerRadius="8" Style="{StaticResource GwSecondaryButtonStyle}" Click="OnOperatorPromptPresetClick" Tag="My computer feels slower than usual. Can you investigate?">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="34" Height="34" CornerRadius="6" Background="{ThemeResource GwPurpleBgBrush}" BorderBrush="{ThemeResource GwPurpleBrush}" BorderThickness="1" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE945;" FontSize="16" Foreground="{ThemeResource GwPurpleBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="Investigate Slow PC &amp; Resource Bottlenecks" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" TextWrapping="Wrap" />
                                            <TextBlock Text="Inspect live CPU/RAM pressure, top processes, power scheme, and startup load" FontSize="11" Foreground="{ThemeResource GwTextMutedBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </Button>

                                <!-- Prompt 2: Storage & Space Investigation -->
                                <Button Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="14,12" CornerRadius="8" Style="{StaticResource GwSecondaryButtonStyle}" Click="OnOperatorPromptPresetClick" Tag="Why is my C drive almost full? Help me find reclaimable space.">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="34" Height="34" CornerRadius="6" Background="{ThemeResource GwTealBgBrush}" BorderBrush="{ThemeResource GwTealBrush}" BorderThickness="1" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xEDA2;" FontSize="16" Foreground="{ThemeResource GwTealBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="Why Is My C: Drive Almost Full?" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" TextWrapping="Wrap" />
                                            <TextBlock Text="Audit mounted volume capacity, Recycle Bin, temp caches, and largest applications" FontSize="11" Foreground="{ThemeResource GwTextMutedBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </Button>

                                <!-- Prompt 3: Network & DNS Connectivity -->
                                <Button Grid.Row="1" Grid.Column="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="14,12" CornerRadius="8" Style="{StaticResource GwSecondaryButtonStyle}" Click="OnOperatorPromptPresetClick" Tag="My internet keeps disconnecting or feels slow. Check gateway and DNS.">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="34" Height="34" CornerRadius="6" Background="{ThemeResource GwCardBackgroundHoverBrush}" BorderBrush="{ThemeResource GwAccentBrush}" BorderThickness="1" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE839;" FontSize="16" Foreground="{ThemeResource GwAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="Troubleshoot Internet, Gateway &amp; DNS" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" TextWrapping="Wrap" />
                                            <TextBlock Text="Test active adapters, ping default gateway and 1.1.1.1, and verify DNS resolution" FontSize="11" Foreground="{ThemeResource GwTextMutedBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </Button>

                                <!-- Prompt 4: Startup Time Optimization -->
                                <Button Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="14,12" CornerRadius="8" Style="{StaticResource GwSecondaryButtonStyle}" Click="OnOperatorPromptPresetClick" Tag="Help me improve startup time and inspect high-impact startup apps.">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="34" Height="34" CornerRadius="6" Background="{ThemeResource GwAmberBgBrush}" BorderBrush="{ThemeResource GwAmberBrush}" BorderThickness="1" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE7E8;" FontSize="16" Foreground="{ThemeResource GwAmberBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="Improve Windows Startup &amp; Logon Time" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" TextWrapping="Wrap" />
                                            <TextBlock Text="Inspect Registry Run keys, Startup folders, and Scheduled Logon Tasks with impact ratings" FontSize="11" Foreground="{ThemeResource GwTextMutedBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </Button>

                                <!-- Prompt 5: Safe Operation Proposal (Switch DNS / Clean Temp) -->
                                <Button Grid.Row="2" Grid.Column="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="14,12" CornerRadius="8" Style="{StaticResource GwSecondaryButtonStyle}" Click="OnOperatorPromptPresetClick" Tag="Switch my DNS to Cloudflare.">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="34" Height="34" CornerRadius="6" Background="{ThemeResource GwPurpleBgBrush}" BorderBrush="{ThemeResource GwPurpleBrush}" BorderThickness="1" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE774;" FontSize="16" Foreground="{ThemeResource GwPurpleBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="Switch DNS to Cloudflare (1.1.1.1)" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" TextWrapping="Wrap" />
                                            <TextBlock Text="Inspect current DNS state and prepare a reversible Safe Operation proposal" FontSize="11" Foreground="{ThemeResource GwTextMutedBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </Button>

                                <!-- Prompt 6: Windows Health, Event Logs & Services -->
                                <Button Grid.Row="2" Grid.Column="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="14,12" CornerRadius="8" Style="{StaticResource GwSecondaryButtonStyle}" Click="OnOperatorPromptPresetClick" Tag="Can you check the health of my computer and explain recent Windows errors?">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="34" Height="34" CornerRadius="6" Background="{ThemeResource GwTealBgBrush}" BorderBrush="{ThemeResource GwTealBrush}" BorderThickness="1" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE90F;" FontSize="16" Foreground="{ThemeResource GwTealBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="Check Windows Health, Event Errors &amp; Services" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" TextWrapping="Wrap" />
                                            <TextBlock Text="Audit System/Application Event Logs, core Windows services, and pending reboot state" FontSize="11" Foreground="{ThemeResource GwTextMutedBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                        </Grid>

                        <!-- Grounding Principles & Privacy Architecture Card -->
                        <Border Margin="0,8,0,0" Padding="18,16" CornerRadius="8" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE72E;" FontSize="14" Foreground="{ThemeResource GwAccentBrush}" />
                                    <TextBlock Text="Groundwork Agent Architecture &amp; Safety Guarantees" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" />
                                </StackPanel>
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <TextBlock Text="20 Registered Live Tools" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" />
                                        <TextBlock Text="Every investigation inspects real Windows telemetry, separates confirmed evidence from hypotheses, and works with or without an external LLM." FontSize="11" Foreground="{ThemeResource GwTextMutedBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock Text="10-Step Safe Operation Engine" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" />
                                        <TextBlock Text="No unrestricted shell execution. Every system change captures original state, requires explicit approval, verifies results, and logs rollback state." FontSize="11" Foreground="{ThemeResource GwTextMutedBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="4">
                                        <TextBlock Text="Local-First &amp; DPAPI Protected" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" />
                                        <TextBlock Text="Connect local Ollama models offline or optional cloud providers with Windows DPAPI encrypted API keys and automatic path redaction." FontSize="11" Foreground="{ThemeResource GwTextMutedBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 4. VIEW MODE B: ACTIVE AGENT RESPONSE (Shown after query execution) -->
                    <StackPanel x:Name="AssistantResultsGrid" Visibility="Collapsed" Spacing="16">
                        
                        <!-- Query Context Header + New Query Button -->
                        <Border Padding="12,10" CornerRadius="6" Background="{ThemeResource GwCardBackgroundHoverBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock Text="Agent Query:" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource GwTextSecondaryBrush}" />
                                    <TextBlock x:Name="AssistantActiveQueryLabel" Text="" FontSize="12" FontWeight="Bold" Foreground="{ThemeResource GwAccentBrush}" TextTrimming="CharacterEllipsis" MaxWidth="600" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="New Query / Reset" Style="{StaticResource GwSecondaryButtonStyle}" Padding="10,4" FontSize="11" Click="OnResetAssistantQueryClick" />
                            </Grid>
                        </Border>

                        <!-- Dynamic Contextual KPI Cards -->
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Card 1 -->
                            <Border Grid.Column="0" Padding="14,12" CornerRadius="8" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                                <StackPanel Spacing="6">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Border Width="28" Height="28" CornerRadius="5" Background="{ThemeResource GwAccentBgBrush}" BorderBrush="{ThemeResource GwAccentBrush}" BorderThickness="1">
                                            <FontIcon x:Name="AssistantTargetKpiIcon" Glyph="&#xEDA2;" FontSize="14" Foreground="{ThemeResource GwAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock x:Name="AssistantTargetKpiTitle" Text="Matched Target" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource GwTextSecondaryBrush}" />
                                    </StackPanel>
                                    <TextBlock x:Name="AssistantTargetKpiValue" Text="-" FontSize="20" FontWeight="Bold" Foreground="{ThemeResource GwTextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="AssistantTargetKpiSub" Text="" FontSize="11" Foreground="{ThemeResource GwTextMutedBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>

                            <!-- Card 2 -->
                            <Border Grid.Column="1" Padding="14,12" CornerRadius="8" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                                <StackPanel Spacing="6">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Border Width="28" Height="28" CornerRadius="5" Background="{ThemeResource GwAmberBgBrush}" BorderBrush="{ThemeResource GwAmberBrush}" BorderThickness="1">
                                            <FontIcon x:Name="AssistantWasteKpiIcon" Glyph="&#xE74D;" FontSize="14" Foreground="{ThemeResource GwAmberBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock x:Name="AssistantWasteKpiTitle" Text="Allocated Space" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource GwTextSecondaryBrush}" />
                                    </StackPanel>
                                    <TextBlock x:Name="AssistantWasteKpiValue" Text="-" FontSize="20" FontWeight="Bold" Foreground="{ThemeResource GwAmberBrush}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="AssistantWasteKpiSub" Text="" FontSize="11" Foreground="{ThemeResource GwTextMutedBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>

                            <!-- Card 3 -->
                            <Border Grid.Column="2" Padding="14,12" CornerRadius="8" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                                <StackPanel Spacing="6">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Border Width="28" Height="28" CornerRadius="5" Background="{ThemeResource GwPurpleBgBrush}" BorderBrush="{ThemeResource GwPurpleBrush}" BorderThickness="1">
                                            <FontIcon x:Name="AssistantAppKpiIcon" Glyph="&#xE71D;" FontSize="14" Foreground="{ThemeResource GwPurpleBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock x:Name="AssistantAppKpiTitle" Text="Location Status" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource GwTextSecondaryBrush}" />
                                    </StackPanel>
                                    <TextBlock x:Name="AssistantAppKpiValue" Text="-" FontSize="20" FontWeight="Bold" Foreground="{ThemeResource GwTextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="AssistantAppKpiSub" Text="" FontSize="11" Foreground="{ThemeResource GwTextMutedBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Safe Operation Approval Gate Banner (Top Priority Action Gate) -->
                        <Border x:Name="AgentPendingApprovalBorder" Visibility="Collapsed" Padding="14,12" CornerRadius="8" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwTealBrush}" BorderThickness="1">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="Safe Operation Approval Gate (10-Step Verified Modification)" FontSize="13" FontWeight="Bold" Foreground="{ThemeResource GwTealBrush}" />
                                    <TextBlock x:Name="AgentPendingApprovalText" Text="" FontSize="12" Foreground="{ThemeResource GwTextPrimaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button x:Name="ApprovePendingAgentProposalButton" Grid.Column="1" Content="Approve &amp; Execute..." Style="{StaticResource GwPrimaryButtonStyle}" Click="OnApprovePendingAgentProposalClick" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- Agent Analysis & Formatted Reasoning -->
                        <Border Padding="18,16" CornerRadius="8" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                            <StackPanel Spacing="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Border Width="26" Height="26" CornerRadius="5" Background="{ThemeResource GwPurpleBgBrush}" BorderBrush="{ThemeResource GwPurpleBrush}" BorderThickness="1">
                                            <FontIcon Glyph="&#xE946;" FontSize="13" Foreground="{ThemeResource GwPurpleBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="Agent Analysis &amp; Findings" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Copy Response" Style="{StaticResource GwSecondaryButtonStyle}" Padding="10,4" FontSize="11" Click="OnCopyAssistantResponseClick" ToolTipService.ToolTip="Copy response to clipboard" />
                                </Grid>

                                <!-- Rich Formatted Output Container -->
                                <RichTextBlock x:Name="AssistantAnswerRichBlock" IsTextSelectionEnabled="True" LineHeight="24" FontSize="13" Foreground="{ThemeResource GwTextPrimaryBrush}" />
                            </StackPanel>
                        </Border>

                        <!-- Actionable Recommendations -->
                        <StackPanel Spacing="10">
                            <TextBlock Text="Recommended Actions" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" />
                            
                            <ItemsControl x:Name="AssistantRecommendationsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,8" Padding="14,12" CornerRadius="8" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="6" Background="{ThemeResource GwCardBackgroundHoverBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1" VerticalAlignment="Center">
                                                    <FontIcon Glyph="{Binding IconGlyph}" FontSize="16" Foreground="{Binding IconColor}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" />
                                                    <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{ThemeResource GwTextSecondaryBrush}" TextWrapping="Wrap" />
                                                </StackPanel>

                                                <Button Grid.Column="2" Content="{Binding ActionButtonText}" Tag="{Binding ActionTag}" Style="{StaticResource GwPrimaryButtonStyle}" Click="OnAssistantActionClick" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Located Items & Culprits Table -->
                        <StackPanel Spacing="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Located Elements &amp; Artifacts" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" VerticalAlignment="Center" />
                                <TextBlock x:Name="AssistantItemsCountLabel" Grid.Column="1" Text="0 items detected" FontSize="12" Foreground="{ThemeResource GwTextMutedBrush}" VerticalAlignment="Center" />
                            </Grid>

                            <Border CornerRadius="8" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                                <ListView x:Name="AssistantItemsListView" SelectionMode="None" MaxHeight="380">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="10,8" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="0,0,0,1">
                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <Border Grid.Column="0" Width="32" Height="32" CornerRadius="6" Background="{ThemeResource GwCardBackgroundHoverBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1" VerticalAlignment="Center">
                                                        <FontIcon Glyph="{Binding Glyph}" FontSize="15" Foreground="{Binding GlyphColor}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>

                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding DisplayPath}" FontSize="11" Foreground="{ThemeResource GwTextMutedBrush}" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>

                                                    <Border Grid.Column="2" Padding="6,2" CornerRadius="4" Background="{Binding BadgeBackground}" VerticalAlignment="Center" Margin="8,0">
                                                        <TextBlock Text="{Binding CategoryBadge}" FontSize="10" FontWeight="SemiBold" Foreground="{Binding BadgeForeground}" />
                                                    </Border>

                                                    <TextBlock Grid.Column="3" Text="{Binding FormattedSize}" FontSize="13" FontWeight="Bold" Foreground="{ThemeResource GwAccentBrush}" VerticalAlignment="Center" MinWidth="70" TextAlignment="Right" />

                                                    <!-- Item Inline Explorer Button -->
                                                    <Button Grid.Column="4" Padding="6,4" ToolTipService.ToolTip="Open folder in File Explorer" Tag="{Binding FullPath}" Click="OnOpenItemInExplorerClick" Style="{StaticResource GwSecondaryButtonStyle}" VerticalAlignment="Center">
                                                        <SymbolIcon Symbol="OpenLocal" />
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Border>
                        </StackPanel>

                    </StackPanel>
                    <!-- End of AssistantResultsGrid -->

                    </StackPanel>
                    <!-- End of AgentActiveContentPanel -->

                </StackPanel>
            </ScrollViewer>

            <!-- ======================================================== -->
            <!-- 6. FILE ORGANIZATION PANEL -->
            <!-- ======================================================== -->
            <ScrollViewer x:Name="OrganizePanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="16">
                    <Border Padding="16,14" CornerRadius="8" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                        <Grid ColumnSpacing="12" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="40" Height="40" CornerRadius="7" Background="{ThemeResource GwAmberBgBrush}" BorderBrush="{ThemeResource GwAmberBrush}" BorderThickness="1">
                                <SymbolIcon Symbol="Folder" Foreground="{ThemeResource GwAmberBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Smart File Organizer &amp; Safe Operation History" Style="{StaticResource GwPanelTitleStyle}" FontSize="17" />
                                <TextBlock Text="Cleanly sort and organize your files by category or date, and review or rollback any executed system operation." Style="{StaticResource GwPanelSubtitleStyle}" />
                            </StackPanel>
                            <Button Grid.Column="2" Content="← Storage Cleanup" Tag="Cleanup" Style="{StaticResource GwSecondaryButtonStyle}" Click="OnAssistantActionClick" VerticalAlignment="Center" ToolTipService.ToolTip="Switch to Maintenance: Storage Cleanup &amp; Recommendations" />
                        </Grid>
                    </Border>

                    <Border Padding="14,12" CornerRadius="8" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="OrganizeFolderBox" PlaceholderText="Folder path to preview organization..." VerticalAlignment="Center" AutomationProperties.Name="Target folder to preview organization" />
                            <ComboBox x:Name="OrganizeRuleTypeComboBox" Grid.Column="1" SelectedIndex="0" HorizontalAlignment="Stretch" VerticalAlignment="Center" AutomationProperties.Name="Organization grouping rule">
                                <ComboBoxItem Content="By File Category" Tag="category" />
                                <ComboBoxItem Content="By Modified Month" Tag="date" />
                                <ComboBoxItem Content="By Extension" Tag="extension" />
                            </ComboBox>
                            <Button Grid.Column="2" Content="Preview Plan" Style="{StaticResource GwPrimaryButtonStyle}" Click="OnPreviewOrganizeClick" VerticalAlignment="Center" AutomationProperties.Name="Generate organization plan preview" />
                            <Button Grid.Column="3" x:Name="ExecuteOrganizeButton" Content="Execute Organization (Reversible)" Style="{StaticResource GwPrimaryButtonStyle}" Click="OnExecuteOrganizeClick" VerticalAlignment="Center" AutomationProperties.Name="Execute folder organization with safe undo" />
                            <Button Grid.Column="4" Content="Refresh History" Style="{StaticResource GwSecondaryButtonStyle}" Click="OnRefreshOrganizationHistoryClick" VerticalAlignment="Center" AutomationProperties.Name="Refresh organization undo history" />
                        </Grid>
                    </Border>

                    <Border Padding="16,14" CornerRadius="8" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Organization Preview &amp; Undo History" Style="{StaticResource GwCardTitleStyle}" />
                            <TextBlock x:Name="OrganizationStatusText" Text="Select a target folder above to preview organization rules and safe stream-preserving undo history." Style="{StaticResource GwPanelSubtitleStyle}" />
                            
                            <!-- Organize Empty State -->
                            <Border x:Name="OrganizationEmptyStateBorder" Visibility="Visible" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="32">
                                <StackPanel Spacing="12" HorizontalAlignment="Center" MaxWidth="380">
                                    <Border Width="48" Height="48" CornerRadius="10" Background="{ThemeResource GwAmberBgBrush}" BorderBrush="{ThemeResource GwAmberBrush}" BorderThickness="1" HorizontalAlignment="Center">
                                        <FontIcon Glyph="&#xE8B7;" FontSize="20" Foreground="{ThemeResource GwAmberBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="No Preview Generated" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="Enter a folder path above and click 'Preview Plan' to preview how files will be categorized and safely organized." FontSize="11" Foreground="{ThemeResource GwTextMutedBrush}" TextWrapping="Wrap" TextAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <ListView x:Name="OrganizationHistoryListView" ItemsSource="{x:Bind OrganizationPlanItems}" SelectionMode="None" MaxHeight="360" Visibility="Collapsed">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:OrganizationPlanItemViewModel">
                                        <Border Padding="10,8" Margin="0,2" CornerRadius="6" Background="{ThemeResource GwCardBackgroundHoverBrush}">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="130" />
                                                    <ColumnDefinition Width="90" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="32" Height="32" CornerRadius="6" Background="{ThemeResource GwAmberBgBrush}" BorderBrush="{ThemeResource GwAmberBrush}" BorderThickness="1" VerticalAlignment="Center">
                                                    <FontIcon Glyph="&#xE8B7;" FontSize="14" Foreground="{ThemeResource GwAmberBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                    <TextBlock Text="{x:Bind FileName}" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource GwTextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <TextBlock Text="Destination:" FontSize="10" Foreground="{ThemeResource GwTextMutedBrush}" />
                                                        <TextBlock Text="{x:Bind TargetSubfolder}" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource GwTealBrush}" FontFamily="Consolas" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </StackPanel>
                                                <Border Grid.Column="2" Padding="6,2" CornerRadius="4" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind Category}" FontSize="10" FontWeight="Medium" Foreground="{ThemeResource GwTextSecondaryBrush}" />
                                                </Border>
                                                <TextBlock Grid.Column="3" Text="{x:Bind FormattedSize}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource GwAccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>

                    <!-- Safe Operation Audit Ledger & One-Click Rollback -->
                    <Border Padding="16,14" CornerRadius="8" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                        <StackPanel Spacing="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Safe Operation History &amp; Rollback Ledger" Style="{StaticResource GwCardTitleStyle}" />
                                    <TextBlock x:Name="OperationHistorySummaryText" Text="Every modifying operation (File Organization, Power Plan, Startup Toggle, Windows Setting) is verified and recorded here with one-click Undo." Style="{StaticResource GwPanelSubtitleStyle}" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Refresh Ledger" Style="{StaticResource GwSecondaryButtonStyle}" Click="OnRefreshOperationHistoryClick" VerticalAlignment="Center" />
                            </Grid>
                            <ListView x:Name="OperationHistoryLedgerListView" SelectionMode="None" MaxHeight="360">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:OperationHistoryRowViewModel">
                                        <Border Padding="12,10" Margin="0,3" CornerRadius="6" Background="{ThemeResource GwCardBackgroundHoverBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Spacing="3">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Text="{x:Bind DisplayName}" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource GwTextPrimaryBrush}" />
                                                        <TextBlock Text="{x:Bind ExecutedAtDisplay}" FontSize="11" Foreground="{ThemeResource GwTextMutedBrush}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <TextBlock Text="{x:Bind TargetDescription}" FontSize="11" Foreground="{ThemeResource GwTextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{x:Bind VerificationSummary}" FontSize="11" Foreground="{ThemeResource GwTealBrush}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <Border Grid.Column="1" Padding="8,3" CornerRadius="4" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind StatusBadge}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource GwAccentBrush}" />
                                                </Border>
                                                <Button Grid.Column="2" Content="Undo / Rollback" Tag="{x:Bind ExecutionId}" Visibility="{x:Bind RollbackButtonVisibility}" Style="{StaticResource GwSecondaryButtonStyle}" Click="OnRollbackOperationClick" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ======================================================== -->
            <!-- MODULE A: OVERVIEW DASHBOARD -->
            <!-- ======================================================== -->
            <ScrollViewer x:Name="OverviewPanel" Visibility="Visible" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="16">
                    <Border Padding="16,14" CornerRadius="8" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="System Overview &amp; Companion Dashboard" Style="{StaticResource GwPanelTitleStyle}" FontSize="17" />
                                <TextBlock x:Name="OverviewSubtitleText" Text="Understand your PC, launch targeted investigations, and review live hardware, storage, network, and startup telemetry." Style="{StaticResource GwPanelSubtitleStyle}" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Refresh Overview" Style="{StaticResource GwPrimaryButtonStyle}" Click="OnRefreshOverviewClick" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Actionable Telemetry Summary Grid -->
                    <Grid ColumnSpacing="12" RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Grid.Column="0" Padding="14,12" CornerRadius="8" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                            <StackPanel Spacing="4">
                                <TextBlock Text="PROCESSOR &amp; LIVE LOAD" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource GwTextMutedBrush}" />
                                <TextBlock x:Name="OverviewCpuValueText" Text="Inspecting..." FontSize="15" FontWeight="Bold" Foreground="{ThemeResource GwTextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="OverviewCpuSubText" Text="Live utilization &amp; topology" FontSize="11" Foreground="{ThemeResource GwTextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="0" Grid.Column="1" Padding="14,12" CornerRadius="8" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                            <StackPanel Spacing="4">
                                <TextBlock Text="PHYSICAL MEMORY (RAM)" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource GwTextMutedBrush}" />
                                <TextBlock x:Name="OverviewRamValueText" Text="Inspecting..." FontSize="15" FontWeight="Bold" Foreground="{ThemeResource GwAccentBrush}" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="OverviewRamSubText" Text="Available &amp; committed memory" FontSize="11" Foreground="{ThemeResource GwTextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="0" Grid.Column="2" Padding="14,12" CornerRadius="8" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                            <StackPanel Spacing="4">
                                <TextBlock Text="STORAGE VOLUMES" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource GwTextMutedBrush}" />
                                <TextBlock x:Name="OverviewStorageValueText" Text="Inspecting..." FontSize="15" FontWeight="Bold" Foreground="{ThemeResource GwTealBrush}" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="OverviewStorageSubText" Text="Mounted volumes capacity" FontSize="11" Foreground="{ThemeResource GwTextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="0" Padding="14,12" CornerRadius="8" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                            <StackPanel Spacing="4">
                                <TextBlock Text="WINDOWS &amp; SERVICING" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource GwTextMutedBrush}" />
                                <TextBlock x:Name="OverviewOsStatusText" Text="Inspecting..." FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="OverviewOsSubText" Text="Build, uptime &amp; reboot state" FontSize="11" Foreground="{ThemeResource GwTextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="1" Padding="14,12" CornerRadius="8" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                            <StackPanel Spacing="4">
                                <TextBlock Text="STARTUP &amp; POWER PLAN" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource GwTextMutedBrush}" />
                                <TextBlock x:Name="OverviewStartupStatusText" Text="Inspecting..." FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="OverviewStartupSubText" Text="Active power scheme &amp; logon entries" FontSize="11" Foreground="{ThemeResource GwTextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="2" Padding="14,12" CornerRadius="8" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                            <StackPanel Spacing="4">
                                <TextBlock Text="NETWORK &amp; PROTECTION" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource GwTextMutedBrush}" />
                                <TextBlock x:Name="OverviewNetworkValueText" Text="Inspecting..." FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="OverviewNetworkSubText" Text="Adapter link &amp; System Protection" FontSize="11" Foreground="{ThemeResource GwTextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Signature Feature: One-Click Groundwork Investigations & Quick Agent Bar -->
                    <Border Padding="16,14" CornerRadius="8" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                        <StackPanel Spacing="12">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Guided Groundwork Investigations &amp; System Assistant" Style="{StaticResource GwCardTitleStyle}" />
                                <TextBlock Text="Run a targeted, multi-tool diagnostic investigation or ask the Groundwork Agent in plain English." Style="{StaticResource GwPanelSubtitleStyle}" />
                            </StackPanel>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="OverviewAgentQueryBox" Grid.Column="0" PlaceholderText="Describe a symptom or ask Groundwork (e.g., 'My PC feels slower than usual', 'Switch DNS to Cloudflare', 'Why is C: full?')..." KeyDown="OnOverviewAgentQueryBoxKeyDown" />
                                <Button Grid.Column="1" Content="Ask Groundwork Agent" Style="{StaticResource GwPrimaryButtonStyle}" Click="OnOverviewAskAgentClick" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Investigate Slow PC (Performance)" Tag="Performance" Style="{StaticResource GwPrimaryButtonStyle}" Click="OnQuickInvestigationLaunchClick" />
                                <Button Content="Investigate Full Drive (Storage)" Tag="Storage" Style="{StaticResource GwSecondaryButtonStyle}" Click="OnQuickInvestigationLaunchClick" />
                                <Button Content="Investigate Internet / DNS (Network)" Tag="Network" Style="{StaticResource GwSecondaryButtonStyle}" Click="OnQuickInvestigationLaunchClick" />
                                <Button Content="Check PC Health &amp; Errors" Tag="WindowsHealth" Style="{StaticResource GwSecondaryButtonStyle}" Click="OnQuickInvestigationLaunchClick" />
                                <Button Content="Audit Startup Impact" Tag="Startup" Style="{StaticResource GwSecondaryButtonStyle}" Click="OnQuickInvestigationLaunchClick" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Two-Column Live Processes & System Findings / Recent Operations -->
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.15*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: Live Top Resource-Consuming Processes -->
                        <Border Grid.Column="0" Padding="16,14" CornerRadius="8" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Active Processes Consuming Most Memory (Live Snapshot)" Style="{StaticResource GwCardTitleStyle}" />
                                <ListView x:Name="OverviewTopProcessesListView" SelectionMode="None" MaxHeight="290">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="local:ProcessRowViewModel">
                                            <Border Padding="10,6" Margin="0,2" CornerRadius="6" Background="{ThemeResource GwCardBackgroundHoverBrush}">
                                                <Grid ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="170" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="95" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{x:Bind ProcessName}" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource GwTextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="1" Text="{x:Bind SummaryLine}" FontSize="11" Foreground="{ThemeResource GwTextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="2" Text="{x:Bind WorkingSetDisplay}" FontSize="12" FontWeight="Bold" Foreground="{ThemeResource GwAccentBrush}" HorizontalAlignment="Right" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Border>

                        <!-- Right: Recent Diagnostic Findings & Safe Operations -->
                        <Border Grid.Column="1" Padding="16,14" CornerRadius="8" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                            <StackPanel Spacing="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="System Advisories &amp; Recent Safe Operations" Style="{StaticResource GwCardTitleStyle}" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Content="Rollback Ledger" Style="{StaticResource GwSecondaryButtonStyle}" Padding="10,4" FontSize="11" Click="OnOverviewOpenLedgerClick" />
                                </Grid>
                                <ListView x:Name="OverviewAdvisoriesListView" SelectionMode="None" MaxHeight="290">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="local:OverviewAdvisoryRowViewModel">
                                            <Border Padding="10,8" Margin="0,2" CornerRadius="6" Background="{ThemeResource GwCardBackgroundHoverBrush}">
                                                <StackPanel Spacing="2">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Text="{x:Bind CategoryBadge}" FontWeight="Bold" FontSize="11" Foreground="{ThemeResource GwTealBrush}" />
                                                        <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource GwTextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <TextBlock Text="{x:Bind Detail}" FontSize="11" Foreground="{ThemeResource GwTextSecondaryBrush}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- ======================================================== -->
            <!-- MODULE C: OPTIMIZE (POWER, STARTUP & WINDOWS SETTINGS) -->
            <!-- ======================================================== -->
            <ScrollViewer x:Name="OptimizePanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="16">
                    <Border Padding="16,14" CornerRadius="8" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="Optimize Windows — Power, Startup &amp; Transparent Configuration" Style="{StaticResource GwPanelTitleStyle}" FontSize="17" />
                                <TextBlock x:Name="OptimizeStatusBannerText" Text="Every optimization explains its exact system effect, captures original state, verifies changes, and supports rollback." Style="{StaticResource GwPanelSubtitleStyle}" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Refresh Optimization State" Style="{StaticResource GwPrimaryButtonStyle}" Click="OnRefreshOptimizeClick" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- 1. Power Plan Manager -->
                    <Border Padding="16,14" CornerRadius="8" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                        <StackPanel Spacing="10">
                            <TextBlock Text="1. Windows Power Management (powercfg)" Style="{StaticResource GwCardTitleStyle}" />
                            <TextBlock x:Name="OptimizeActivePowerSummaryText" Text="Inspecting installed Windows power schemes..." Style="{StaticResource GwPanelSubtitleStyle}" />
                            <ListView x:Name="OptimizePowerPlansListView" SelectionMode="None" MaxHeight="260">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:PowerPlanRowViewModel">
                                        <Border Padding="12,10" Margin="0,3" CornerRadius="6" Background="{ThemeResource GwCardBackgroundHoverBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Spacing="3">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource GwTextPrimaryBrush}" />
                                                        <TextBlock Text="{x:Bind SchemeGuid}" FontSize="11" FontFamily="Consolas" Foreground="{ThemeResource GwTextMutedBrush}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <TextBlock Text="{x:Bind Description}" FontSize="11" Foreground="{ThemeResource GwTextSecondaryBrush}" TextWrapping="Wrap" />
                                                    <TextBlock Text="{x:Bind TradeoffSummary}" FontSize="11" Foreground="{ThemeResource GwTealBrush}" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <Border Grid.Column="1" Padding="8,3" CornerRadius="4" Background="{x:Bind BadgeBackground}" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind ActiveBadge}" FontSize="11" FontWeight="SemiBold" Foreground="{x:Bind BadgeForeground}" />
                                                </Border>
                                                <Button Grid.Column="2" Content="Activate Plan" Tag="{x:Bind SchemeGuid}" IsEnabled="{x:Bind CanActivate}" Style="{StaticResource GwPrimaryButtonStyle}" Click="OnSwitchPowerPlanClick" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>

                    <!-- 2. Startup Applications & Registry Manager -->
                    <Border Padding="16,14" CornerRadius="8" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                        <StackPanel Spacing="10">
                            <TextBlock Text="2. Startup Applications &amp; Registry Entries" Style="{StaticResource GwCardTitleStyle}" />
                            <TextBlock x:Name="OptimizeStartupSummaryText" Text="Inspecting HKCU/HKLM Run registry keys and Startup folders..." Style="{StaticResource GwPanelSubtitleStyle}" />
                            <ListView x:Name="OptimizeStartupItemsListView" SelectionMode="None" MaxHeight="360">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:StartupItemRowViewModel">
                                        <Border Padding="12,10" Margin="0,3" CornerRadius="6" Background="{ThemeResource GwCardBackgroundHoverBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Spacing="3">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource GwTextPrimaryBrush}" />
                                                        <TextBlock Text="{x:Bind Publisher}" FontSize="11" Foreground="{ThemeResource GwAccentBrush}" VerticalAlignment="Center" />
                                                        <TextBlock Text="{x:Bind ScopeDisplay}" FontSize="11" Foreground="{ThemeResource GwTextMutedBrush}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <TextBlock Text="{x:Bind CommandOrTarget}" FontSize="11" FontFamily="Consolas" Foreground="{ThemeResource GwTextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{x:Bind ImpactReason}" FontSize="11" Foreground="{ThemeResource GwTealBrush}" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <Border Grid.Column="1" Padding="8,3" CornerRadius="4" Background="{x:Bind StatusBackground}" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind StatusBadge}" FontSize="11" FontWeight="SemiBold" Foreground="{x:Bind StatusForeground}" />
                                                </Border>
                                                <Button Grid.Column="2" Content="{x:Bind ToggleButtonText}" Tag="{x:Bind EntryId}" IsEnabled="{x:Bind CanModify}" Style="{StaticResource GwSecondaryButtonStyle}" Click="OnToggleStartupItemClick" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>

                    <!-- 3. Windows Performance, Gaming & Privacy Configuration -->
                    <Border Padding="16,14" CornerRadius="8" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                        <StackPanel Spacing="10">
                            <TextBlock Text="3. Windows Performance, Gaming &amp; Privacy Configuration" Style="{StaticResource GwCardTitleStyle}" />
                            <TextBlock Text="Transparent individual controls with clear explanations — no opaque optimization presets." Style="{StaticResource GwPanelSubtitleStyle}" />
                            <ListView x:Name="OptimizeSettingsListView" SelectionMode="None" MaxHeight="400">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:ConfigurableSettingRowViewModel">
                                        <Border Padding="12,10" Margin="0,3" CornerRadius="6" Background="{ThemeResource GwCardBackgroundHoverBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Spacing="3">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Text="{x:Bind DisplayName}" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource GwTextPrimaryBrush}" />
                                                        <TextBlock Text="{x:Bind Category}" FontSize="11" Foreground="{ThemeResource GwAccentBrush}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <TextBlock Text="{x:Bind Explanation}" FontSize="11" Foreground="{ThemeResource GwTextSecondaryBrush}" TextWrapping="Wrap" />
                                                    <TextBlock Text="{x:Bind RecommendationNote}" FontSize="11" Foreground="{ThemeResource GwTealBrush}" TextWrapping="Wrap" />
                                                    <TextBlock Text="{x:Bind RegistryLocation}" FontSize="10" FontFamily="Consolas" Foreground="{ThemeResource GwTextMutedBrush}" />
                                                </StackPanel>
                                                <Border Grid.Column="1" Padding="8,3" CornerRadius="4" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind CurrentStateDisplay}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" />
                                                </Border>
                                                <Button Grid.Column="2" Content="{x:Bind ToggleButtonText}" Tag="{x:Bind SettingId}" IsEnabled="{x:Bind CanToggle}" Style="{StaticResource GwSecondaryButtonStyle}" Click="OnToggleConfigurableSettingClick" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ======================================================== -->
            <!-- MODULE D: TROUBLESHOOT & INVESTIGATIONS -->
            <!-- ======================================================== -->
            <ScrollViewer x:Name="TroubleshootPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="16">
                    <Border Padding="16,14" CornerRadius="8" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="Troubleshoot &amp; Groundwork Investigations" Style="{StaticResource GwPanelTitleStyle}" FontSize="17" />
                                <TextBlock Text="Guided multi-tool investigations, network connectivity diagnostics, Windows Event Log error analysis, and core service checks." Style="{StaticResource GwPanelSubtitleStyle}" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Refresh Diagnostics" Style="{StaticResource GwSecondaryButtonStyle}" Click="OnRefreshTroubleshootClick" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- 1. Groundwork Investigations Hub -->
                    <Border Padding="16,14" CornerRadius="8" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                        <StackPanel Spacing="12">
                            <TextBlock Text="1. Groundwork Guided Investigations" Style="{StaticResource GwCardTitleStyle}" />
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="InvestigationTypeComboBox" Grid.Column="0" SelectedIndex="0" HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="Performance Investigation" Tag="Performance" />
                                    <ComboBoxItem Content="Storage Investigation" Tag="Storage" />
                                    <ComboBoxItem Content="Network Investigation" Tag="Network" />
                                    <ComboBoxItem Content="Windows Health Investigation" Tag="WindowsHealth" />
                                    <ComboBoxItem Content="Startup Investigation" Tag="Startup" />
                                    <ComboBoxItem Content="Hardware Investigation" Tag="Hardware" />
                                    <ComboBoxItem Content="Custom Symptom Query" Tag="Custom" />
                                </ComboBox>
                                <TextBox x:Name="InvestigationQueryBox" Grid.Column="1" PlaceholderText="Describe symptom (e.g., 'My PC feels slower than usual' or 'My internet keeps disconnecting')..." />
                                <Button x:Name="RunInvestigationButton" Grid.Column="2" Content="Run Investigation" Style="{StaticResource GwPrimaryButtonStyle}" Click="OnRunInvestigationClick" />
                                <Button x:Name="CopyInvestigationReportButton" Grid.Column="3" Content="Copy Markdown" Style="{StaticResource GwSecondaryButtonStyle}" Click="OnCopyInvestigationMarkdownClick" />
                                <Button x:Name="ExportInvestigationMarkdownButton" Grid.Column="4" Content="Export Report" Style="{StaticResource GwSecondaryButtonStyle}" Click="OnExportInvestigationReportClick" />
                            </Grid>

                            <TextBlock x:Name="InvestigationSummaryText" Text="Select an investigation type above and click 'Run Investigation' to collect live telemetry evidence." FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource GwAccentBrush}" TextWrapping="Wrap" />
                            <TextBlock x:Name="InvestigationToolsExecutedText" Text="Registered Diagnostic Tools: Ready to inspect live Windows state." FontSize="11" FontFamily="Consolas" Foreground="{ThemeResource GwTealBrush}" TextWrapping="Wrap" />

                            <TextBlock Text="Confirmed Observations (Verified Live System Evidence)" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" />
                            <ListView x:Name="InvestigationConfirmedListView" SelectionMode="None" MaxHeight="220">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:InvestigationFindingRowViewModel">
                                        <Border Padding="10,8" Margin="0,2" CornerRadius="6" Background="{ThemeResource GwCardBackgroundHoverBrush}">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource GwTextPrimaryBrush}" TextWrapping="Wrap" />
                                                <TextBlock Text="{x:Bind Detail}" FontSize="11" Foreground="{ThemeResource GwTextSecondaryBrush}" TextWrapping="Wrap" />
                                                <TextBlock Text="{x:Bind EvidenceAndConfidence}" FontSize="10" Foreground="{ThemeResource GwTealBrush}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <TextBlock Text="Potential Contributing Factors &amp; Unverified Hypotheses" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" />
                            <ListView x:Name="InvestigationCausesListView" SelectionMode="None" MaxHeight="220">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:InvestigationFindingRowViewModel">
                                        <Border Padding="10,8" Margin="0,2" CornerRadius="6" Background="{ThemeResource GwCardBackgroundHoverBrush}">
                                            <StackPanel Spacing="2">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{x:Bind CategoryBadge}" FontWeight="Bold" FontSize="11" Foreground="{ThemeResource GwAmberBrush}" />
                                                    <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource GwTextPrimaryBrush}" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <TextBlock Text="{x:Bind Detail}" FontSize="11" Foreground="{ThemeResource GwTextSecondaryBrush}" TextWrapping="Wrap" />
                                                <TextBlock Text="{x:Bind EvidenceAndConfidence}" FontSize="10" Foreground="{ThemeResource GwTextMutedBrush}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <TextBlock Text="Recommended Actions &amp; Safe Execution" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" />
                            <ListView x:Name="InvestigationRecommendationsListView" SelectionMode="None" MaxHeight="220">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:InvestigationRecommendationRowViewModel">
                                        <Border Padding="10,8" Margin="0,2" CornerRadius="6" Background="{ThemeResource GwCardBackgroundHoverBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Spacing="2">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource GwTextPrimaryBrush}" TextWrapping="Wrap" />
                                                        <TextBlock Text="{x:Bind SafetyBadge}" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource GwTealBrush}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <TextBlock Text="{x:Bind Explanation}" FontSize="11" Foreground="{ThemeResource GwTextSecondaryBrush}" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="{x:Bind ActionButtonText}" Tag="{x:Bind RecommendationId}" Style="{StaticResource GwPrimaryButtonStyle}" Click="OnInvestigationRecommendationActionClick" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>

                    <!-- 2. Network Troubleshooter -->
                    <Border Padding="16,14" CornerRadius="8" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                        <StackPanel Spacing="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="2. Network Connectivity, Gateway &amp; DNS Troubleshooter" Style="{StaticResource GwCardTitleStyle}" VerticalAlignment="Center" />
                                <TextBox x:Name="NetworkPingTargetBox" Grid.Column="1" Text="www.microsoft.com" PlaceholderText="Hostname or IP..." Margin="0,0,8,0" />
                                <Button x:Name="RunNetworkDiagnosticsButton" Grid.Column="2" Content="Test Ping &amp; DNS" Style="{StaticResource GwPrimaryButtonStyle}" Click="OnRunNetworkDiagnosticsClick" Margin="0,0,8,0" />
                                <Button x:Name="FlushDnsCacheButton" Grid.Column="3" Content="Flush DNS" Style="{StaticResource GwSecondaryButtonStyle}" Click="OnFlushDnsCacheClick" Margin="0,0,8,0" />
                                <ComboBox x:Name="DnsProviderComboBox" Grid.Column="4" SelectedIndex="0" HorizontalAlignment="Stretch" Margin="0,0,8,0">
                                    <ComboBoxItem Content="Cloudflare (1.1.1.1)" Tag="Cloudflare" />
                                    <ComboBoxItem Content="Google (8.8.8.8)" Tag="Google" />
                                    <ComboBoxItem Content="Quad9 (9.9.9.9)" Tag="Quad9" />
                                    <ComboBoxItem Content="Automatic (DHCP)" Tag="Automatic" />
                                </ComboBox>
                                <Button x:Name="SwitchDnsProviderButton" Grid.Column="5" Content="Switch DNS..." Style="{StaticResource GwSecondaryButtonStyle}" Click="OnSwitchDnsProviderClick" />
                            </Grid>
                            <TextBlock x:Name="NetworkDiagnosisSummaryText" Text="Click 'Test Ping &amp; DNS' to inspect active adapters, ping your default gateway and 1.1.1.1, and verify DNS resolution." FontSize="12" Foreground="{ThemeResource GwTealBrush}" TextWrapping="Wrap" />
                            <ListView x:Name="NetworkAdaptersListView" SelectionMode="None" MaxHeight="220">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:NetworkAdapterRowViewModel">
                                        <Border Padding="10,8" Margin="0,2" CornerRadius="6" Background="{ThemeResource GwCardBackgroundHoverBrush}">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="{x:Bind Description}" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource GwTextPrimaryBrush}" />
                                                    <TextBlock Text="{x:Bind IpSummary}" FontSize="11" FontFamily="Consolas" Foreground="{ThemeResource GwTextSecondaryBrush}" />
                                                    <TextBlock Text="{x:Bind DnsSummary}" FontSize="11" Foreground="{ThemeResource GwTextMutedBrush}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind OperationalStatus}" FontWeight="Bold" FontSize="12" Foreground="{ThemeResource GwAccentBrush}" HorizontalAlignment="Right" />
                                                    <TextBlock Text="{x:Bind SpeedDisplay}" FontSize="11" Foreground="{ThemeResource GwTextMutedBrush}" HorizontalAlignment="Right" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>

                    <!-- 3. Windows Event Log Error Investigator -->
                    <Border Padding="16,14" CornerRadius="8" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                        <StackPanel Spacing="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="3. Windows Event Log &amp; Error Investigator (Last 7 Days)" Style="{StaticResource GwCardTitleStyle}" />
                                    <TextBlock x:Name="EventLogSummaryText" Text="Filters System and Application logs for Critical, Error, and Warning events with plain-English explanations." Style="{StaticResource GwPanelSubtitleStyle}" />
                                </StackPanel>
                                <Button x:Name="RefreshEventLogButton" Grid.Column="1" Content="Load Recent Errors" Style="{StaticResource GwSecondaryButtonStyle}" Click="OnRefreshEventLogClick" VerticalAlignment="Center" />
                            </Grid>
                            <ListView x:Name="EventLogListView" SelectionMode="None" MaxHeight="300">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:EventLogRowViewModel">
                                        <Border Padding="10,8" Margin="0,2" CornerRadius="6" Background="{ThemeResource GwCardBackgroundHoverBrush}">
                                            <StackPanel Spacing="3">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{x:Bind EventHeader}" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource GwTextPrimaryBrush}" />
                                                    <TextBlock Grid.Column="1" Text="{x:Bind TimeDisplay}" FontSize="11" Foreground="{ThemeResource GwTextMutedBrush}" />
                                                </Grid>
                                                <TextBlock Text="{x:Bind MessageSummary}" FontSize="11" Foreground="{ThemeResource GwTextSecondaryBrush}" TextWrapping="Wrap" />
                                                <TextBlock Text="{x:Bind PlainEnglishExplanation}" FontSize="11" Foreground="{ThemeResource GwTealBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>

                    <!-- 4. Core Windows Services & System Repair Audit -->
                    <Border Padding="16,14" CornerRadius="8" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                        <StackPanel Spacing="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="4. Core Windows Services, Pending Reboot &amp; Repair Status" Style="{StaticResource GwCardTitleStyle}" />
                                    <TextBlock x:Name="WindowsRepairSummaryText" Text="Audits Windows Update, Defender, Firewall, DNS/DHCP, CBS Pending Reboot flags, and Device Manager error codes." Style="{StaticResource GwPanelSubtitleStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button x:Name="CreateRestorePointButton" Content="Create Restore Point..." Style="{StaticResource GwSecondaryButtonStyle}" Click="OnCreateRestorePointClick" />
                                    <Button x:Name="VerifyDismHealthButton" Content="Verify DISM Health..." Style="{StaticResource GwSecondaryButtonStyle}" Click="OnVerifyDismHealthClick" />
                                    <Button x:Name="RefreshServicesHealthButton" Content="Audit Services &amp; Repair" Style="{StaticResource GwSecondaryButtonStyle}" Click="OnRefreshServicesHealthClick" />
                                </StackPanel>
                            </Grid>
                            <ListView x:Name="WindowsServicesListView" SelectionMode="None" MaxHeight="280">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:ServiceRowViewModel">
                                        <Border Padding="10,8" Margin="0,2" CornerRadius="6" Background="{ThemeResource GwCardBackgroundHoverBrush}">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="240" />
                                                    <ColumnDefinition Width="200" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{x:Bind DisplayName}" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource GwTextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind StatusSummary}" FontSize="11" Foreground="{ThemeResource GwAccentBrush}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="2" Text="{x:Bind HealthNote}" FontSize="11" Foreground="{ThemeResource GwTextSecondaryBrush}" TextWrapping="Wrap" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ======================================================== -->
            <!-- 7. DEDICATED NATIVE SETTINGS PANEL (Power-User Engine Experience) -->
            <!-- ======================================================== -->
            <ScrollViewer x:Name="SettingsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="16" MaxWidth="1080" HorizontalAlignment="Stretch">
                    
                    <!-- Header Banner -->
                    <Border Padding="16,14" CornerRadius="8" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Grid ColumnSpacing="12" VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Width="40" Height="40" CornerRadius="7" Background="{ThemeResource GwCardBackgroundHoverBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                                    <SymbolIcon Symbol="Setting" Foreground="{ThemeResource GwAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="Preferences &amp; Engine Configuration" Style="{StaticResource GwPanelTitleStyle}" FontSize="17" />
                                    <TextBlock Text="Configure scan workers and exclusions, cleanup confirmation, privacy, and AI providers." Style="{StaticResource GwPanelSubtitleStyle}" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock x:Name="SettingsSavedNoticeText" Text="" FontSize="12" Foreground="{ThemeResource GwSignalGreenBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <Button Content="Open AppData Folder" Style="{StaticResource GwSecondaryButtonStyle}" Click="OnOpenAppDataFolderClick" ToolTipService.ToolTip="Open Groundwork configuration directory in File Explorer" />
                                <Button Content="Reset Defaults" Style="{StaticResource GwSecondaryButtonStyle}" Click="OnResetSettingsClick" ToolTipService.ToolTip="Reset all settings to factory defaults" />
                                <Button Content="Save Preferences" Style="{StaticResource GwPrimaryButtonStyle}" Click="OnSaveSettingsClick" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Section 1: General & UI Appearance -->
                    <Border Padding="16,14" CornerRadius="8" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                        <StackPanel Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE790;" FontSize="15" Foreground="{ThemeResource GwAccentBrush}" />
                                <TextBlock Text="General &amp; Visual Appearance" Style="{StaticResource GwCardTitleStyle}" />
                            </StackPanel>

                            <Grid RowSpacing="12" ColumnSpacing="16">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <ComboBox x:Name="ThemeModeComboBox" Grid.Row="0" Grid.Column="0" Header="Visual Theme Palette" HorizontalAlignment="Stretch" SelectionChanged="OnThemeModeSelectionChanged">
                                    <ComboBoxItem Content="Light Theme (Modern Blue &amp; White) [Default]" Tag="Light" />
                                    <ComboBoxItem Content="Dark Theme (Control Room)" Tag="Dark" />
                                    <ComboBoxItem Content="Use Windows System Setting" Tag="System" />
                                </ComboBox>

                                <ComboBox x:Name="SizeUnitComboBox" Grid.Row="0" Grid.Column="1" Header="File Size Display Format" HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="Auto-Fit (B / KB / MB / GB / TB) [Default]" Tag="Auto" />
                                    <ComboBoxItem Content="Binary / IEC Standard (1024 base: KiB, MiB, GiB)" Tag="Binary" />
                                    <ComboBoxItem Content="Decimal / SI Standard (1000 base: KB, MB, GB)" Tag="Decimal" />
                                </ComboBox>

                                <ToggleSwitch x:Name="MaskSerialsToggle" Grid.Row="1" Grid.Column="0" Header="Mask hardware serial numbers in specs &amp; reports (Privacy Guard)" IsOn="True" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="Temperature readings are not available from a reliable, universal Windows sensor source." FontSize="12" Foreground="{ThemeResource GwTextSecondaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Section 2: Storage Scanner Engine & Concurrency -->
                    <Border Padding="16,14" CornerRadius="8" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                        <StackPanel Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xEDA2;" FontSize="15" Foreground="{ThemeResource GwTealBrush}" />
                                <TextBlock Text="Storage Scanner Engine &amp; Concurrency" Style="{StaticResource GwCardTitleStyle}" />
                            </StackPanel>

                            <Grid RowSpacing="12" ColumnSpacing="16">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBox x:Name="DefaultScanPathBox" Grid.Row="0" Grid.Column="0" Header="Default Scan Target Path" Text="C:\" />
                                <TextBox x:Name="ParallelThreadsBox" Grid.Row="0" Grid.Column="1" Header="Parallel Worker Threads (2 - 16)" Text="8" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Directory junctions and symbolic links are always skipped to avoid cycles and crossing volumes. No automatic elevation is performed." FontSize="12" Foreground="{ThemeResource GwTextSecondaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="Raw MFT parsing is not available in this build. Volume and folder analysis uses the Windows file enumerator." FontSize="12" Foreground="{ThemeResource GwTextSecondaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />

                                <TextBox x:Name="ExcludedPathsBox" Grid.Row="2" Grid.Column="0" Header="Global Excluded Paths (comma-separated)" Text="$Recycle.Bin,System Volume Information" />
                                <TextBox x:Name="ExcludedExtensionsBox" Grid.Row="2" Grid.Column="1" Header="Excluded File Extensions" Text=".tmp,.bak,.log" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Section 3: Cleanup Safety & Uninstaller Guards -->
                    <Border Padding="16,14" CornerRadius="8" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                        <StackPanel Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE74D;" FontSize="15" Foreground="{ThemeResource GwAmberBrush}" />
                                <TextBlock Text="Cleanup Safety &amp; Uninstaller Guards" Style="{StaticResource GwCardTitleStyle}" />
                            </StackPanel>

                            <Grid RowSpacing="12" ColumnSpacing="16">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <ToggleSwitch x:Name="ConfirmBeforeDeleteToggle" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Header="Require confirmation before cleanup (permanent delete and emptying Recycle Bin always require confirmation)" IsOn="True" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="Uninstallers are launched only after confirmation. Leftover locations are inspected with bounded, read-only matching; removal is a separate reviewed action." FontSize="12" Foreground="{ThemeResource GwTextSecondaryBrush}" TextWrapping="Wrap" />
                            </Grid>

                            <Border Padding="10,8" CornerRadius="6" Background="{ThemeResource GwCardBackgroundHoverBrush}">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE72E;" FontSize="13" Foreground="{ThemeResource GwTealBrush}" />
                                    <TextBlock Text="Protected System Paths: C:\Windows, C:\Program Files, System32, and root boot sectors are permanently guarded against deletion." FontSize="11" Foreground="{ThemeResource GwTextSecondaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Section 4: AI Agent Provider & Privacy -->
                    <Border Padding="16,14" CornerRadius="8" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                        <StackPanel Spacing="14">
                            <StackPanel Spacing="3">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE946;" FontSize="15" Foreground="{ThemeResource GwPurpleBrush}" />
                                    <TextBlock Text="AI Agent Provider &amp; Model Integration" Style="{StaticResource GwCardTitleStyle}" />
                                </StackPanel>
                                <TextBlock Text="Connect a 100% free offline on-device LLM (Ollama, LM Studio) or a cloud API (Google Gemini, OpenAI, Anthropic Claude, Mistral, Groq, DeepSeek, OpenRouter) to power the Groundwork Agent. Web search is optional and off by default; turn it on in the Gemini or Mistral section for questions that need current information." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource GwTextSecondaryBrush}" />
                            </StackPanel>

                            <ComboBox x:Name="SettingsAiProviderComboBox" Header="Active Intelligence Provider" Width="440" SelectionChanged="OnSettingsAiProviderSelectionChanged">
                                <ComboBoxItem Content="None (Require Setup)" Tag="none" />
                                <ComboBoxItem Content="Ollama (Local On-Device LLM - 100% Free &amp; Private)" Tag="ollama" />
                                <ComboBoxItem Content="Google Gemini (Cloud API - Fast Reasoning)" Tag="gemini" />
                                <ComboBoxItem Content="OpenAI (Cloud API - GPT-4o / GPT-4o-mini)" Tag="openai" />
                                <ComboBoxItem Content="Anthropic Claude (Cloud API - Claude Sonnet / Haiku)" Tag="anthropic" />
                                <ComboBoxItem Content="Mistral (Cloud API - Optional Web Search)" Tag="mistral" />
                                <ComboBoxItem Content="OpenAI-Compatible (Groq / DeepSeek / OpenRouter / LM Studio)" Tag="custom" />
                            </ComboBox>

                            <!-- Ollama Options -->
                            <StackPanel x:Name="SettingsOllamaPanel" Spacing="8" Visibility="Collapsed">
                                <TextBox x:Name="SettingsOllamaUrlBox" Header="Base URL" Text="http://127.0.0.1:11434" Width="440" HorizontalAlignment="Left" />
                                <TextBox x:Name="SettingsOllamaModelBox" Header="Model" PlaceholderText="llama3.3:latest" Text="llama3.3:latest" Width="440" HorizontalAlignment="Left" />
                                <StackPanel Spacing="6" Margin="0,4,0,0">
                                    <Button Content="Test &amp; Activate Ollama" Style="{StaticResource GwPrimaryButtonStyle}" Click="OnTestOllamaClick" HorizontalAlignment="Left" />
                                    <TextBlock x:Name="SettingsOllamaStatusText" Text="" FontSize="12" TextWrapping="Wrap" MaxWidth="560" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Gemini Options -->
                            <StackPanel x:Name="SettingsGeminiPanel" Spacing="8" Visibility="Collapsed">
                                <PasswordBox x:Name="SettingsGeminiApiKeyBox" Header="API Key" Width="440" HorizontalAlignment="Left" />
                                <TextBox x:Name="SettingsGeminiModelBox" Header="Model" Text="gemini-3.5-flash-lite" Width="440" HorizontalAlignment="Left" />
                                <TextBox x:Name="SettingsGeminiEndpointBox" Header="Base URL (optional)" PlaceholderText="https://generativelanguage.googleapis.com" Width="440" HorizontalAlignment="Left" />
                                <ToggleSwitch x:Name="GeminiGoogleSearchToggle" Header="Web search (sends the prompt and system context to Google)" IsOn="False" />
                                <StackPanel Spacing="6" Margin="0,4,0,0">
                                    <Button Content="Test &amp; Activate Gemini" Style="{StaticResource GwPrimaryButtonStyle}" Click="OnTestGeminiClick" HorizontalAlignment="Left" />
                                    <TextBlock x:Name="SettingsGeminiStatusText" Text="" FontSize="12" TextWrapping="Wrap" MaxWidth="560" />
                                </StackPanel>
                            </StackPanel>

                            <!-- OpenAI Options -->
                            <StackPanel x:Name="SettingsOpenAiPanel" Spacing="8" Visibility="Collapsed">
                                <PasswordBox x:Name="SettingsOpenAiApiKeyBox" Header="API Key" Width="440" HorizontalAlignment="Left" />
                                <TextBox x:Name="SettingsOpenAiModelBox" Header="Model" Text="gpt-4o" Width="440" HorizontalAlignment="Left" />
                                <TextBox x:Name="SettingsOpenAiEndpointBox" Header="Base URL (optional)" PlaceholderText="https://api.openai.com/v1" Width="440" HorizontalAlignment="Left" />
                                <StackPanel Spacing="6" Margin="0,4,0,0">
                                    <Button Content="Test &amp; Activate OpenAI" Style="{StaticResource GwPrimaryButtonStyle}" Click="OnTestOpenAiClick" HorizontalAlignment="Left" />
                                    <TextBlock x:Name="SettingsOpenAiStatusText" Text="" FontSize="12" TextWrapping="Wrap" MaxWidth="560" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Mistral Options -->
                            <StackPanel x:Name="SettingsMistralPanel" Spacing="8" Visibility="Collapsed">
                                <PasswordBox x:Name="SettingsMistralApiKeyBox" Header="API Key" Width="440" HorizontalAlignment="Left" />
                                <TextBox x:Name="SettingsMistralModelBox" Header="Model" Text="ministral-8b-latest" Width="440" HorizontalAlignment="Left" />
                                <TextBox x:Name="SettingsMistralEndpointBox" Header="Base URL (optional)" PlaceholderText="https://api.mistral.ai/v1" Width="440" HorizontalAlignment="Left" />
                                <ToggleSwitch x:Name="MistralWebSearchToggle" Header="Web search (sends the prompt and system context to Mistral)" IsOn="False" />
                                <StackPanel Spacing="6" Margin="0,4,0,0">
                                    <Button Content="Test &amp; Activate Mistral" Style="{StaticResource GwPrimaryButtonStyle}" Click="OnTestMistralClick" HorizontalAlignment="Left" />
                                    <TextBlock x:Name="SettingsMistralStatusText" Text="" FontSize="12" TextWrapping="Wrap" MaxWidth="560" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Anthropic Options -->
                            <StackPanel x:Name="SettingsAnthropicPanel" Spacing="8" Visibility="Collapsed">
                                <PasswordBox x:Name="SettingsAnthropicApiKeyBox" Header="API Key" Width="440" HorizontalAlignment="Left" />
                                <TextBox x:Name="SettingsAnthropicModelBox" Header="Model" Text="claude-3-5-sonnet-latest" Width="440" HorizontalAlignment="Left" />
                                <TextBox x:Name="SettingsAnthropicEndpointBox" Header="Base URL (optional)" PlaceholderText="https://api.anthropic.com/v1" Width="440" HorizontalAlignment="Left" />
                                <StackPanel Spacing="6" Margin="0,4,0,0">
                                    <Button Content="Test &amp; Activate Anthropic" Style="{StaticResource GwPrimaryButtonStyle}" Click="OnTestAnthropicClick" HorizontalAlignment="Left" />
                                    <TextBlock x:Name="SettingsAnthropicStatusText" Text="" FontSize="12" TextWrapping="Wrap" MaxWidth="560" />
                                </StackPanel>
                            </StackPanel>

                            <!-- OpenAI-Compatible Custom Options -->
                            <StackPanel x:Name="SettingsCustomPanel" Spacing="8" Visibility="Collapsed">
                                <TextBox x:Name="SettingsCustomEndpointBox" Header="Base URL (Groq, DeepSeek, OpenRouter, LM Studio)" PlaceholderText="https://api.groq.com/openai/v1" Text="https://api.groq.com/openai/v1" Width="440" HorizontalAlignment="Left" />
                                <TextBox x:Name="SettingsCustomModelBox" Header="Model" PlaceholderText="llama-3.3-70b-versatile" Text="llama-3.3-70b-versatile" Width="440" HorizontalAlignment="Left" />
                                <PasswordBox x:Name="SettingsCustomApiKeyBox" Header="API Key (optional for local LM Studio / vLLM)" Width="440" HorizontalAlignment="Left" />
                                <StackPanel Spacing="6" Margin="0,4,0,0">
                                    <Button Content="Test &amp; Activate Custom Provider" Style="{StaticResource GwPrimaryButtonStyle}" Click="OnTestCustomClick" HorizontalAlignment="Left" />
                                    <TextBlock x:Name="SettingsCustomStatusText" Text="" FontSize="12" TextWrapping="Wrap" MaxWidth="560" />
                                </StackPanel>
                            </StackPanel>

                            <ToggleSwitch x:Name="RememberAgentConversationToggle" Header="Remember the last five agent turns on this PC (stored locally; off by default)" IsOn="False" />
                        </StackPanel>
                    </Border>

                    <!-- Section 5: Engine Architecture & About -->
                    <Border Padding="16,14" CornerRadius="8" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <Border Width="32" Height="32" CornerRadius="6" Background="{ThemeResource GwTealBgBrush}" BorderBrush="{ThemeResource GwTealBrush}" BorderThickness="1">
                                    <FontIcon Glyph="&#xEDA2;" FontSize="16" Foreground="{ThemeResource GwTealBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="About Groundwork v2.0 — Windows System Management &amp; Diagnostics Toolkit" Style="{StaticResource GwCardTitleStyle}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="Native WinUI 3 &amp; .NET 10 Windows system companion combining direct utilities, guided investigations, 20 registered diagnostic/operation tools, and the 10-step Safe Operation Engine." FontSize="11" Foreground="{ThemeResource GwTextSecondaryBrush}" TextWrapping="Wrap" />
                            <TextBlock Text="• Guided Groundwork Investigations: Separates confirmed live telemetry observations from potential contributing factors and unverified hypotheses." FontSize="11" Foreground="{ThemeResource GwTextMutedBrush}" TextWrapping="Wrap" />
                            <TextBlock Text="• 10-Step Safe Operation Lifecycle: Captures original state, explains trade-offs, requires explicit approval, verifies actual resulting state, and supports one-click rollback." FontSize="11" Foreground="{ThemeResource GwTextMutedBrush}" TextWrapping="Wrap" />
                            <TextBlock Text="• Windows Optimization &amp; Troubleshooting: Power plans, Registry &amp; Scheduled Startup Tasks, 11 transparent performance/privacy settings, DNS provider switching, DISM health checks, Event Logs, and Services." FontSize="11" Foreground="{ThemeResource GwTextMutedBrush}" TextWrapping="Wrap" />
                            <TextBlock Text="• Fast Win32 Storage &amp; Maintenance Engine: Parallel FindFirstFileExW directory walker, 3-stage SHA-256 duplicate finder, safe temp/browser cache cleanup, and monitored app uninstaller." FontSize="11" Foreground="{ThemeResource GwTextMutedBrush}" TextWrapping="Wrap" />
                            <TextBlock Text="• Keyboard Shortcuts: Ctrl+1..Ctrl+9 to switch modules; Ctrl+, for Settings; F5 to refresh current module; Double-Click / Enter to expand folder or open file." FontSize="11" Foreground="{ThemeResource GwTextMutedBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

        </Grid>

        <!-- 3. BOTTOM STATUS BAR -->
        <Border Grid.Row="2" Background="{ThemeResource GwHeaderBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="0,1,0,0" Padding="14,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="FooterStatusText" Text="Ready." FontSize="11" Foreground="{ThemeResource GwTextMutedBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" x:Name="FooterDriveSpaceText" Text="" FontSize="11" Foreground="{ThemeResource GwTextMutedBrush}" VerticalAlignment="Center" />
                <TextBlock x:Name="FooterEngineText" Visibility="Collapsed" />
            </Grid>
        </Border>

        <!-- ======================================================== -->
        <!-- 4. MODAL OVERLAY: STARTUP DRIVE SELECTION & INSTANT SCAN -->
        <!-- ======================================================== -->
        <Grid x:Name="StartupDriveModalOverlay" Grid.RowSpan="3" Background="#80000000" Visibility="Collapsed" PointerPressed="OnModalBackdropPointerPressed">
            <Border
                Width="760"
                MaxHeight="580"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Padding="28,24"
                CornerRadius="12"
                Background="{ThemeResource GwPageBackgroundBrush}"
                BorderBrush="{ThemeResource GwCardBorderBrush}"
                BorderThickness="1"
                PointerPressed="OnModalCardPointerPressed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Modal Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <Border Width="34" Height="34" CornerRadius="8" Background="{ThemeResource GwTealBgBrush}" BorderBrush="{ThemeResource GwTealBrush}" BorderThickness="1">
                                    <FontIcon Glyph="&#xEDA2;" FontSize="18" Foreground="{ThemeResource GwTealBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Select Drive to Analyze" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="Choose a local drive to view storage space, discover large files, and clean up waste." FontSize="12" Foreground="{ThemeResource GwTextSecondaryBrush}" Margin="44,0,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1" VerticalAlignment="Top" Padding="6" Background="Transparent" BorderThickness="0" Click="OnCloseDriveModalClick" AutomationProperties.Name="Close drive selection dialog" ToolTipService.ToolTip="Close (Esc)">
                            <SymbolIcon Symbol="Cancel" Foreground="{ThemeResource GwTextMutedBrush}" />
                        </Button>
                    </Grid>

                    <!-- Drives Cards List -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
                        <StackPanel Spacing="6">
                            <ItemsControl x:Name="ModalDrivesItemsControl" ItemsSource="{x:Bind Volumes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:VolumeRowViewModel">
                                    <Border Margin="0,4" Padding="14,12" CornerRadius="8" Background="{ThemeResource GwCardBackgroundBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="42" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Drive Disk Icon -->
                                            <Border Width="40" Height="40" CornerRadius="8" Background="{ThemeResource GwCardBackgroundHoverBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1" VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xEDA2;" FontSize="20" Foreground="{ThemeResource GwAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>

                                            <!-- Details & Progress Bar -->
                                            <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Text="{x:Bind VolumeName}" FontWeight="SemiBold" FontSize="14" Foreground="{ThemeResource GwTextPrimaryBrush}" MaxWidth="280" TextTrimming="CharacterEllipsis" />
                                                        <Border Padding="6,1" CornerRadius="4" Background="{ThemeResource GwCardBackgroundHoverBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{x:Bind FileSystemLabel}" FontSize="10" Foreground="{ThemeResource GwTextSecondaryBrush}" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{x:Bind CapacitySummary}" FontSize="12" FontWeight="Medium" Foreground="{ThemeResource GwTextSecondaryBrush}" VerticalAlignment="Center" />
                                                </Grid>
                                                <ProgressBar Value="{x:Bind UsedPercent}" Maximum="100" Height="6" CornerRadius="3" Foreground="{ThemeResource GwAccentBrush}" />
                                            </StackPanel>

                                            <!-- Scan Action -->
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <Button Content="Scan" Tag="{x:Bind RootPath}" Style="{StaticResource GwPrimaryButtonStyle}" Padding="18,6" Click="OnModalScanDriveClick" ToolTipService.ToolTip="Scan this drive with the Windows file enumerator" AutomationProperties.Name="Scan drive" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Bottom Action Row: Scan All Drives + Folder Picker + CSV + Close -->
                    <Border Grid.Row="2" Padding="0,12,0,0" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button Content="Scan All Drives" Style="{StaticResource GwSecondaryButtonStyle}" Click="OnModalScanAllDrivesClick" ToolTipService.ToolTip="Scan and combine all storage drives on your PC into one view" AutomationProperties.Name="Scan all drives" />
                                <Button Content="Browse Folder..." Style="{StaticResource GwSecondaryButtonStyle}" Click="OnModalBrowseCustomFolderClick" AutomationProperties.Name="Browse custom folder to scan" />
                                <Button Content="Import CSV..." Style="{StaticResource GwSecondaryButtonStyle}" Click="OnModalOpenCsvClick" ToolTipService.ToolTip="Import a previously saved drive scan report" AutomationProperties.Name="Import scan CSV report" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Dismiss" Style="{StaticResource GwSecondaryButtonStyle}" Click="OnCloseDriveModalClick" AutomationProperties.Name="Dismiss drive selection dialog" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ======================================================== -->
        <!-- 5. FULL-SCREEN BLOCKING LOADING OVERLAY DURING SCAN / LOAD -->
        <!-- ======================================================== -->
        <Grid x:Name="StorageLoadingOverlay" Grid.RowSpan="3" Background="#80000000" Visibility="Collapsed" IsHitTestVisible="True">
            <Border
                Width="540"
                Padding="32,28"
                CornerRadius="14"
                Background="{ThemeResource GwPageBackgroundBrush}"
                BorderBrush="{ThemeResource GwCardBorderBrush}"
                BorderThickness="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <StackPanel Spacing="20">
                    <!-- Header with ProgressRing and Title -->
                    <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                        <ProgressRing x:Name="LoadingProgressRing" IsActive="True" Width="36" Height="36" Foreground="{ThemeResource GwAccentBrush}" />
                        <StackPanel Spacing="3">
                            <TextBlock x:Name="LoadingTargetTitleText" Text="Scanning Drive (C:)..." FontSize="17" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" />
                            <TextBlock x:Name="LoadingSubtitleText" Text="Fast multi-threaded engine analyzing file system hierarchy..." FontSize="12" Foreground="{ThemeResource GwTextSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Real-Time Metrics Grid -->
                    <Border Padding="16,14" CornerRadius="8" Background="{ThemeResource GwCardBackgroundHoverBrush}" BorderBrush="{ThemeResource GwCardBorderBrush}" BorderThickness="1">
                        <Grid RowSpacing="10" ColumnSpacing="16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Spacing="2">
                                <TextBlock Text="FILES SCANNED" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource GwTextMutedBrush}" />
                                <TextBlock x:Name="LoadingFilesCountText" Text="0" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" />
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="1" Spacing="2">
                                <TextBlock Text="FOLDERS SCANNED" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource GwTextMutedBrush}" />
                                <TextBlock x:Name="LoadingFoldersCountText" Text="0" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource GwTextPrimaryBrush}" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Spacing="2">
                                <TextBlock Text="DATA DISCOVERED" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource GwTextMutedBrush}" />
                                <TextBlock x:Name="LoadingDataDiscoveredText" Text="0 B" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource GwAccentBrush}" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="1" Spacing="2">
                                <TextBlock Text="SCAN SPEED" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource GwTextMutedBrush}" />
                                <TextBlock x:Name="LoadingScanSpeedText" Text="Calculating..." FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource GwTealBrush}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Current Directory Path -->
                    <StackPanel Spacing="6">
                        <TextBlock x:Name="LoadingCurrentPathText" Text="Initializing parallel workers..." FontSize="11" Foreground="{ThemeResource GwTextMutedBrush}" TextTrimming="CharacterEllipsis" MaxWidth="480" />
                        <ProgressBar x:Name="LoadingProgressBar" IsIndeterminate="True" Height="6" CornerRadius="3" Foreground="{ThemeResource GwAccentBrush}" />
                    </StackPanel>

                    <!-- Bottom Notice & Cancel Button -->
                    <Grid>
                        <TextBlock Text="Please wait while disk contents are indexed..." FontSize="11" Foreground="{ThemeResource GwTextMutedBrush}" VerticalAlignment="Center" />
                        <Button Content="Cancel Scan" Style="{StaticResource GwSecondaryButtonStyle}" HorizontalAlignment="Right" Click="OnCancelScanClick" AutomationProperties.Name="Cancel active storage scan" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
